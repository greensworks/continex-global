---
import Base from '@layouts/Base.astro';
import PageHero from '@components/sections/PageHero.astro';
import ServiceDetail from '@components/sections/ServiceDetail.astro';
import HowWeWork from '@components/sections/HowWeWork.astro';
import FinalCta from '@components/sections/FinalCta.astro';
import { services, serviceImages } from '@data/services';
import { pages } from '@data/pages';
import { getLocale, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import heroImg from '@assets/images/refinery-dusk.webp';

const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
---
<Base title={t(pages.whatWeDo.title, locale)} description={t(pages.whatWeDo.lead, locale)} headerTheme="dark">
  <PageHero eyebrow={tr('nav.whatWeDo')} title={t(pages.whatWeDo.title, locale)} lead={t(pages.whatWeDo.lead, locale)} image={heroImg} />
  <nav class="border-b border-line bg-surface" aria-label={tr('label.services')}>
    <ul class="container-site flex gap-6 overflow-x-auto py-4 text-sm font-medium [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {services.map((s, i) => <li class="shrink-0"><a href={`#${s.slug}`} class="text-ink-500 hover:text-navy-900"><span class="font-mono text-xs text-ink-400">0{i + 1}</span> {t(s.title, locale)}</a></li>)}
    </ul>
  </nav>
  {services.map((s, i) => <ServiceDetail service={s} index={i} image={serviceImages[s.slug]} />)}
  <HowWeWork />
  <FinalCta />
</Base>
