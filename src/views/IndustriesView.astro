---
import Base from '@layouts/Base.astro';
import PageHero from '@components/sections/PageHero.astro';
import IndustriesGrid from '@components/sections/IndustriesGrid.astro';
import ExperienceCards from '@components/sections/ExperienceCards.astro';
import FinalCta from '@components/sections/FinalCta.astro';
import { pages } from '@data/pages';
import { getLocale, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import heroImg from '@assets/images/metal-grinding-sparks.webp';
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
---
<Base title={t(pages.industries.title, locale)} description={t(pages.industries.lead, locale)} headerTheme="dark">
  <PageHero eyebrow={tr('nav.industries')} title={t(pages.industries.title, locale)} lead={t(pages.industries.lead, locale)} image={heroImg} />
  <IndustriesGrid detailed title={locale === 'tr' ? 'Beş ana sektör.' : 'Five core sectors.'} />
  <ExperienceCards />
  <FinalCta />
</Base>
