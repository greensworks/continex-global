---
import Base from '@layouts/Base.astro';
import CaseStudyLayout from '@components/sections/CaseStudyLayout.astro';
import type { CaseStudy } from '@data/experience';
import { services } from '@data/services';
import { getLocale, localizePath, t } from '@i18n/utils';
import { img } from '@/lib/images';

interface Props { cs: CaseStudy }
const { cs } = Astro.props;
const locale = getLocale(Astro.url);
const support: Record<string, string> = {
  'cross-border-real-estate-china': 'about-architecture',
  'market-entry-strategic-partners-turkiye': 'case-industrial-partners',
  'oem-market-development-turkiye': 'sector-mobility',
};
const serviceFor: Record<string, string[]> = {
  'cross-border-real-estate-china': ['project-development', 'international-representation', 'strategic-partnerships'],
  'market-entry-strategic-partners-turkiye': ['market-entry', 'strategic-partnerships', 'international-representation'],
  'oem-market-development-turkiye': ['international-representation', 'market-entry', 'strategic-partnerships'],
};
const related = (serviceFor[cs.slug] ?? []).map(slug => services.find(s => s.slug === slug)!)
  .filter(Boolean).map(s => ({ title: t(s.title, locale), text: t(s.summary, locale), href: localizePath(`/what-we-do#${s.slug}`, locale) }));
---
<Base title={t(cs.title, locale)} description={t(cs.need, locale)} headerTheme="dark" cta={false}>
  <CaseStudyLayout cs={cs} image={img(cs.image)} supportImage={img(support[cs.slug])} related={related} />
</Base>
