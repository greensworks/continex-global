---
import Base from '@layouts/Base.astro';
import ArticleLayout from '@components/sections/ArticleLayout.astro';
import InsightsLatest from '@components/sections/InsightsLatest.astro';
import FinalCta from '@components/sections/FinalCta.astro';
import type { CaseStudy } from '@data/experience';
import { experience } from '@data/experience';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import { img } from '@/lib/images';

interface Props { cs: CaseStudy }
const { cs } = Astro.props;
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const serviceFor: Record<string, string[]> = {
  'cross-border-real-estate-china': ['project-development', 'international-representation'],
  'market-entry-strategic-partners-turkiye': ['market-entry', 'strategic-partnerships'],
  'oem-market-development-turkiye': ['international-representation', 'market-entry'],
};
const others = experience.filter((c) => c.slug !== cs.slug);
---
<Base title={t(cs.title, locale)} description={t(cs.need, locale)}>
  <ArticleLayout
    label={tr('nav.experience')}
    title={t(cs.title, locale)}
    subtitle={t(cs.need, locale)}
    image={img(cs.image)}
    highlights={[t(cs.status, locale), `${t(cs.client, locale)} · ${t(cs.sector, locale)} · ${t(cs.market, locale)}`, t(cs.outcome, locale)]}
    authorSlugs={['bulent-ulusoy', 'cigdem-balcioglu']}
    relatedServices={serviceFor[cs.slug]}
    tags={[t(cs.sector, locale), t(cs.market, locale), t(cs.status, locale)]}
    backHref={localizePath('/selected-experience', locale)}
    backLabel={tr('exp.viewAll')}
  >
    <dl>
      <dt>{tr('label.need')}</dt><dd>{t(cs.need, locale)}</dd>
      <dt>{tr('label.role')}</dt><dd>{t(cs.role, locale)}</dd>
      <dt>{tr('label.progress')}</dt><dd>{t(cs.progress, locale)}</dd>
      <dt>{tr('label.outcome')}</dt><dd>{t(cs.outcome, locale)}</dd>
    </dl>
    <h2>{locale === 'tr' ? 'Diğer mandatlar' : 'Other mandates'}</h2>
    <ul>{others.map((o) => <li><a href={localizePath(`/selected-experience/${o.slug}`, locale)}>{t(o.title, locale)}</a> — {t(o.status, locale)}</li>)}</ul>
  </ArticleLayout>
  <InsightsLatest />
  <FinalCta />
</Base>
