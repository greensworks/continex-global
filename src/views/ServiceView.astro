---
import Base from '@layouts/Base.astro';
import PageHero from '@components/sections/PageHero.astro';
import ServiceDetail from '@components/sections/ServiceDetail.astro';
import ServiceLinks from '@components/sections/ServiceLinks.astro';
import ExperienceCards from '@components/sections/ExperienceCards.astro';
import { services, serviceImages, type Service } from '@data/services';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import { img } from '@/lib/images';

interface Props { service: Service }
const { service } = Astro.props;
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const index = services.findIndex((s) => s.slug === service.slug);
const detailImages: Record<string, string> = {
  'market-entry': 'office-tablet',
  'strategic-partnerships': 'meeting-table',
  'project-development': 'sector-infrastructure',
  'international-representation': 'markets-connections',
};
---
<Base title={t(service.title, locale)} description={t(service.summary, locale)} headerTheme="dark">
  <PageHero breadcrumb={[{ label: tr('nav.home'), href: localizePath('/', locale) }, { label: tr('nav.whatWeDo'), href: localizePath('/what-we-do', locale) }, { label: t(service.title, locale) }]} title={t(service.title, locale)} lead={t(service.summary, locale)} image={img(serviceImages[service.slug])} />
  <ServiceDetail service={service} index={index} image={detailImages[service.slug]} />
  <ServiceLinks current={service.slug} />
  <ExperienceCards />
</Base>
