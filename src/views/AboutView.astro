---
import Base from '@layouts/Base.astro';
import PageHero from '@components/sections/PageHero.astro';
import GuideSplit from '@components/sections/rb/GuideSplit.astro';
import Leadership from '@components/sections/Leadership.astro';
import Principles from '@components/sections/Principles.astro';
import ctaImage from '@assets/images/abstract-warm-streaks.webp';
import { pages } from '@data/pages';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import heroImg from '@assets/images/about-architecture.webp';
import roleImg from '@assets/images/meeting-table.webp';
import modelImg from '@assets/images/office-tablet.webp';
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const a = pages.about;
const ids = ['role', 'model'];
const sectionImages = [
  { src: roleImg, alt: locale === 'tr' ? 'Toplantı masasında görüşen iş insanları' : 'Colleagues meeting across a table' },
  { src: modelImg, alt: locale === 'tr' ? 'Ofiste tablet üzerinde çalışan iş insanı' : 'Business professional working on a tablet' },
];
---
<Base title={t(a.title, locale)} description={t(a.lead, locale)} headerTheme="dark" ctaImage={ctaImage}>
  <PageHero breadcrumb={[{ label: tr('nav.home'), href: localizePath('/', locale) }, { label: tr('nav.about') }]} title={t(a.title, locale)} lead={t(a.lead, locale)} image={heroImg} />
  {a.sections.map((s, i) => (
    <GuideSplit
      id={ids[i]}
      title={t(s.title, locale)}
      paragraphs={s.text.map((p) => t(p, locale))}
      image={sectionImages[i]?.src}
      imageAlt={sectionImages[i]?.alt}
    />
  ))}
  <Principles />
  <Leadership full eyebrow={locale === 'tr' ? 'Yönetim ekibimiz' : 'Our leadership'} />
</Base>
