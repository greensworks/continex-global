---
import Base from '@layouts/Base.astro';
import Photo from '@components/ui/Photo.astro';
import Hero from '@components/sections/Hero.astro';
import heroImg from '@assets/images/high-voltage-towers.webp';

import { getCollection } from 'astro:content';
import { getLocale, localizePath, t } from '@i18n/utils';
import { site } from '@data/site';
import { industries } from '@data/industries';
import { industryDetails } from '@data/pages';
import { services } from '@data/services';
import { experience } from '@data/experience';
import { img } from '@/lib/images';
import { compareInsights, topicLabel } from '@/lib/insights';
import ctaImage from '@assets/images/cta-people-walking.webp';
const locale = getLocale(Astro.url);
const tr = locale === 'tr';
const path = (url: string) => localizePath(url, locale);
const posts = (await getCollection('insights', e => e.id.startsWith(`${locale}/`) && !e.data.draft)).sort(compareInsights).slice(0, 3);
---
<Base title={`${site.name} — ${tr ? 'Ana sayfa 2' : 'Home 2'}`} description={t(site.description, locale)} headerTheme="dark" headerVariant="classic" localePaths={{en:'/home-2',tr:'/tr/ana-sayfa-2'}} noindex ctaImage={ctaImage}>
  <Hero eyebrow={locale === 'tr' ? 'Uluslararası İş Geliştirme' : 'Cross-Border Business Development'} image={heroImg} imageAlt={locale === 'tr' ? 'Gün batımında yüksek gerilim hatları' : 'High-voltage transmission towers at dusk'} />
  <div class="home-two">


    <section class="introduction" id="continex-introduction" aria-labelledby="intro-title">
      <div class="container-site intro-grid">
        <div class="intro-heading"><p class="kicker">Continex Global</p><h2 id="intro-title">{tr ? 'Fırsatı işe dönüştürüyoruz.' : 'Turning opportunity into business.'}</h2></div>
        <div class="intro-copy"><p class="lead">{t(site.description,locale)}</p><p>{tr ? 'Raporlarla yetinmiyoruz. Pazarda aktif rol alıyor, doğru kapıları açıyor ve süreci sonuç üretene kadar ilerletiyoruz.' : 'We do not stop at reports. We work in the market, open the right doors and keep the process moving until it produces a result.'}</p><a class="text-link light" href={path('/about')}>{tr ? 'Bizi tanıyın' : 'Discover Continex'} <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="field-strip" aria-label={tr ? 'Çalışma alanlarımız' : 'Our working environment'}>
        {['service-partnerships','sector-infrastructure','service-project-development'].map((image,i)=><Photo src={img(image)} alt={tr ? ['Stratejik iş ortaklarıyla görüşme','Altyapı proje sahası','Enerji projesi sahası'][i] : ['Strategic partner meeting','Infrastructure project site','Energy project site'][i]} widths={[480,768,1200]} sizes="(min-width:700px) 40vw, 75vw" class="field-photo" />)}
      </div>
    </section>
    <section class="positioning" aria-labelledby="position-title"><div class="container-site positioning-grid"><div class="statement" aria-hidden="true">{tr ? <>KÜRESEL<br/><span>BAKIŞ.</span><br/>YEREL<br/><span>ERİŞİM.</span></> : <>GLOBAL<br/><span>OUTLOOK.</span><br/>LOCAL<br/><span>ACCESS.</span></>}</div><div class="position-copy"><p class="kicker">{tr ? 'İstanbul’dan uluslararası pazarlara' : 'From Istanbul to international markets'}</p><h2 id="position-title">{tr ? 'Sahada sizinle.' : 'On the ground. By your side.'}</h2><p>{tr ? 'İstanbul merkezli ekibimiz; pazara giriş, ortaklık geliştirme ve uluslararası işlemlerde strateji ile yerel uygulamayı bir araya getirir. İlk değerlendirmeden müzakere ve kapanışa kadar sürecin içinde kalırız.' : 'Our Istanbul-based team brings strategy and local execution together across market entry, partnership development and international transactions. We stay involved from the first assessment through negotiation and closing.'}</p><a class="text-link" href={path('/markets')}>{tr ? 'Pazarlarımız' : 'Our markets'} <span aria-hidden="true">↗</span></a></div></div></section>

    <section class="sector-showcase" aria-labelledby="sectors-title" data-sector-showcase>
      <div class="container-site section-top"><p class="kicker">{tr ? 'Sektörel odak' : 'Our sector focus'}</p><h2 id="sectors-title">{tr ? 'Büyük projeler. Ortak uzmanlık.' : 'Major projects. Shared expertise.'}</h2></div>
      <div class="sector-stage">
        {industries.map((industry,i) => <div id={`sector-panel-${i}`} class="sector-panel" role="tabpanel" aria-labelledby={`sector-tab-${i}`} hidden={i!==0} tabindex="0">
          <Photo src={img(industry.image)} alt={t(industry.title,locale)} widths={[768,1280,1920]} sizes="100vw" class="sector-image" />
          <div class="sector-gradient"></div>
          <div class="container-site sector-content"><div class="sector-copy"><span class="sector-number">0{i+1} / 05</span><h3>{t(industry.title,locale)}</h3><p>{t(industryDetails[industry.slug],locale)}</p><a class="text-link light" href={path(`/industries#${industry.slug}`)}>{tr ? 'Sektörü keşfedin' : 'Explore the sector'} <span aria-hidden="true">↗</span></a></div></div>
        </div>)}
      </div>
      <div class="sector-tabs" role="tablist" aria-label={tr ? 'Sektör seçin' : 'Choose a sector'}>{industries.map((industry,i) => <button type="button" id={`sector-tab-${i}`} role="tab" aria-selected={i===0 ? 'true' : 'false'} aria-controls={`sector-panel-${i}`} tabindex={i===0 ? 0 : -1}><span class="tab-index">0{i+1}</span>{t(industry.title,locale)}<span class="tab-arrow" aria-hidden="true">↗</span></button>)}</div>
    </section>

    <section class="projects" aria-labelledby="projects-title" data-project-showcase>
      <div class="container-site">
        <div class="heading-row"><div><p class="kicker">{tr ? 'Seçilmiş deneyim' : 'Selected experience'}</p><h2 id="projects-title">{tr ? 'Seçilmiş çalışmalarımız' : 'Projects in focus'}</h2></div><a class="text-link" href={path('/selected-experience')}>{tr ? 'Tüm deneyimler' : 'Explore our work'} <span aria-hidden="true">↗</span></a></div>
        <div class="project-grid">{experience.map((project,i) => <article class="project-card" data-project-panel hidden={i!==0} aria-label={`${i+1} / ${experience.length}`}><div class="project-image"><Photo src={img(project.image)} alt={t(project.sector,locale)} widths={[768,1200,1920]} sizes="(min-width:900px) 65vw, 100vw" class="cover"/></div><div class="project-copy"><p class="kicker">{t(project.market,locale)}</p><h3>{t(project.title,locale)}</h3><p class="project-description">{t(project.outcome,locale)}</p><span class="project-status">{t(project.status,locale)}</span><a class="text-link" href={path(`/selected-experience/${project.slug}`)}>{tr ? 'Çalışmayı inceleyin' : 'Explore the project'} <span aria-hidden="true">↗</span></a></div></article>)}</div>
        <div class="project-controls"><span data-project-count aria-live="polite">01 / 03</span><button type="button" data-project-prev aria-label={tr ? 'Önceki çalışma' : 'Previous project'}>←</button><button type="button" data-project-next aria-label={tr ? 'Sonraki çalışma' : 'Next project'}>→</button></div>
      </div>
    </section>

    <section class="capabilities" aria-labelledby="capabilities-title"><div class="container-site capability-grid"><div class="capability-heading"><p class="kicker">{tr ? 'Ne yapıyoruz' : 'What we do'}</p><h2 id="capabilities-title">{tr ? 'Stratejiden uygulamaya.' : 'Strategy into execution.'}</h2><p>{tr ? 'Strateji, ilişki geliştirme ve ticari uygulamayı tek bir süreçte bir araya getiriyoruz.' : 'We bring strategy, relationship development and commercial execution together in one process.'}</p></div><div class="capability-list">{services.map((service,i) => <a href={path(`/what-we-do#${service.slug}`)}><span class="service-number">0{i+1}</span><div><h3>{t(service.title,locale)}</h3><p>{t(service.summary,locale)}</p></div><span class="service-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>

    <section class="perspectives" aria-labelledby="perspectives-title"><div class="container-site"><div class="heading-row"><div><p class="kicker">{tr ? 'Görüşler ve analizler' : 'Insights & perspectives'}</p><h2 id="perspectives-title">{tr ? 'İleriye bakış.' : 'Looking ahead.'}</h2></div><a class="text-link" href={path('/insights')}>{tr ? 'Tüm görüşler' : 'All insights'} <span aria-hidden="true">↗</span></a></div><div class="insight-grid">{posts.map(post => <a class="insight-card" href={path(`/insights/${post.id.split('/').slice(1).join('/')}`)}><div class="insight-image">{post.data.cover && <Photo src={post.data.cover} alt="" widths={[480,768,1200]} sizes="(min-width:900px) 33vw, 100vw" class="cover" style={`object-position:${post.data.coverPosition}`} />}</div><p class="kicker">{topicLabel(post.data.topic,locale)}</p><h3>{post.data.title}</h3><span class="insight-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>

  </div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-sector-showcase]').forEach(showcase => {
    const tabs = Array.from(showcase.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(showcase.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const activate = (index: number, focus = false) => {
      tabs.forEach((tab,i) => { tab.setAttribute('aria-selected',String(i===index)); tab.tabIndex = i===index ? 0 : -1; panels[i].hidden = i!==index; });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab,i) => {
      tab.addEventListener('click', () => activate(i));
      tab.addEventListener('keydown', event => {
        let next = i;
        if(event.key === 'ArrowRight') next = (i+1)%tabs.length;
        else if(event.key === 'ArrowLeft') next = (i-1+tabs.length)%tabs.length;
        else if(event.key === 'Home') next = 0;
        else if(event.key === 'End') next = tabs.length-1;
        else return;
        event.preventDefault(); activate(next,true);
      });
    });
  });
  const projectShowcase = document.querySelector<HTMLElement>('[data-project-showcase]');
  if (projectShowcase) {
    const panels = Array.from(projectShowcase.querySelectorAll<HTMLElement>('[data-project-panel]'));
    const count = projectShowcase.querySelector('[data-project-count]');
    let current = 0;
    const change = (direction: number) => {
      current = (current + direction + panels.length) % panels.length;
      panels.forEach((panel,i) => { panel.hidden = i !== current; });
      if (count) count.textContent = `${String(current+1).padStart(2,'0')} / ${String(panels.length).padStart(2,'0')}`;
    };
    projectShowcase.querySelector('[data-project-prev]')?.addEventListener('click',() => change(-1));
    projectShowcase.querySelector('[data-project-next]')?.addEventListener('click',() => change(1));
  }

</script>

<style>
