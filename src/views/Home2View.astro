e:16px;line-height:1.75;margin:25px 0}.project-status{display:block;font-size:12px;color:#687c8a;margin-bottom:25px}.project-controls{display:flex;align-items:center;justify-content:end;gap:12px;margin-top:22px}.project-controls>span{font-size:12px;margin-right:16px;font-variant-numeric:tabular-nums}.project-controls button{width:45px;height:45px;border:1px solid #8f9faa;border-radius:50%;font-size:21px;cursor:pointer}.project-controls button:hover{background:#dce4e9}.capabilities{padding:65px 0;background:var(--night);color:white}.capability-grid{display:grid;grid-template-columns:1fr 1.3fr;gap:90px}.capability-heading h2{color:white}.capability-heading>p:last-child{font-size:16px;line-height:1.7;margin-top:25px;max-width:35ch;color:#c4d1db}.capability-list>a{display:grid;grid-template-columns:22px 1fr 22px;gap:16px;border-top:1px solid #ffffff35;padding:24px 0}.service-number{font-size:11px;color:#98c0d8}.service-arrow{font-size:23px}.capability-list h3{font-size:23px;color:white}.capability-list p{font-size:14px;line-height:1.7;margin-top:15px;color:#c4d1db}.perspectives{padding:60px 0;background:white}.perspectives .heading-row{margin-bottom:26px}.insight-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;align-items:start}.insight-image{height:220px;overflow:hidden;margin-bottom:20px}.insight-card .kicker{font-size:10px;margin-bottom:12px;color:#577181}.insight-card h3{font-size:24px;line-height:1.25}.insight-arrow{display:block;margin-top:18px;font-size:22px}.insight-card:hover h3,.capability-list>a:hover h3{color:#0f6fd6}.home-two button:focus-visible,.home-two a:focus-visible{outline:3px solid #0f6fd6;outline-offset:4px}
@media(max-width:1000px){.sector-tabs button{font-size:12px;padding:20px 12px}.tab-index,.tab-arrow{display:none}.positioning-grid{gap:40px}.project-card{gap:30px}.project-image{height:450px}.capability-grid{gap:40px}.insight-image{height:180px}}
@media(max-width:700px){.introduction{padding-top:55px}.intro-grid{display:block}.intro-heading{padding:0 0 30px 20px}.intro-heading h2{font-size:32px;overflow-wrap:anywhere}.intro-copy{padding:0 0 45px 20px}.intro-copy .lead{font-size:18px}.intro-copy p{font-size:15px}.field-strip{gap:12px;padding:0 12px 25px;grid-template-columns:1fr 1fr}.field-strip :global(.field-photo){height:190px}.field-strip :global(.field-photo:last-child){display:none}.positioning{padding:50px 0}.positioning-grid{grid-template-columns:1fr;gap:35px}.statement{font-size:clamp(57px,12vw,80px);line-height:.98}.position-copy{max-width:none}.position-copy p:not(.kicker){font-size:15px;margin:22px 0}.sector-showcase{margin:0}.section-top{padding-top:30px}.section-top h2{font-size:29px}.section-top .kicker{margin-bottom:12px}.sector-panel{min-height:650px}.sector-content{padding-top:180px;padding-bottom:170px;justify-content:stretch}.sector-copy{width:100%;padding:24px}.sector-copy h3{font-size:27px;margin:14px 0}.sector-copy p{font-size:14px;margin-bottom:20px}.sector-tabs{grid-template-columns:repeat(2,minmax(0,1fr))}.sector-tabs button{min-height:48px;font-size:12px;padding:12px 18px}.sector-tabs button:last-child{grid-column:1/-1}.projects{padding:50px 0 40px}.heading-row{align-items:start;flex-direction:column;gap:20px;margin-bottom:25px}.project-card{grid-template-columns:1fr;gap:25px}.project-image{height:290px}.project-copy h3{font-size:28px}.project-description{font-size:15px;margin:20px 0}.project-controls{margin-top:20px}.capabilities{padding:50px 0}.capability-grid{grid-template-columns:1fr;gap:30px}.capability-list h3{font-size:22px}.perspectives{padding:40px 0}.perspectives .heading-row{margin-bottom:22px}.insight-grid{grid-template-columns:1fr;gap:22px}.insight-card{display:grid;grid-template-columns:115px 1fr;column-gap:18px;border-bottom:1px solid #e0e5e9;padding-bottom:22px;align-items:start}.insight-image{grid-row:1/4;height:120px;margin:0}.insight-card .kicker{margin-bottom:8px}.insight-card h3{font-size:19px;line-height:1.25}.insight-arrow{font-size:18px;margin-top:10px}.insight-card:last-child{border:0;padding-bottom:0}}

</style>
