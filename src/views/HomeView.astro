---
import Base from '@layouts/Base.astro';
import BorderlessHero from '@components/sections/home/BorderlessHero.astro';
import HomeIntro from '@components/sections/home/HomeIntro.astro';
import HomeServices from '@components/sections/home/HomeServices.astro';
import HomeExperience from '@components/sections/home/HomeExperience.astro';
import HomeMarkets from '@components/sections/home/HomeMarkets.astro';
import HomeInsights from '@components/sections/home/HomeInsights.astro';
import WhyContinex from '@components/sections/WhyContinex.astro';
import LogoMarquee from '@components/sections/LogoMarquee.astro';
import ctaImage from '@assets/images/cta-people-walking.webp';
import { getLocale, t } from '@i18n/utils';
import { site } from '@data/site';
const locale = getLocale(Astro.url);
---
<Base title={site.name} description={t(site.description, locale)} headerTheme="dark" headerVariant="classic" ctaImage={ctaImage}>
  <BorderlessHero exploreHref="#home-about" />
  <HomeInsights />
  <HomeServices />
  <HomeExperience />
  <HomeIntro />
  <WhyContinex />
  <HomeMarkets />
  <LogoMarquee tone="light">
    {locale === 'en' && <Fragment slot="title">Companies we have <span style="color: #bebebe">worked with and alongside.</span></Fragment>}
  </LogoMarquee>
</Base>
