---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import FinalCta from '@components/sections/FinalCta.astro';
import { getLocale, localizePath } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';

interface Props { post: CollectionEntry<'insights'> }
const { post } = Astro.props;
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat(locale === 'tr' ? 'tr-TR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description}>
  <article class="section">
    <div class="container-site">
      <div class="mx-auto max-w-3xl">
        <a href={localizePath('/insights', locale)} class="text-sm font-semibold text-accent-600 hover:underline underline-offset-4">← {tr('insights.back')}</a>
        <p class="mt-8 text-xs text-ink-400">{fmt.format(post.data.publishDate)} · {post.data.author}</p>
        <h1 class="mt-3 text-h1">{post.data.title}</h1>
        <p class="mt-5 text-lead text-ink-500">{post.data.description}</p>
      </div>
      {post.data.cover && <div class="mx-auto mt-10 max-w-5xl overflow-hidden rounded-card"><Image src={post.data.cover} alt={post.data.coverAlt ?? ''} widths={[768, 1280]} sizes="(min-width: 1024px) 1024px, 100vw" layout="none" class="aspect-[2/1] w-full object-cover" /></div>}
      <div class="prose-site mx-auto mt-12 max-w-3xl space-y-5 text-[17px] [&_h2]:mt-10 [&_h2]:text-h3 [&_ul]:list-disc [&_ul]:pl-6 [&_a]:underline [&_a]:underline-offset-4"><Content /></div>
    </div>
  </article>
  <FinalCta />
</Base>
