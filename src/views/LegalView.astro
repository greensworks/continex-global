---
import Base from '@layouts/Base.astro';
import { legalDocs, type LegalKind } from '@data/legal';
import { site } from '@data/site';
import { getLocale, t } from '@i18n/utils';

interface Props { kind: LegalKind }
const { kind } = Astro.props;
const locale = getLocale(Astro.url);
const doc = legalDocs[kind];
const title = t(doc.title, locale);
const updated = new Intl.DateTimeFormat(locale === 'tr' ? 'tr-TR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(doc.updated));
---
<Base title={title} description={t(doc.intro, locale)}>
  <section class="section">
    <div class="container-site">
      <div class="max-w-3xl">
        <p class="eyebrow">{locale === 'tr' ? 'Yasal' : 'Legal'}</p>
        <h1 class="mt-4 text-h1">{title}</h1>
        <p class="mt-3 text-xs text-ink-400">{locale === 'tr' ? 'Son güncelleme' : 'Last updated'}: {updated}</p>
        <p class="mt-6 text-lead text-ink-500">{t(doc.intro, locale)}</p>
        <div class="mt-12 space-y-10">
          {doc.sections.map((s) => (
            <section>
              <h2 class="text-h3">{t(s.title, locale)}</h2>
              {s.paragraphs.map((p) => <p class="mt-3 text-[15px] leading-relaxed text-ink-700">{t(p, locale)}</p>)}
            </section>
          ))}
        </div>
        {kind === 'cookies' && <p class="mt-10"><a href="#" data-open-consent class="text-sm font-semibold text-accent-600 underline underline-offset-4">{locale === 'tr' ? 'Çerez tercihlerini değiştir' : 'Change cookie preferences'}</a></p>}
        <p class="mt-12 border-t border-line pt-6 text-sm text-ink-500">{site.legalName} · {site.address.lines.join(', ')} · <a href={`mailto:${site.email}`} class="underline underline-offset-4">{site.email}</a></p>
      </div>
    </div>
  </section>
</Base>
