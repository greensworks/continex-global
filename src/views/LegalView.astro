---
import Base from '@layouts/Base.astro';
import PageHero from '@components/sections/PageHero.astro';
import LegalDocument from '@components/sections/LegalDocument.astro';
import { legalDocs, type LegalKind } from '@data/legal';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';

interface Props { kind: LegalKind }
const { kind } = Astro.props;
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const doc = legalDocs[kind];
const title = t(doc.title, locale);
---
<Base title={title} description={t(doc.intro, locale)} cta={false} noindex>
  <PageHero
    breadcrumb={[{ label: tr('nav.home'), href: localizePath('/', locale) }, { label: title }]}
    title={title}
    lead={t(doc.intro, locale)}
  />
  <LegalDocument kind={kind} />
</Base>
