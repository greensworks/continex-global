---
import Base from '@layouts/Base.astro';
import PageHero from '@components/sections/PageHero.astro';
import MarketsGrid from '@components/sections/MarketsGrid.astro';
import LogoMarquee from '@components/sections/LogoMarquee.astro';
import FinalCta from '@components/sections/FinalCta.astro';
import { pages } from '@data/pages';
import { getLocale, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import heroImg from '@assets/images/grain-silos-dusk.webp';
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
---
<Base title={t(pages.markets.title, locale)} description={t(pages.markets.lead, locale)} headerTheme="dark">
  <PageHero eyebrow={tr('nav.markets')} title={t(pages.markets.title, locale)} lead={t(pages.markets.lead, locale)} image={heroImg} />
  <MarketsGrid />
  <LogoMarquee tone="light" />
  <FinalCta />
</Base>
