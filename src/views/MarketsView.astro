---
import Base from '@layouts/Base.astro';
import PageHero from '@components/sections/PageHero.astro';
import Photo from '@components/ui/Photo.astro';
import HomeExperience from '@components/sections/home/HomeExperience.astro';
import { markets, coverageLabels } from '@data/markets';
import { img } from '@/lib/images';
import LogoMarquee from '@components/sections/LogoMarquee.astro';
import { pages } from '@data/pages';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import heroImg from '@assets/images/markets-connections.webp';
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const intro = locale === 'tr'
  ? ['Türkiye merkezli bir kuruluş olarak ana pazarımız Türkiye’dir. Çin’de üreticiler, EPC grupları ve yatırımcılarla doğrudan çalışma ilişkilerimiz; Avrupa, Orta Doğu, Orta Asya ve Güneydoğu Asya’da ise belirli fırsat ve mandatlara dayalı kapsamımız bulunmaktadır.', 'İstanbul’daki merkez ofisimiz, Çin’deki stratejik iş ilişkilerimiz ve diğer bölgelerdeki pazar kapsamımız farklı çalışma modellerine dayanır.']
  : ['Türkiye is our home market. In China we hold direct working relationships with manufacturers, EPC groups and investors; in Europe, the Middle East, Central Asia and Southeast Asia our coverage is built around specific opportunities and mandates.', 'Our Istanbul head office, strategic relationships in China and coverage in other regions represent distinct ways of working.'];
---
<Base title={t(pages.markets.title, locale)} description={t(pages.markets.lead, locale)} headerTheme="dark">
  <PageHero breadcrumb={[{ label: tr('nav.home'), href: localizePath('/', locale) }, { label: tr('nav.markets') }]} title={t(pages.markets.title, locale)} lead={t(pages.markets.lead, locale)} image={heroImg} />
  <section class="market-intro" aria-labelledby="markets-intro-title">
    <div class="container-site">
      <p class="eyebrow">{locale === 'tr' ? 'Uluslararası erişim' : 'Our international reach'}</p>
      <h2 id="markets-intro-title">{locale === 'tr' ? <>Türkiye merkezli.<br /><span>Asya ve Avrupa’ya uzanan kapsam.</span></> : <>Based in Türkiye.<br /><span>Connected across Asia and Europe.</span></>}</h2>
      <p class="intro-lead">{intro[0]}</p>
    </div>
  </section>
  <section class="core-markets" aria-label={locale === 'tr' ? 'Türkiye ve Çin' : 'Türkiye and China'}>
    <div class="container-site core-grid">
      {markets.slice(0,2).map((m,i) => <article class:list={['market-feature',i===1 && 'market-feature-dark']}>
        <div class="market-photo"><Photo src={img(i===0 ? 'insight-turkiye-market' : 'insight-china-local-execution-v2')} alt="" widths={[480,768,1200]} sizes="(min-width:768px) 50vw, 100vw" class="h-full w-full object-cover" /></div>
        <div class="market-copy">
          <p class="market-type">{locale === 'tr' ? (i===0 ? 'Merkez ofis · İstanbul' : 'Stratejik iş ilişkileri') : (i===0 ? 'Head office · Istanbul' : 'Strategic relationships')}</p>
          <h2>{t(m.name,locale)}</h2>
          <p class="market-description">{t(m.text,locale)}</p>
          <a class="market-link" href={localizePath('/contact',locale)}>{locale === 'tr' ? 'Fırsatınızı görüşelim' : 'Discuss an opportunity'} <span aria-hidden="true">↗</span></a>
        </div>
      </article>)}
    </div>
  </section>
  <section class="regional-markets section" aria-labelledby="regional-title">
    <div class="container-site regional-grid">
      <div class="regional-intro"><p class="eyebrow text-steel-300">{locale === 'tr' ? 'Bölgesel kapsam' : 'Regional coverage'}</p><h2 id="regional-title">{locale === 'tr' ? <>Fırsat odaklı.<br /><span>Sınırların ötesinde.</span></> : <>Opportunity-led.<br /><span>Across borders.</span></>}</h2><p>{intro[1]}</p></div>
      <div class="region-list">{markets.slice(2).map(m => <article><p class="region-type">{t(coverageLabels[m.coverage],locale)}</p><h3>{t(m.name,locale)}</h3><p>{t(m.text,locale)}</p></article>)}</div>
    </div>
  </section>
  <HomeExperience />
  <LogoMarquee tone="light" />
</Base>
<style>
.market-intro{padding:80px 0 48px;text-align:center;background:white}.market-intro h2{font-size:clamp(34px,4vw,54px);font-weight:400;line-height:1.12;letter-spacing:-.035em;max-width:900px;margin:20px auto 0}.market-intro h2 span{color:#bebebe}.intro-lead{max-width:820px;margin:28px auto 0;font-size:16px;line-height:1.85;color:#637181}.core-markets{padding:0 0 96px;background:white}.core-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px}.market-feature{display:flex;flex-direction:column;min-width:0}.market-photo{height:360px;overflow:hidden;background:#e6edf3}.market-copy{position:relative;margin:-40px 0 0 32px;padding:36px;background:#edf3f8;flex:1;display:flex;flex-direction:column}.market-type{color:#0f6fd6;font-size:10px;letter-spacing:.12em;text-transform:uppercase;font-weight:600}.market-copy h2{font-size:42px;line-height:1.15;letter-spacing:-.03em;font-weight:400;margin-top:16px}.market-description{font-size:16px;line-height:1.75;color:#536172;margin:20px 0 28px}.market-link{display:flex;justify-content:space-between;gap:24px;border-bottom:1px solid #a9bdcf;padding-bottom:12px;margin-top:auto;font-size:14px;color:#0f6fd6}.market-link span{font-size:22px}.market-link:hover{color:#122744}.market-feature-dark .market-copy{background:#0b1a30}.market-feature-dark h2{color:white}.market-feature-dark .market-description{color:#c1ccda}.market-feature-dark .market-type{color:#98c0d8}.market-feature-dark .market-link{color:white;border-color:#ffffff40}.market-feature-dark .market-link:hover{color:#98c0d8}.regional-markets{background:#0b1a30;color:white}.regional-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:80px}.regional-intro h2{font-size:clamp(34px,3.8vw,50px);font-weight:400;line-height:1.13;letter-spacing:-.035em;color:white;margin-top:20px}.regional-intro h2 span{color:#bebebe}.regional-intro>p:last-child{font-size:15px;line-height:1.8;color:#bdc9d8;max-width:42ch;margin-top:28px}.region-list{display:grid;grid-template-columns:1fr 1fr;gap:40px}.region-list article{border-top:1px solid #ffffff40;padding-top:22px}.region-type{color:#98c0d8;font-size:10px;letter-spacing:.1em;text-transform:uppercase}.region-list h3{font-size:28px;font-weight:400;line-height:1.2;letter-spacing:-.025em;color:white;margin-top:16px}.region-list article>p:last-child{font-size:14px;color:#bdc9d8;line-height:1.75;margin-top:16px}@media(max-width:1023px){.regional-grid{gap:40px;grid-template-columns:1fr 1.3fr}.region-list{gap:28px}.market-copy{padding:28px;margin-left:20px}}@media(max-width:767px){.market-intro{padding:48px 0 32px;text-align:left}.intro-lead{font-size:15px;margin-top:24px}.core-grid,.regional-grid{grid-template-columns:1fr}.core-grid{gap:36px}.market-photo{height:280px}.market-copy h2{font-size:36px}.core-markets{padding-bottom:56px}.region-list{grid-template-columns:1fr;gap:32px}.regional-intro>p:last-child{max-width:none}.market-description{font-size:15px}}
</style>
