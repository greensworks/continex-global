---
import Base from '@layouts/Base.astro';
import Photo from '@components/ui/Photo.astro';
import contactImage from '@assets/images/office-tablet.webp';
import ContactDetails from '@components/sections/ContactDetails.astro';
import { pages } from '@data/pages';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
---
<Base title={t(pages.contact.title, locale)} description={t(pages.contact.lead, locale)} cta={false}>
  <section class="contact-intro" aria-labelledby="contact-title">
    <div class="container-site contact-intro-grid">
      <div class="contact-intro-copy">
        <nav class="contact-breadcrumb" aria-label={locale === 'tr' ? 'Sayfa yolu' : 'Breadcrumb'}><a href={localizePath('/',locale)}>{tr('nav.home')}</a><span aria-hidden="true">/</span><span>{tr('nav.contact')}</span></nav>
        <p class="eyebrow">{locale === 'tr' ? 'Birlikte başlayalım' : 'Let’s start a conversation'}</p>
        <h1 id="contact-title">{t(pages.contact.title,locale)}</h1>
        <p class="contact-lead">{t(pages.contact.lead,locale)}</p>
        <a class="contact-intro-link" href="#enquiry">{locale === 'tr' ? 'Bize projenizden bahsedin' : 'Tell us about your project'}<span aria-hidden="true">↓</span></a>
      </div>
      <div class="contact-intro-photo"><Photo src={contactImage} alt="" widths={[480,768,1200]} sizes="(min-width:1024px) 45vw, 100vw" loading="eager" class="h-full w-full object-cover" /></div>
    </div>
  </section>
  <ContactDetails />
</Base>

<style>
.contact-intro{background:#f3f6f9;padding:60px 0 64px}.contact-intro-grid{display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:72px}.contact-breadcrumb{display:flex;gap:12px;color:#69788a;font-size:12px;margin-bottom:40px}.contact-breadcrumb a:hover{color:#0f6fd6}.contact-intro-copy h1{font-size:clamp(38px,4.3vw,60px);font-weight:400;line-height:1.08;letter-spacing:-.04em;margin-top:20px;color:#122744}.contact-lead{font-size:18px;line-height:1.75;color:#536172;margin-top:28px;max-width:48ch}.contact-intro-link{display:inline-flex;align-items:center;gap:32px;border-bottom:1px solid #9bb7ce;padding-bottom:12px;margin-top:28px;font-size:14px;color:#0f6fd6}.contact-intro-photo{height:430px;overflow:hidden}@media(max-width:1023px){.contact-intro-grid{gap:36px}.contact-intro-photo{height:400px}}@media(max-width:767px){.contact-intro{padding:32px 0 40px}.contact-intro-grid{grid-template-columns:1fr;gap:36px}.contact-breadcrumb{margin-bottom:28px}.contact-lead{font-size:16px}.contact-intro-photo{height:240px}}
</style>
