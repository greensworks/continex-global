---
import Base from '@layouts/Base.astro';
import PageHero from '@components/sections/PageHero.astro';
import ContactDetails from '@components/sections/ContactDetails.astro';
import { pages } from '@data/pages';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
---
<Base title={t(pages.contact.title, locale)} description={t(pages.contact.lead, locale)} cta={false}>
  <PageHero breadcrumb={[{ label: tr('nav.home'), href: localizePath('/', locale) }, { label: tr('nav.contact') }]} title={t(pages.contact.title, locale)} lead={t(pages.contact.lead, locale)} />
  <ContactDetails />
</Base>
