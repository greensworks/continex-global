---
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
import '@/styles/global.css';
import type { ImageMetadata } from 'astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import FinalCta from '@components/sections/FinalCta.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import Analytics from '@components/analytics/Analytics.astro';
import { getLocale, switchLocalePath, stripLocale } from '@i18n/utils';
import { locales, type Locale } from '@i18n/config';
import { site } from '@data/site';

interface Props {
  title: string;
  description: string;
  /** Path to an OG image in /public, optional */
  ogImage?: string;
  ogType?: 'website' | 'article';
  localePaths?: Partial<Record<Locale, string>>;
  /** 'dark' = hero runs behind the header; 'light' = header sits on a spacer */
  headerTheme?: 'dark' | 'light';
  /** 'classic' = homepage bar over the hero; 'bar' = inner-page RB header */
  headerVariant?: 'classic' | 'bar';
  noindex?: boolean;
  /** closing CTA band above the footer */
  cta?: boolean;
  /** photo behind the closing CTA (defaults to one chosen per page) */
  ctaImage?: ImageMetadata;
}

const { title, description, localePaths, ogType = 'website', ogImage = '/og-default.jpg', headerTheme = 'light', headerVariant = 'bar', noindex = false, cta = true, ctaImage } = Astro.props;
const locale = getLocale(Astro.url);
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const path = stripLocale(Astro.url.pathname);
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION;
---
<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {gscToken && <meta name="google-site-verification" content={gscToken} />}
    <link rel="icon" href="/favicon.webp" type="image/webp" />
    <meta name="theme-color" content="#122744" />

    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localePaths?.[l] ?? switchLocalePath(path, l), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localePaths?.en ?? path, Astro.site)} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded focus:bg-navy-900 focus:px-4 focus:py-2 focus:text-white">
      {locale === 'tr' ? 'İçeriğe geç' : 'Skip to content'}
    </a>
    <Header theme={headerTheme} variant={headerVariant} localePaths={localePaths} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    {cta && <FinalCta image={ctaImage} />}
    <Footer />
    <CookieConsent />
    <Analytics />
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>
