---
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
import '@/styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import defaultSocialSource from '@assets/images/cta-people-walking.webp';
import brandLogo from '@assets/logos/continex-global-logo.png';
import { seoMetadata, pageGraph } from '@/lib/seo';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import FinalCta from '@components/sections/FinalCta.astro';
import CookieConsent from '@components/layout/CookieConsent.astro';
import Analytics from '@components/analytics/Analytics.astro';
import { getLocale, switchLocalePath, stripLocale } from '@i18n/utils';
import { locales, type Locale } from '@i18n/config';
import { site } from '@data/site';
import { developer } from '@data/developer';

interface Props {
  title: string;
  seoTitle?: string;
  structuredData?: Record<string, unknown>[];
  description: string;
  /** Path to an OG image in /public, optional */
  ogImage?: string;
  ogType?: 'website' | 'article';
  localePaths?: Partial<Record<Locale, string>>;
  /** 'dark' = hero runs behind the header; 'light' = header sits on a spacer */
  headerTheme?: 'dark' | 'light';
  /** 'classic' = homepage bar over the hero; 'bar' = inner-page RB header */
  headerVariant?: 'classic' | 'bar';
  noindex?: boolean;
  /** closing CTA band above the footer */
  cta?: boolean;
  /** photo behind the closing CTA (defaults to one chosen per page) */
  ctaImage?: ImageMetadata;
}

const { title, description, localePaths, ogType = 'website', ogImage, headerTheme = 'light', headerVariant = 'bar', noindex = false, cta = true, ctaImage } = Astro.props;
const locale = getLocale(Astro.url);
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);
const path = stripLocale(Astro.url.pathname);
const seo = seoMetadata(path, locale, Astro.props.seoTitle ?? title, description);
const fullTitle = seo.title === site.name ? seo.title : `${seo.title} | ${site.name}`;
const socialImage = ogImage ?? (await getImage({ src: defaultSocialSource, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 85 })).src;
const socialUrl = new URL(socialImage, Astro.site).href;
const schema = { '@context': 'https://schema.org', '@graph': [...pageGraph(Astro.site!, canonical.href, path, locale, title, seo.description, socialUrl, new URL(brandLogo.src, Astro.site).href), ...(Astro.props.structuredData ?? [])] };
const alternates = Object.entries(localePaths ?? Object.fromEntries(locales.map(l => [l, switchLocalePath(path, l)])));
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION;
---
<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="creator" content={developer.name} />
    <title>{fullTitle}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    {gscToken && <meta name="google-site-verification" content={gscToken} />}
    <link rel="icon" href="/favicon.webp" type="image/webp" />
    <meta name="theme-color" content="#122744" />

    {!noindex && <>
      {alternates.map(([language, href]) => <link rel="alternate" hreflang={language} href={new URL(href!, Astro.site)} />)}
      {alternates.some(([language]) => language === 'en') && <link rel="alternate" hreflang="x-default" href={new URL(alternates.find(([language]) => language === 'en')![1]!, Astro.site)} />}
    </>}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialUrl} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale:alternate" content={locale === 'tr' ? 'en_US' : 'tr_TR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={socialUrl} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}

    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded focus:bg-navy-900 focus:px-4 focus:py-2 focus:text-white">
      {locale === 'tr' ? 'İçeriğe geç' : 'Skip to content'}
    </a>
    <Header theme={headerTheme} variant={headerVariant} localePaths={localePaths} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    {cta && <FinalCta image={ctaImage} />}
    <Footer />
    <CookieConsent />
    <Analytics />
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>
