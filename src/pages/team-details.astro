ors deal with industry\r\n                              </p>\r\n                              <p class=\"tp-team-details-exp-text\">\r\n                                 related barriers, including advertising  restrictions and shifting client demands, making it difficult to  generate consistent business.\r\n                              </p>\r\n                           </div>\r\n                        </div>\r\n                     </div>\r\n                  </div>\r\n               </div>\r\n            </div>\r\n         </div>\r\n         <!-- team details exp area end -->\r\n\r\n\r\n         <!-- cta area start -->\r\n         <div class=\"tp-fa-cta-ptb\">\r\n            <div class=\"tp-fa-cta-thumb\">\r\n               <img src=\"/assets/img/advisory/cta/thumb.jpg\" alt=\"\">\r\n            </div>\r\n         </div>\r\n         <!-- cta area end -->\r\n         \r\n\r\n      </main>";
