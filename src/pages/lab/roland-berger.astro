---
/**
 * Component lab: rolandberger.com homepage, section by section.
 * No site chrome; each block has a Copy button (copies the .astro source).
 */
import Lab from '@layouts/Lab.astro';
import Frame from '@components/lab/ComponentFrame.astro';
import RbHeader from '@components/lab/rb/RbHeader.astro';
import RbHero from '@components/lab/rb/RbHero.astro';
import RbSectionHeadline from '@components/lab/rb/RbSectionHeadline.astro';
import RbTileGrid from '@components/lab/rb/RbTileGrid.astro';
import RbOverline from '@components/lab/rb/RbOverline.astro';
import RbFlagCta from '@components/lab/rb/RbFlagCta.astro';
import RbExpertQuote from '@components/lab/rb/RbExpertQuote.astro';
import RbJoinTiles from '@components/lab/rb/RbJoinTiles.astro';
import RbSeparator from '@components/lab/rb/RbSeparator.astro';
import RbAwardBadge from '@components/lab/rb/RbAwardBadge.astro';
import RbContactBox from '@components/lab/rb/RbContactBox.astro';
import RbBreadcrumb from '@components/lab/rb/RbBreadcrumb.astro';
import RbFooter from '@components/lab/rb/RbFooter.astro';

const raw = import.meta.glob<string>('/src/components/lab/rb/*.astro', { query: '?raw', import: 'default', eager: true });
const src = (name: string) => raw[`/src/components/lab/rb/${name}.astro`] ?? '';
---
<Lab title="Roland Berger">
  <Frame name="RbHeader" source={src('RbHeader')}>
    <RbHeader mode="static" />
  </Frame>

  <Frame name="RbHero" source={src('RbHero')}>
    <RbHero>
      <RbHeader slot="header" mode="overlay" />
    </RbHero>
  </Frame>

  <Frame name="RbSectionHeadline" source={src('RbSectionHeadline')}>
    <RbSectionHeadline title="Insights to drive real<br />business outcomes" />
  </Frame>

  <Frame name="RbTileGrid" source={src('RbTileGrid')}>
    <RbTileGrid />
  </Frame>

  <Frame name="RbOverline" source={src('RbOverline')}>
    <RbOverline text="Our latest insights, delivered straight to your inbox" />
  </Frame>

  <Frame name="RbFlagCta" source={src('RbFlagCta')}>
    <RbFlagCta />
  </Frame>

  <Frame name="RbExpertQuote" source={src('RbExpertQuote')}>
    <RbOverline text="Meet our experts" />
    <RbExpertQuote />
  </Frame>

  <Frame name="RbJoinTiles" source={src('RbJoinTiles')}>
    <RbOverline text="Join the team" />
    <RbJoinTiles />
  </Frame>

  <Frame name="RbSeparator" source={src('RbSeparator')}>
    <RbSeparator />
  </Frame>

  <Frame name="RbAwardBadge" source={src('RbAwardBadge')}>
    <RbOverline text="What others say" line={false} />
    <RbAwardBadge />
  </Frame>

  <Frame name="RbContactBox" source={src('RbContactBox')}>
    <RbSeparator />
    <RbContactBox />
  </Frame>

  <Frame name="RbBreadcrumb" source={src('RbBreadcrumb')}>
    <RbBreadcrumb />
  </Frame>

  <Frame name="RbFooter" source={src('RbFooter')}>
    <RbFooter />
  </Frame>
</Lab>
