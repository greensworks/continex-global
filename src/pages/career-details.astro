---
import BaseLayout from '../components/BaseLayout.astro';

const pageHeader = "<meta http-equiv=\"x-ua-compatible\" content=\"ie=edge\">\n<title>Continex Global - Business Finance & Consulting HTML Template</title>\n<meta name=\"description\" content=\"\">";
const pageContent = "<main>\r\n\r\n         <!-- breadcrumb area start -->\r\n         <div class=\"tp-breadcrumb-ptb pt-90 pb-70 z-index-1\">\r\n            <div class=\"tp-cc-chose-bg\">\r\n               <img src=\"/assets/img/breadcrumb/image-1.jpg\" alt=\"\">\r\n            </div>\r\n            <div class=\"container\">\r\n               <div class=\"row\">\r\n                  <div class=\"col-lg-5\">\r\n                     <div class=\"tp-breadcrumb-content p-relative\">\r\n                        <ul class=\"tp-breadcrumb-list\">\r\n                           <li><a href=\"index.html\">Home</a></li>\r\n                           <li>></li>\r\n                           <li>Career Details</li>\r\n                        </ul>\r\n                        <h2 class=\"tp-breadcrumb-title\">Career Details</h2>\r\n                        <p>Change your life while changing the lives of others Want to do work that matters, <br> alongside people who care about impact and integrity? </p>\r\n                     </div>\r\n                  </div>\r\n               </div>\r\n            </div>\r\n         </div>\r\n         <!-- breadcrumb area end -->\r\n\r\n\r\n         <!-- career details area start -->\r\n         <div class=\"tp-career-details-ptb pt-135 pb-110\">\r\n            <div class=\"container\">\r\n               <div class=\"row justify-content-center\">\r\n                  <div class=\"col-xl-8 col-12\">\r\n                     <div class=\"tp-career-details-heading tp-career-details-line text-center pb-95 mb-80\">\r\n                        <span class=\"tp-section-sub\">Career</span>\r\n                        <h3 class=\"tp-section-title mb-25\">Financial and business advisor</h3>\r\n                        <p>At Continex Global, we believe in transforming ideas into impactful digital solutions. As a forward-thinking agency, we specialize in <br> empowering businesses to thrive in the digital era. From cutting-edge web development to strategic digital marketing, <br> Our team is dedicated to creating tailored solutions that drive growth.</p>\r\n                     </div>\r\n                     <div class=\"tp-career-details-item-wrapper pb-130\">\r\n                        <div class=\"tp-career-details-item tp-career-details-line pb-60 mb-70\">\r\n                           <h3 class=\"tp-career-details-title\">About the role:</h3>\r\n                           <p>We are looking for a Lead Financial advisor to establish and grow Continex Global’s Platform Engineering function. This is a high-impact,\r\n                           multidisciplinary role for someone who thrives in ambiguity, enjoys wearing multiple hats, and wants to build a function from the ground up.\r\n                           You will architect and own our multiload infrastructure (GCP + AWS), expand our CI/CD and release processes, standardize observability\r\n                           and monitoring, and elevate our security posture across the engineering organization.</p>\r\n                           <p>As the first member of this new team, you will shape the technical vision, partner closely with engineering leadership, and eventually help hire\r\n                           and mentor additional platform engineers. This is a rare opportunity to design and lead a platform function at a fast-scaling AI company\r\n                           while still getting your hands dirty building tools, infrastructure, and processes used daily by every engineer.</p>\r\n                        </div>\r\n                        <div class=\"tp-career-details-item tp-career-details-line pb-60 mb-70\">\r\n                           <h3 class=\"tp-career-details-title\">What we’re looking for:</h3>\r\n                           <div class=\"tp-career-details-item-list\">\r\n                              <ul>\r\n                                 <li>8–10+ years of experience in DevOps, SRE, infrastructure, or platform engineering roles.</li>\r\n                                 <li>Deep hands-on expertise with cloud platforms (GCP and/or AWS) and infrastructure-as-code (Terraform preferred).</li>\r\n                                 <li>Strong experience building and maintaining CI/CD pipelines for modern application stacks.</li>\r\n                                 <li>Proficiency in modern observability ecosystems (Datadog experience is a major plus).</li>\r\n                                 <li>Solid understanding of cloud security, IAM, container security, and network architecture.</li>\r\n                                 <li>Ability to lead technical initiatives across teams and influence engineering best practices.</li>\r\n                                 <li>Comfortable being the first hire on a new team—capable of switching between architect, implementer, mentor, and operator roles.</li>\r\n                              </ul>\r\n                           </div>\r\n                        </div>\r\n                        <div class=\"tp-career-details-item\">\r\n                           <h3 class=\"tp-career-details-title\">Benefits:</h3>\r\n                           <div class=\"tp-career-details-item-list\">\r\n                              <ul>\r\n                                 <li>Generous retirement, equity, healthcare, and PTO policies</li>\r\n                                 <li>Flexibility to work remotely from anywhere in the United States</li>\r\n                                 <li>ReflexAI is an equal opportunity employer. We are committed to equal employment opportunities regardless of race/ethnicity, color,</li>\r\n                                 <li>ancestry, religion, sex, national origin, sexual orientation, age, citizenship, marital status, disability, gender, military status, neurodiversity, or any other federal, state or local protected class in the United States</li>\r\n                              </ul>\r\n                           </div>\r\n                        </div>\r\n                     </div>\r\n                     <div class=\"tp-career-details-input-box radius-6\" data-bg-color=\"#F7F7F5\">\r\n                        <div class=\"tp-career-details-input-top\">\r\n                           <h3 class=\"tp-section-title mb-15\">Financial service career application</h3>\r\n                           <p>Apply for a career opportunity in the financial services sector by submitting your details below.</p>\r\n                        </div>\r\n                        <div class=\"tp-career-details-input-content\">\r\n                           <form action=\"#\">\r\n                              <div class=\"row\">\r\n                                 <div class=\"col-lg-12\">\r\n                                    <label class=\"tp-career-details-input-label\">Your full name*</label>\r\n                                 </div>\r\n                                 <div class=\"col-lg-6\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <input type=\"text\" placeholder=\"Your Name\">\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-6\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <input type=\"text\" placeholder=\"Last Name\">\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-12\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <label class=\"tp-career-details-input-label\">Email address*</label>\r\n                                       <input type=\"email\" placeholder=\"lusimanager@gmail.com\">\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-6\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <label class=\"tp-career-details-input-label\">Phone number*</label>\r\n                                       <input type=\"text\" placeholder=\"000+ 000 0000 0000\">\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-12\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <label class=\"tp-career-details-input-label\">Current address*</label>\r\n                                       <input type=\"text\" placeholder=\"Street address\">\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-12\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <input type=\"text\" placeholder=\"Street Address Line 2\">\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-4\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <input type=\"text\" placeholder=\"City\">\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-4\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <input type=\"text\" placeholder=\"State / Province\">\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-4\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <input type=\"text\" placeholder=\"Postal / Zip Code\">\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-12\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <label class=\"tp-career-details-input-label\">Position applied for*</label>\r\n                                       <div class=\"row\">\r\n                                          <div class=\"col-lg-6\">\r\n                                             <div class=\"nice-select tp-select\">\r\n                                                <select>\r\n                                                   <option>Please select position</option>\r\n                                                   <option>New Added</option>\r\n                                                   <option>On Sale</option>\r\n                                                </select>\r\n                                             </div>\r\n                                          </div>\r\n                                       </div>\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-12\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <label class=\"tp-career-details-input-label\">Highest level of education*</label>\r\n                                       <div class=\"row\">\r\n                                          <div class=\"col-lg-6\">\r\n                                             <div class=\"nice-select tp-select\">\r\n                                                <select>\r\n                                                   <option>Please select</option>\r\n                                                   <option>New Added</option>\r\n                                                   <option>On Sale</option>\r\n                                                </select>\r\n                                             </div>\r\n                                          </div>\r\n                                       </div>\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-12\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <label class=\"tp-career-details-input-label\">List your professional certifications (e.g., CFA, CPA, FRM, etc.)</label>\r\n                                       <textarea placeholder=\"\"></textarea>\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-12\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <label class=\"tp-career-details-input-label\">Briefly describe your relevant work experience in financial services*</label>\r\n                                       <textarea placeholder=\"\"></textarea>\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-12\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <label class=\"tp-career-details-input-label\">Select your key skills relevant to financial services*</label>\r\n                                       <div class=\"tp-checkbox-item mb-10\">\r\n                                          <input class=\"tp-form-checkbox\" id=\"checkbox\" type=\"checkbox\">\r\n                                          <label class=\"tp-form-checkbox-label\" for=\"checkbox\">Financial analysis</label>\r\n                                       </div>\r\n                                       <div class=\"tp-checkbox-item mb-10\">\r\n                                          <input class=\"tp-form-checkbox\" id=\"checkbox1\" type=\"checkbox\">\r\n                                          <label class=\"tp-form-checkbox-label\" for=\"checkbox1\">Risk assessment</label>\r\n                                       </div>\r\n                                       <div class=\"tp-checkbox-item mb-10\">\r\n                                          <input class=\"tp-form-checkbox\" id=\"checkbox2\" type=\"checkbox\">\r\n                                          <label class=\"tp-form-checkbox-label\" for=\"checkbox2\">Client relationship management</label>\r\n                                       </div>\r\n                                       <div class=\"tp-checkbox-item mb-10\">\r\n                                          <input class=\"tp-form-checkbox\" id=\"checkbox3\" type=\"checkbox\">\r\n                                          <label class=\"tp-form-checkbox-label\" for=\"checkbox3\">Compliance and regulation</label>\r\n                                       </div>\r\n                                       <div class=\"tp-checkbox-item mb-10\">\r\n                                          <input class=\"tp-form-checkbox\" id=\"checkbox4\" type=\"checkbox\">\r\n                                          <label class=\"tp-form-checkbox-label\" for=\"checkbox4\">Investment strategies</label>\r\n                                       </div>\r\n                                       <div class=\"tp-checkbox-item mb-10\">\r\n                                          <input class=\"tp-form-checkbox\" id=\"checkbox5\" type=\"checkbox\">\r\n                                          <label class=\"tp-form-checkbox-label\" for=\"checkbox5\">Others</label>\r\n                                       </div>\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-12\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <label class=\"tp-career-details-input-label\">Upload your resume or CV*</label>\r\n                                       <div class=\"tp-file-upload\">\r\n                                          <label class=\"tp-file-upload-content\">\r\n\r\n                                             <input type=\"file\" class=\"file-input\" accept=\"image/*\">\r\n\r\n                                             <span class=\"tp-file-upload-content-pos\">\r\n                                                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"42\" height=\"30\" viewBox=\"0 0 42 30\" fill=\"none\">\r\n                                                <path d=\"M32.2157 30H25.5518H23.7574H23.3698V21.0615H26.2932C27.0345 21.0615 27.4726 20.219 27.0345 19.6125L21.3479 11.7439C20.9857 11.2384 20.2359 11.2384 19.8736 11.7439L14.187 19.6125C13.7489 20.219 14.1786 21.0615 14.9284 21.0615H17.8517V30H17.4642H15.6698H7.9444C3.52148 29.7557 0 25.6192 0 21.1373C0 18.0455 1.6765 15.3496 4.16175 13.8922C3.93429 13.2772 3.81634 12.6201 3.81634 11.9292C3.81634 8.77001 6.369 6.21735 9.52822 6.21735C10.2106 6.21735 10.8677 6.3353 11.4827 6.56276C13.3109 2.68745 17.2536 0 21.8366 0C27.7675 0.0084246 32.6538 4.54928 33.2098 10.337C37.7675 11.1205 41.23 15.3412 41.23 20.1179C41.23 25.2233 37.2536 29.6462 32.2157 30Z\" fill=\"#222F30\"/>\r\n                                                </svg>\r\n                                                <span>Upload a file</span>\r\n                                             </span>\r\n\r\n                                             <img class=\"preview-image\" src=\"\" style=\"display:none; max-width:100%;\" alt=\"\">\r\n\r\n                                          </label>\r\n                                       </div>\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-12\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <label class=\"tp-career-details-input-label\">Cover Letter / Motivation Statement (Why are you interested in this role?)*</label>\r\n                                       <textarea placeholder=\"\"></textarea>\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-6\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <label class=\"tp-career-details-input-label\">LinkedIn profile or professional website (optional)</label>\r\n                                       <input type=\"text\" placeholder=\"\">\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-12\">\r\n                                    <div class=\"tp-career-details-input mb-40\">\r\n                                       <label class=\"tp-career-details-input-label\">References (please provide names and contact information for at least one professional reference)*</label>\r\n                                       <textarea placeholder=\"\"></textarea>\r\n                                    </div>\r\n                                 </div>\r\n                                 <div class=\"col-lg-12\">\r\n                                    <div class=\"tp-career-details-input\">\r\n                                       <button class=\"tp-btn theme-bg-color tp-btn-switch-animation\" type=\"submit\">\r\n                                          <span class=\"d-flex align-items-center justify-content-center\">\r\n                                             <span class=\"btn-text\">\r\n                                                Submit your application\r\n                                             </span>\r\n                                             <i class=\"btn-icon\"></i>\r\n                                             <i class=\"btn-icon\"></i>\r\n                                          </span>\r\n                                       </button>\r\n                                    </div>\r\n                                 </div>\r\n                              </div>\r\n                           </form>\r\n                        </div>\r\n                     </div>\r\n                  </div>\r\n               </div>\r\n            </div>\r\n         </div>\r\n         <!-- career details area start -->\r\n\r\n\r\n         <!-- cta area start -->\r\n         <div class=\"tp-fa-cta-ptb\">\r\n            <div class=\"tp-fa-cta-thumb\">\r\n               <img src=\"/assets/img/advisory/cta/thumb.jpg\" alt=\"\">\r\n            </div>\r\n         </div>\r\n         <!-- cta area end -->\r\n         \r\n\r\n      </main>";
const pageScripts2 = "";
const bodyClass = "theme-finances";
---
<BaseLayout pageHeader={pageHeader} pageScripts2={pageScripts2} bodyClass={bodyClass}>
  <Fragment set:html={pageContent} />
</BaseLayout>
