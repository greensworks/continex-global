---
/**
 * KeRolesList — "Roles and career paths": heading + intro, then rows with a
 * small 185×159 picture, role title, paragraph and purple outlined button.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import a from '@assets/images/meeting-table.webp';
import b from '@assets/images/glass-facade.webp';
import c from '@assets/images/abstract-light-streaks.webp';

interface Role { title: string; text: string; cta: string; href?: string; image: ImageMetadata }
interface Props { title?: string; text?: string; roles?: Role[] }
const {
  title = 'Roles and career paths',
  text = 'Whether you’re considering a switch to consulting, an internal role or a specialist path, discover how careers develop at Kearney.',
  roles = [
    { title: 'General consulting', text: 'At Kearney, consultants grow and advance their careers through a clear progression, working across industries and geographies.', cta: 'Explore consulting roles', image: a },
    { title: 'Internal roles', text: 'Working behind the scenes doesn’t mean sitting on the sidelines. Our internal teams keep the firm running and growing.', cta: 'Explore internal roles', image: b },
    { title: 'Specialist roles', text: 'As Kearney evolves, specialists drive our innovation in analytics, digital, design and more.', cta: 'Explore specialist roles', image: c },
  ],
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-16 lg:px-12 lg:py-20">
  <div class="max-w-[742px]">
    <h2 class="font-display text-3xl font-medium text-neutral-900 md:text-[36px]">{title}</h2>
    <p class="mt-4 text-base leading-relaxed text-neutral-800">{text}</p>
  </div>
  <ul class="mt-12 max-w-[760px] space-y-12">
    {roles.map((r) => (
      <li class="grid gap-6 sm:grid-cols-[185px_1fr] sm:gap-8">
        <div class="aspect-[185/159] w-[185px] overflow-hidden bg-neutral-100">
          <Image src={r.image} alt="" width={370} height={318} layout="none" class="h-full w-full object-cover" />
        </div>
        <div>
          <h3 class="text-xl font-semibold text-neutral-900">{r.title}</h3>
          <p class="mt-3 text-base leading-relaxed text-neutral-800">{r.text}</p>
          <a href={r.href ?? '#'} class="mt-5 inline-flex items-center border-2 border-purple-700 px-7 py-2 text-sm font-semibold text-purple-700 transition hover:bg-purple-700 hover:text-white">{r.cta}</a>
        </div>
      </li>
    ))}
  </ul>
</section>
