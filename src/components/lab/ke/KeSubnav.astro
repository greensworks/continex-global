---
/**
 * KeSubnav — section sub-navigation bar: bold section name on the left,
 * menu items on the right, purple chevron; bottom hairline.
 */
interface Props { section?: string; items?: { label: string; href: string }[] }
const { section = 'Careers', items = ['Opportunities', 'Life at Kearney', 'Interviewing', 'Search jobs'].map((l) => ({ label: l, href: '#' })) } = Astro.props;
---
<nav class="border-b border-neutral-300 bg-white" aria-label="Section">
  <details class="group mx-auto max-w-[1512px] px-6 lg:px-12 lg:[&>summary]:pointer-events-none">
    <summary class="flex list-none items-center justify-between py-3 text-[15px] font-semibold text-neutral-900 marker:hidden">
      <a href="#" class="pointer-events-auto">{section}</a>
      <span class="flex items-center gap-8">
        <span class="hidden gap-7 text-[15px] font-normal lg:flex">{items.map((it) => <a href={it.href} class="pointer-events-auto underline-offset-8 hover:underline">{it.label}</a>)}</span>
        <svg class="text-purple-700 transition group-open:rotate-180 lg:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
      </span>
    </summary>
    <div class="flex flex-col gap-2 pb-4 text-[15px] lg:hidden">{items.map((it) => <a href={it.href} class="py-1">{it.label}</a>)}</div>
  </details>
</nav>
