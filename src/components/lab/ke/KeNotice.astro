---
/**
 * KeNotice — plain text notice under a hairline: bold lead, subtitle,
 * bullet list and closing line (recruitment phishing warning).
 */
interface Props { lead?: string; subtitle?: string; intro?: string; bullets?: string[]; outro?: string }
const {
  lead = 'Warning: recruitment phishing. It has come to our attention that individuals are contacting candidates while falsely claiming to represent Kearney.',
  subtitle = 'What to look out for',
  intro = 'Our candidates’ security and interview experiences are important to us. Be cautious if:',
  bullets = [
    'You’re contacted about a position that is not listed on our jobs board.',
    'You’re asked to conduct an interview via Skype or a chat application.',
    'You’re contacted by an email address that does not end in @kearney.com.',
    'You receive a request for money or bank information.',
  ],
  outro = 'Kearney team members will never ask any candidate for money or bank details during the recruitment process.',
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-12 lg:px-12">
  <hr class="max-w-[1000px] border-neutral-300" />
  <div class="mt-10 max-w-[1000px] text-base leading-relaxed text-neutral-800">
    <p class="font-semibold">{lead}</p>
    <p class="mt-6 text-lg font-semibold text-neutral-900">{subtitle}</p>
    <p class="mt-2">{intro}</p>
    <ul class="mt-3 list-disc space-y-1 pl-6">{bullets.map((b) => <li>{b}</li>)}</ul>
    <p class="mt-6">{outro}</p>
  </div>
</section>
