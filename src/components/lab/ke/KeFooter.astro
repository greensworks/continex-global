---
/**
 * KeFooter — dark footer with a raised CTA card overlapping the top edge
 * (jobs-board line + outlined button), link row, social icons, legal links.
 */
interface Props { ctaText?: string; cta?: { label: string; href: string }; links?: { label: string; href: string }[]; legal?: { label: string; href: string }[]; privacyLink?: string }
const {
  ctaText = 'Check out our global jobs board to explore our open positions.',
  cta = { label: 'Search open roles', href: '#' },
  links = ['Insights', 'Media', 'Alumni', 'Careers', 'Locations', 'Contact'].map((l) => ({ label: l, href: '#' })),
  legal = ['Site map', 'Privacy policy', 'Legal disclaimer', 'Client Confidentiality', 'Cookie notice'].map((l) => ({ label: l, href: '#' })),
  privacyLink = 'Do Not Sell or Share My Personal Information',
} = Astro.props;
const social = ['LinkedIn', 'X', 'Facebook', 'Instagram', 'YouTube'];
---
<footer class="relative mt-16 bg-neutral-900 text-white">
  <div class="mx-auto max-w-[1512px] px-6 lg:px-12">
    <div class="-translate-y-1/2 flex flex-col items-start gap-5 bg-neutral-100 px-8 py-8 text-neutral-900 md:flex-row md:items-center md:justify-between md:px-12">
      <p class="max-w-[561px] text-xl font-medium leading-snug">{ctaText}</p>
      <a href={cta.href} class="inline-flex shrink-0 items-center border-2 border-purple-700 px-7 py-2 text-sm font-semibold text-purple-700 transition hover:bg-purple-700 hover:text-white">{cta.label}</a>
    </div>
    <div class="grid gap-10 pb-12 md:grid-cols-2">
      <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm" aria-label="Footer">{links.map((l) => <a href={l.href} class="hover:underline">{l.label}</a>)}</nav>
      <div class="flex gap-4 md:justify-end">
        {social.map((s) => <a href="#" aria-label={s} class="grid h-[25px] w-[25px] place-items-center rounded-full bg-white/15 text-[10px] font-bold uppercase">{s[0]}</a>)}
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[11px] text-white/70">{legal.map((l) => <li><a href={l.href} class="hover:underline">{l.label}</a></li>)}</ul>
      <p class="text-[11px] text-white/70 md:text-right"><a href="#" class="hover:underline">{privacyLink}</a></p>
    </div>
  </div>
</footer>
