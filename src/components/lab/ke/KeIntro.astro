---
/**
 * KeIntro — long paragraph on the left, small label + purple outlined button
 * on the right ("Start your journey / Search jobs"). `sideTitle` variant
 * renders the jobs-page note ("Check out our global jobs board…").
 */
interface Props { text?: string; sideLabel?: string; cta?: { label: string; href: string } }
const {
  text = 'As one of the original management consulting firms, Kearney has never forgotten that this is a people business. Over the course of nearly a century, we have built a firm that is empowered by Kearney Originals who are as unique as you are. Our firm is big enough to make a real impact globally yet small enough to keep our people connected.',
  sideLabel = 'Start your journey',
  cta = { label: 'Search jobs', href: '#' },
} = Astro.props;
---
<section class="mx-auto grid max-w-[1512px] gap-10 px-6 py-14 lg:grid-cols-[657px_1fr] lg:gap-24 lg:px-12 lg:py-16">
  <p class="text-base leading-relaxed text-neutral-800 md:text-[17px]">{text}</p>
  <div class="lg:pl-16">
    <p class="text-[17px] font-semibold text-neutral-900">{sideLabel}</p>
    <a href={cta.href} class="mt-4 inline-flex items-center border-2 border-purple-700 px-7 py-2 text-sm font-semibold text-purple-700 transition hover:bg-purple-700 hover:text-white">{cta.label}</a>
  </div>
</section>
