---
/**
 * KeJobsIntro — paragraph on the left, boxed side note with heading and
 * purple button on the right (jobs page, under the hero).
 */
interface Props { text?: string; sideTitle?: string; cta?: { label: string; href: string } }
const {
  text = 'Whether you’re a student or recent graduate seeking your first role, an experienced professional ready for the next challenge, or a specialist looking to bring your expertise to consulting, you will find a path at Kearney.',
  sideTitle = 'Check out our global jobs board to explore our open positions.',
  cta = { label: 'Search jobs', href: '#' },
} = Astro.props;
---
<section class="mx-auto grid max-w-[1512px] gap-10 px-6 py-14 lg:grid-cols-[658px_1fr] lg:gap-24 lg:px-12">
  <p class="text-base leading-relaxed text-neutral-800 md:text-[17px]">{text}</p>
  <div class="max-w-[300px] border-l-4 border-purple-700 pl-6">
    <p class="text-[17px] font-semibold leading-snug text-neutral-900">{sideTitle}</p>
    <a href={cta.href} class="mt-5 inline-flex items-center border-2 border-purple-700 px-7 py-2 text-sm font-semibold text-purple-700 transition hover:bg-purple-700 hover:text-white">{cta.label}</a>
  </div>
</section>
