---
/**
 * KeFeatureRow — alternating text/illustration rows (503px): title +
 * paragraph + purple outlined "Learn more" on one side, 485×405 image on
 * the other. `imageSide` flips it. Covers "Opportunities at Kearney",
 * "Life at Kearney", "How we work", "Interviewing", "Students and recent
 * graduates", "Recruiting events", "Experienced professionals".
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultImg from '@assets/images/woman-tablet.webp';

interface Props { title?: string; eyebrow?: string; text?: string; cta?: { label: string; href: string }; image?: ImageMetadata; imageSide?: 'left' | 'right' }
const {
  title = 'Opportunities at Kearney',
  eyebrow,
  text = 'We know there’s no one-size-fits-all career path. Whether you are a student, a graduate or an experienced professional, we will help you find where you fit.',
  cta = { label: 'Explore opportunities', href: '#' },
  image = defaultImg,
  imageSide = 'right',
} = Astro.props;
---
<section class="mx-auto grid max-w-[1512px] items-center gap-10 px-6 py-12 lg:min-h-[503px] lg:grid-cols-2 lg:gap-24 lg:px-12">
  <div class:list={['max-w-[400px]', imageSide === 'left' && 'lg:order-2']}>
    {eyebrow && <p class="text-sm font-semibold uppercase tracking-wide text-purple-700">{eyebrow}</p>}
    <h2 class="font-display text-3xl font-medium leading-tight text-neutral-900 md:text-[36px] md:leading-[42px]">{title}</h2>
    <p class="mt-5 text-base leading-relaxed text-neutral-800">{text}</p>
    {cta && <a href={cta.href} class="mt-7 inline-flex items-center border-2 border-purple-700 px-7 py-2 text-sm font-semibold text-purple-700 transition hover:bg-purple-700 hover:text-white">{cta.label}</a>}
  </div>
  <div class:list={['mx-auto w-full max-w-[485px]', imageSide === 'left' && 'lg:order-1']}>
    <div class="aspect-[485/405] overflow-hidden bg-neutral-100">
      <Image src={image} alt="" widths={[485, 970]} sizes="(min-width: 1024px) 485px, 100vw" layout="none" class="h-full w-full object-cover" />
    </div>
  </div>
</section>
