---
/**
 * KeArticleGrid — "Also of interest": 3-column article cards (image, tag,
 * title, excerpt), rows separated by hairlines, plus a "View all" button.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import a from '@assets/images/portrait-woman-blue.webp';
import b from '@assets/images/meeting-table.webp';
import c from '@assets/images/woman-tablet.webp';
import d from '@assets/images/portrait-woman-phone.webp';
import e from '@assets/images/glass-facade.webp';
import f from '@assets/images/abstract-liquid.webp';

interface Article { tag: string; title: string; text: string; image: ImageMetadata; href?: string }
interface Props { title?: string; articles?: Article[]; cta?: { label: string; href: string } }
const {
  title = 'Also of interest',
  articles = [
    { tag: 'Article', title: 'Empowering Kearney women through the AdviseHer mentoring program', text: 'How the Kearney Women’s Network is creating a supportive community.', image: a },
    { tag: 'Article', title: 'Empowering mental health and well-being in MEA', text: 'Highlights from a journey aiming to create a healthier workplace.', image: b },
    { tag: 'Article', title: 'What does a Digital and Analytics consultant do?', text: 'Americas Manager Alfredo Vetencourt talks about being a D&A consultant.', image: c },
    { tag: 'Article', title: 'My Kearney experience: Christiana Udoh', text: 'A personal story from our London office.', image: d },
    { tag: 'Article', title: 'Championing mental health at Kearney', text: 'Our mental health ambassadors foster a culture of openness.', image: e },
    { tag: 'Article', title: 'The Kearney Games', text: 'From local initiative to global award-winning event.', image: f },
  ],
  cta = { label: 'View all articles', href: '#' },
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-16 lg:px-12 lg:py-20">
  <h2 class="font-display text-3xl font-medium text-neutral-900 md:text-[36px]">{title}</h2>
  <div class="mt-10 grid gap-x-8 gap-y-12 md:grid-cols-3">
    {articles.map((ar, i) => (
      <a href={ar.href ?? '#'} class:list={['group block', i >= 3 && 'md:border-t md:border-neutral-300 md:pt-10']}>
        <div class="aspect-[16/10] overflow-hidden bg-neutral-100">
          <Image src={ar.image} alt="" widths={[480, 768]} sizes="(min-width: 768px) 33vw, 100vw" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
        </div>
        <p class="mt-5 text-sm text-neutral-600">{ar.tag}</p>
        <h3 class="mt-2 text-xl font-medium leading-snug text-neutral-900 group-hover:underline">{ar.title}</h3>
        <p class="mt-2 text-base leading-relaxed text-neutral-700">{ar.text}</p>
      </a>
    ))}
  </div>
  {cta && <div class="mt-14 text-center"><a href={cta.href} class="inline-flex items-center border-2 border-purple-700 px-7 py-2 text-sm font-semibold text-purple-700 transition hover:bg-purple-700 hover:text-white">{cta.label}</a></div>}
</section>
