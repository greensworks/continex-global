---
/**
 * KeHeader — Kearney header: wordmark with accent suffix ("KEARNEY 100"),
 * right-aligned links, search icon and burger.
 */
interface Props { brand?: string; suffix?: string; links?: { label: string; href: string; active?: boolean }[] }
const {
  brand = 'KEARNEY', suffix = '100',
  links = [
    { label: 'Your industry', href: '#' }, { label: 'Your needs', href: '#' }, { label: 'About us', href: '#' },
    { label: 'Careers', href: '#', active: true }, { label: 'Insights', href: '#' }, { label: 'Contact', href: '#' },
  ],
} = Astro.props;
---
<header class="bg-white text-neutral-900">
  <div class="mx-auto flex h-[101px] max-w-[1512px] items-center justify-between px-6 lg:px-12">
    <a href="#" class="font-display text-[22px] font-bold tracking-[0.18em]">{brand} <span class="text-purple-700">{suffix}</span></a>
    <div class="flex items-center gap-6">
      <nav class="hidden items-center gap-7 text-[15px] lg:flex" aria-label="Main">
        {links.map((l) => <a href={l.href} class:list={['py-2 underline-offset-8 hover:underline', l.active && 'underline']}>{l.label}</a>)}
      </nav>
      <button type="button" aria-label="Search" class="grid h-8 w-8 place-items-center"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
      <button type="button" aria-label="Menu" class="grid h-8 w-8 place-items-center"><span class="block h-0.5 w-5 bg-current shadow-[0_5px_0_0_currentColor,0_-5px_0_0_currentColor]"></span></button>
    </div>
  </div>
</header>
