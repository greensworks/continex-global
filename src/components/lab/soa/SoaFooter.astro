---
/**
 * SoaFooter — logo + tagline + contact lines + ISO badge on the left, four
 * link columns on the right, copyright and "Follow us!" at the bottom.
 */
interface Group { title: string; items: string[] }
interface Props { tagline?: string; email?: string; addresses?: string[]; badge?: string; groups?: Group[]; copyright?: string }
const {
  tagline = 'Here to get you There',
  email = 'hello@sourceofasia.com',
  addresses = ['The Galleria Metro 6 Office Tower, 59 Vo Nguyen Giap, Ho Chi Minh City, Vietnam.', '83 avenue Denfert Rochereau, 75014 Paris, France.'],
  badge = 'ISO 27001:2022 Certified',
  groups = [
    { title: 'Service', items: ['Market Expansion', 'Sourcing & Supply Chain', 'Corporate Services and HR Solutions', 'Vietnamese Venture Abroad', 'Trade Missions'] },
    { title: 'Information', items: ['Case Studies', 'Insights & News'] },
    { title: 'About', items: ['Who we are', 'Careers', 'Contact'] },
    { title: 'Support', items: ['Privacy Policy', 'Terms & Conditions'] },
  ],
  copyright = '© 2026 Source of Asia. All rights reserved.',
} = Astro.props;
---
<footer class="bg-neutral-900 text-white/85">
  <div class="mx-auto grid max-w-[1170px] gap-12 px-6 py-16 lg:grid-cols-[565px_1fr] lg:px-0">
    <div>
      <a href="#" class="flex items-center gap-2 font-display text-xl font-bold text-white"><span class="grid h-10 w-10 place-items-center rounded-full bg-teal-500 text-white">S</span>Source of Asia</a>
      <p class="mt-5 text-lg font-semibold text-white">{tagline}</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li class="flex gap-2"><span aria-hidden="true">✉</span><a href={`mailto:${email}`} class="hover:underline">{email}</a></li>
        {addresses.map((a) => <li class="flex gap-2"><span aria-hidden="true">⌂</span>{a}</li>)}
      </ul>
      <div class="mt-8 grid h-[150px] w-[150px] place-items-center rounded-full border-2 border-teal-500 text-center text-xs font-semibold leading-tight text-white">{badge}</div>
    </div>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {groups.map((g) => (
        <div>
          <p class="text-base font-semibold text-white">{g.title}</p>
          <ul class="mt-4 space-y-2 text-sm">{g.items.map((it) => <li><a href="#" class="hover:underline">{it}</a></li>)}</ul>
        </div>
      ))}
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-[1170px] flex-col gap-4 px-6 py-6 text-sm sm:flex-row sm:items-center sm:justify-between lg:px-0">
      <p>{copyright}</p>
      <div class="flex items-center gap-4"><span class="font-semibold text-white">Follow us!</span>{['in', 'f'].map((s) => <a href="#" class="grid h-6 w-6 place-items-center rounded bg-white/15 text-xs font-bold text-white">{s}</a>)}</div>
    </div>
  </div>
</footer>
