---
/**
 * SoaPageHeader — tinted page header (517px): wave divider on top, eyebrow,
 * H1, breadcrumb and an intro paragraph aligned right.
 */
interface Props { eyebrow?: string; title?: string; breadcrumb?: string[]; text?: string }
const {
  eyebrow = 'DOING BUSINESS IN ASIA',
  title = 'Insights & News',
  breadcrumb = ['Home', 'Insights & News'],
  text = 'As Asia continues to shape global trade, investment and sourcing, our insights help decision-makers understand the markets, rules and partners that matter.',
} = Astro.props;
---
<section class="relative bg-teal-50 text-neutral-900">
  <svg class="block h-[30px] w-full text-white" viewBox="0 0 1512 30" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 0h1512v10c-250 20-500 20-756 0S250 -10 0 10z"/></svg>
  <div class="mx-auto grid max-w-[1170px] gap-10 px-6 pb-20 pt-10 lg:grid-cols-2 lg:px-0">
    <div>
      <p class="text-sm font-semibold tracking-[0.18em] text-teal-700">{eyebrow}</p>
      <h1 class="mt-4 font-display text-5xl font-semibold md:text-[60px]">{title}</h1>
      <nav class="mt-6 flex gap-2 text-sm text-neutral-600" aria-label="Breadcrumb">{breadcrumb.map((b, i) => <span class="flex gap-2">{i > 0 && <span>-</span>}{b}</span>)}</nav>
    </div>
    <p class="max-w-[580px] self-end text-lg leading-relaxed text-neutral-700 lg:justify-self-end">{text}</p>
  </div>
</section>
