---
/**
 * SoaCtaBanner — 500px photo band with a large statement and a filled
 * button ("Talk to an expert at SOA").
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultImg from '@assets/images/meeting-table.webp';

interface Props { image?: ImageMetadata; title?: string; cta?: { label: string; href: string } }
const { image = defaultImg, title = 'We can address an incredibly wide range of unexpected challenges when doing business in Asia.', cta = { label: 'Talk to an expert at SOA', href: '#' } } = Astro.props;
---
<section class="relative isolate flex min-h-[500px] items-center overflow-hidden bg-neutral-900 text-white">
  <Image src={image} alt="" widths={[768, 1280, 1920]} sizes="100vw" layout="none" class="absolute inset-0 -z-10 h-full w-full object-cover" />
  <div class="absolute inset-0 -z-10 bg-teal-950/70" aria-hidden="true"></div>
  <div class="mx-auto w-full max-w-[1170px] px-6 py-20 lg:px-0">
    <h2 class="max-w-[1030px] font-display text-3xl font-semibold leading-tight text-white md:text-[48px] md:leading-[60px]">{title}</h2>
    <a href={cta.href} class="mt-8 inline-flex bg-white px-8 py-4 text-base font-semibold text-teal-800 transition hover:bg-teal-100">{cta.label}</a>
  </div>
</section>
