---
/**
 * SoaNav — Source of Asia navigation: thin utility bar (language, "Other
 * Services", "Who we are", "Careers"), then logo, service links and a
 * filled "Contact us" button.
 */
interface Props { utility?: { label: string; href: string }[]; links?: { label: string; href: string }[]; cta?: { label: string; href: string } }
const {
  utility = [{ label: 'Other Services', href: '#' }, { label: 'Who we are', href: '#' }, { label: 'Careers', href: '#' }],
  links = ['Market Expansion', 'Sourcing & Supply Chain', 'Corporate Services and HR Solutions', 'Case Studies', 'Insights & News'].map((l) => ({ label: l, href: '#' })),
  cta = { label: 'Contact us', href: '#' },
} = Astro.props;
---
<header class="bg-white text-neutral-900">
  <div class="border-b border-neutral-200">
    <div class="mx-auto flex max-w-[1170px] items-center justify-between px-6 py-2 text-[13px] lg:px-0">
      <button type="button" class="inline-flex items-center gap-1.5"><span class="inline-block h-3.5 w-5 rounded-sm bg-[linear-gradient(#012169_0_33%,#fff_33%_66%,#c8102e_66%)]" aria-hidden="true"></span>EN <span class="text-[9px]">▼</span></button>
      <nav class="flex gap-6">{utility.map((u) => <a href={u.href} class="hover:underline">{u.label}</a>)}</nav>
    </div>
  </div>
  <div class="mx-auto flex h-[70px] max-w-[1170px] items-center justify-between px-6 lg:px-0">
    <a href="#" class="flex items-center gap-2 font-display text-lg font-bold"><span class="grid h-9 w-9 place-items-center rounded-full bg-teal-700 text-white">S</span>Source of Asia</a>
    <nav class="hidden items-center gap-6 text-[15px] lg:flex" aria-label="Main">{links.map((l) => <a href={l.href} class="underline-offset-8 hover:underline">{l.label}</a>)}</nav>
    <a href={cta.href} class="hidden bg-teal-700 px-6 py-3 text-sm font-semibold text-white transition hover:bg-teal-800 md:inline-flex">{cta.label}</a>
  </div>
</header>
