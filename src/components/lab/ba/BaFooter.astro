---
/** BaFooter — black footer: subscribe row (text, e-mail, consent, red button), logo + social icons, legal links, copyright. */
interface Props { brand?: string; subscribeText?: string; links?: string[]; copyright?: string; accent?: string }
const { brand = 'BAIN & COMPANY', subscribeText = 'Stay ahead in a rapidly changing world. Subscribe to Bain Insights, our monthly look at the critical issues facing global businesses.', links = ['Contact us', 'Sustainability', 'Accessibility', 'Terms of use', 'Privacy', 'Modern Slavery Act Statement', 'Cookie Policy', 'Sitemap', 'Log In'], copyright = '© 1996-2026 Bain & Company, Inc.', accent = '#CC0000' } = Astro.props;
---
<footer class="bg-black text-white">
  <div class="mx-auto max-w-[1360px] px-5 pt-12 lg:px-10">
    <div class="grid gap-8 border-b border-white/10 pb-6 md:grid-cols-[1fr_560px]">
      <p class="max-w-[684px] text-[21px] leading-9">{subscribeText}</p>
      <form class="flex flex-wrap items-start gap-4" action="#">
        <div class="min-w-[260px] flex-1">
          <input type="email" placeholder="Your email address" class="h-14 w-full bg-[#424242] px-4 text-[18px] text-white outline-none placeholder:text-white/80" />
          <label class="mt-3 flex items-center gap-3 text-[16px]"><input type="checkbox" class="h-5 w-5" /> *I have read and understand <a href="#" class="border-b" style={`border-color:${accent}`}>the Privacy Notice</a>.</label>
        </div>
        <button type="submit" class="px-8 py-5 text-[14px] uppercase" style={`background:${accent}`}>Subscribe</button>
      </form>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-6 py-10">
      <span class="font-display text-[15px] font-bold tracking-[0.22em]">{brand}</span>
      <ul class="flex gap-5 text-[#D8D8D8]">{['in', 'X', 'f', '▶', '◎'].map((s) => <li><a href="#" class="text-sm hover:text-white">{s}</a></li>)}</ul>
    </div>
    <ul class="flex flex-wrap gap-x-7 gap-y-2 text-[16px]">{links.map((l) => <li><a href="#" class="hover:underline">{l}</a></li>)}</ul>
    <p class="py-8 text-[16px] opacity-50">{copyright}</p>
  </div>
</footer>
