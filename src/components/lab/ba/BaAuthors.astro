---
/** BaAuthors — left sidebar: "Authors" heading, 90px portraits with red underline, name, role, LinkedIn icon, outlined "Contact us". */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import p1 from '@assets/images/portrait-woman-blue.webp';
import p2 from '@assets/images/portrait-woman-phone.webp';
import p3 from '@assets/images/woman-tablet.webp';

interface Author { name: string; role: string; image: ImageMetadata; href?: string }
interface Props { title?: string; authors?: Author[]; cta?: { label: string; href: string }; accent?: string }
const { title = 'Authors', authors = [{ name: 'Dale Stafford', role: 'Partner, New York', image: p1 }, { name: 'Kai Grass', role: 'Partner, Dusseldorf', image: p2 }, { name: 'Suzanne Kumar', role: 'Practice Executive Vice President, New York', image: p3 }], cta = { label: 'Contact us', href: '#' }, accent = '#CC0000' } = Astro.props;
---
<aside class="w-[180px]">
  <h2 class="border-t border-[#D8D8D8] pt-4 font-display text-[15px] text-black">{title}</h2>
  <ul>
    {authors.map((a) => (
      <li class="border-b border-[#D8D8D8] py-4">
        <a href={a.href ?? '#'} class="block h-[90px] w-[90px] overflow-hidden border-b" style={`border-color:${accent}`}><Image src={a.image} alt={a.name} width={180} height={180} layout="none" class="h-full w-full object-cover" /></a>
        <p class="mt-3 text-[15px] text-black">{a.name}</p>
        <p class="text-[15px] leading-[22px] text-[#767676]">{a.role}</p>
        <a href="#" aria-label={`${a.name} on LinkedIn`} class="mt-1 inline-block text-[#D8D8D8] hover:text-black"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6.5 8.5v9M6.5 5.5v.01M10.5 17.5v-5a2.5 2.5 0 0 1 5 0v5M10.5 8.5v9"/></svg></a>
      </li>
    ))}
  </ul>
  <a href={cta.href} class="mt-6 block border border-[#D8D8D8] py-5 text-center text-[14px] uppercase transition hover:border-current" style={`color:${accent}`}>{cta.label}</a>
</aside>
