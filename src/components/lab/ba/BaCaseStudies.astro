---
/** BaCaseStudies — "How We've Helped Clients": three tall red panels with white titles and "Read case study" link. */
interface Card { tag?: string; title: string; href?: string }
interface Props { title?: string; cards?: Card[]; accent?: string; linkLabel?: string }
const { title = 'How We’ve Helped Clients', cards = [{ tag: 'Digital', title: 'Reimagining Insurance for the AI Era' }, { title: 'A Beauty Company Enables Always-On Brand Acceleration' }, { title: 'Aggressively growing an IT service provider with a high-performance culture' }], accent = '#CC0000', linkLabel = 'Read case study' } = Astro.props;
---
<section class="mx-auto max-w-[1360px] px-5 pt-[72px] lg:px-10">
  <h2 class="border-t border-[#D8D8D8] pt-8 font-display text-[32px] leading-[44px] text-black">{title}</h2>
  <div class="mt-6 grid text-white md:grid-cols-3" style={`background:${accent}`}>
    {cards.map((c, i) => (
      <a href={c.href ?? '#'} class:list={['group flex min-h-[400px] flex-col justify-between px-10 py-12', i > 0 && 'md:border-l md:border-black/40']}>
        <div>{c.tag && <p class="mb-2 text-[18px] leading-[26px]">{c.tag}</p>}<h3 class="font-display text-[32px] leading-[43px] text-white">{c.title}</h3></div>
        <span class="text-[14px] group-hover:underline">{linkLabel} →</span>
      </a>
    ))}
  </div>
</section>
