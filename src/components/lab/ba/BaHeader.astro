---
/** BaHeader — Bain-style 72px header: red wordmark, primary nav with red caret toggles, search + bookmark. */
interface Props { brand?: string; nav?: { label: string; href: string; menu?: boolean }[] }
const { brand = 'BAIN & COMPANY', nav = [
  { label: 'Industries', href: '#', menu: true }, { label: 'Consulting Services', href: '#', menu: true }, { label: 'Digital', href: '#' },
  { label: 'Insights', href: '#', menu: true }, { label: 'About', href: '#', menu: true }, { label: 'Careers', href: '#' },
] } = Astro.props;
---
<header class="border-b border-[#D8D8D8] bg-white text-[#333]">
  <div class="mx-auto flex h-[72px] max-w-[1360px] items-center justify-between px-6 lg:px-10">
    <a href="#" class="font-display text-[15px] font-bold tracking-[0.22em] text-[#CB2026]">{brand}</a>
    <nav class="hidden items-center lg:flex" aria-label="Primary">
      {nav.map((n) => <a href={n.href} class="inline-flex items-center gap-2 px-4 py-6 text-sm tracking-[0.5px] hover:text-black">{n.label}{n.menu && <span class="text-[10px] text-[#CC0000]" aria-hidden="true">▼</span>}</a>)}
    </nav>
    <div class="flex items-center gap-4 text-[#979797]">
      <button type="button" aria-label="Search"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
      <span class="h-5 w-px bg-[#D8D8D8]"></span>
      <button type="button" aria-label="Saved"><svg width="16" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3h12v18l-6-4-6 4z"/></svg></button>
    </div>
  </div>
</header>
