---
/**
 * BaArticleHero — 540px image band with a white card overlapping its lower
 * edge: red "Brief" label, 60px title, subtitle, byline, date · read time,
 * and round outlined share icons on the right.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultImg from '@assets/images/abstract-light-streaks.webp';

interface Props { image?: ImageMetadata; label?: string; title?: string; subtitle?: string; byline?: string; date?: string; readTime?: string; accent?: string }
const { image = defaultImg, label = 'Brief', title = 'M&A Midyear Outlook 2026: A Winner’s Paradox', subtitle = 'New challenge: Can companies pair an ambitious M&A agenda with AI disruption?', byline = 'By Dale Stafford, Kai Grass, and Suzanne Kumar', date = 'Published on June 29, 2026', readTime = '9 min read', accent = '#CC0000' } = Astro.props;
const icons = ['share', 'link', 'print', 'bookmark'];
---
<section class="bg-[#FEFEFE]">
  <div class="h-[320px] w-full overflow-hidden md:h-[540px]"><Image src={image} alt="" widths={[768, 1512]} sizes="100vw" layout="none" class="h-full w-full object-cover" /></div>
  <div class="mx-auto max-w-[1360px] px-5 lg:px-10">
    <div class="relative -mt-24 max-w-[990px] bg-white px-5 pt-12 md:-mt-40 md:px-12">
      <p class="text-[18px]" style={`color:${accent}`}>{label}</p>
      <h1 class="mt-4 max-w-[910px] font-display text-4xl font-normal leading-[1.07] text-black md:text-[60px]">{title}</h1>
      <p class="mt-6 max-w-[779px] text-[21px] leading-[30px] text-black">{subtitle}</p>
      <p class="mt-3 text-[15px] leading-[26px] text-[#767676]">{byline}</p>
      <p class="mt-1 text-[15px] leading-[26px] text-[#767676]">{date} <span class="mx-2">•</span> {readTime}</p>
      <ul class="mt-6 flex gap-3 md:absolute md:right-0 md:top-12 md:mt-0 md:translate-x-[calc(100%+24px)]">
        {icons.map((i) => <li><button type="button" aria-label={i} class="grid h-12 w-12 place-items-center rounded-full border border-[#D8D8D8] text-[#767676] transition hover:border-black hover:text-black"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{i === 'share' ? <path d="M4 12v8h16v-8M12 4v12m-4-8 4-4 4 4"/> : i === 'link' ? <path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/> : i === 'print' ? <path d="M6 9V3h12v6M6 18H4V9h16v9h-2M6 14h12v7H6z"/> : <path d="M6 3h12v18l-6-4-6 4z"/>}</svg></button></li>)}
      </ul>
    </div>
  </div>
</section>
