---
/** BaReadyToTalk — bordered box: "Ready to talk?" + big select-style prompt on the left, paragraph, e-mail input and red CONTACT US on the right. */
interface Props { title?: string; prompt?: string; placeholder?: string; text?: string; cta?: string; accent?: string; options?: string[] }
const { title = 'Ready to talk?', prompt = 'I want to talk to your experts in:', placeholder = 'Select an industry', text = 'We work with ambitious leaders who want to define the future, not hide from it. Together, we achieve extraordinary outcomes.', cta = 'Contact us', accent = '#CC0000', options = ['Energy', 'Industrial', 'Automotive', 'Infrastructure'] } = Astro.props;
---
<section class="mx-auto max-w-[1360px] px-5 pt-[72px] lg:px-10">
  <form class="grid gap-10 border border-[#D8D8D8] px-8 py-10 md:grid-cols-2 md:px-12" action="#">
    <div>
      <h2 class="font-display text-[32px] leading-[44px] text-black">{title}</h2>
      <label class="mt-12 block max-w-[490px]"><span class="block font-display text-[32px] leading-[46px] text-black">{prompt}</span>
        <select class="mt-2 w-full appearance-none border-b bg-transparent py-1 font-display text-[32px] leading-[46px] text-black outline-none" style={`border-color:${accent}`}><option>{placeholder}</option>{options.map((o) => <option>{o}</option>)}</select>
      </label>
    </div>
    <div>
      <p class="text-[18px] leading-[26px] text-[#424242]">{text}</p>
      <input type="email" placeholder="Your email" class="mt-8 h-14 w-full border border-black bg-[#F9F9F9] px-4 text-[18px] shadow-[inset_0_1px_2px_rgba(10,10,10,0.1)] outline-none" />
      <button type="submit" class="mt-6 px-8 py-5 text-[14px] uppercase text-white" style={`background:${accent}`}>{cta}</button>
    </div>
  </form>
</section>
