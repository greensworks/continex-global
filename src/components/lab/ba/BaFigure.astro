---
/** BaFigure — chart block: 3px grey top rule, red "Figure N" tag, 24px caption, chart area, notes + source. */
interface Props { number?: number; caption?: string; notes?: string; source?: string; height?: number; accent?: string }
const { number = 1, caption = 'Global M&A market is on track for the second year of the great rebound', notes = 'Notes: Strategic M&A includes corporate M&A and private equity add-ons; year-to-date data through June.', source = 'Source: Dealogic', height = 420, accent = '#CC0000' } = Astro.props;
---
<figure class="mx-auto max-w-[700px] border-b border-[#D8D8D8] border-t-[3px] border-t-[#D8D8D8] px-1 pt-4">
  <p class="text-[13px] leading-[22px]" style={`color:${accent}`}>Figure {number}</p>
  <figcaption class="mt-2 font-display text-[24px] leading-[32px] text-black">{caption}</figcaption>
  <div class="mt-4 border-t border-[#D8D8D8] pt-4">
    <div class="w-full bg-[#EEEEEE]" style={`height:${height}px`}><slot /></div>
    <p class="mt-4 text-[12px] leading-4 text-[#757575]">{notes}</p>
    <p class="mb-6 mt-3 text-[12px] leading-4 text-[#757575]">{source}</p>
  </div>
</figure>
