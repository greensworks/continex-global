---
/**
 * BcgNewsList — dated press headlines: "date | outlet" overline, headline
 * with an arrow link, and a one-line description, in a two-column grid.
 */
interface Item { date: string; outlet: string; title: string; text: string; href?: string }
interface Props { items?: Item[] }
const {
  items = [
    { date: 'June 26, 2026', outlet: 'Business Insider', title: 'Workers with this mindset are thriving in the AI era', text: 'BCG’s North America leader of people and organization on the traits that matter most.' },
    { date: 'May 28, 2026', outlet: 'The Wall Street Journal', title: 'AI is changing how consultants get paid, and much more', text: 'For all the doomsday predictions that AI will make consultants obsolete, the reality is more nuanced.' },
    { date: 'May 4, 2026', outlet: 'Business Insider', title: 'Most CEOs say boards are too trigger-happy on AI transformation', text: 'CEOs and their boards aren’t on the same page about AI, a new BCG survey finds.' },
    { date: 'January 16, 2026', outlet: 'Bloomberg TV', title: 'Spending on AI stays up even if returns slip', text: '60% of CEOs are confident AI will pay off, and 94% plan to keep investing.' },
  ],
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-10 lg:px-20">
  <div class="grid gap-x-16 gap-y-12 md:grid-cols-2">
    {items.map((it) => (
      <article class="max-w-[604px]">
        <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-neutral-600">{it.date} | {it.outlet}</p>
        <a href={it.href ?? '#'} class="group mt-3 flex items-start justify-between gap-6">
          <h3 class="font-display text-2xl font-medium leading-snug text-neutral-900 group-hover:underline md:text-[32px] md:leading-[44px]">{it.title}</h3>
          <span class="mt-2 grid h-12 w-12 shrink-0 place-items-center rounded-full border border-neutral-900 text-neutral-900 transition group-hover:bg-neutral-900 group-hover:text-white" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M9 7h8v8"/></svg></span>
        </a>
        <p class="mt-3 text-lg leading-relaxed text-neutral-700">{it.text}</p>
      </article>
    ))}
  </div>
</section>
