---
/**
 * BcgCardCarousel — horizontally scrolling card row (scroll-snap) with a
 * small overline, used for client work, insights and products carousels.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import a from '@assets/images/refinery-dusk.webp';
import b from '@assets/images/metal-grinding-sparks.webp';
import c from '@assets/images/storage-tanks-night.webp';
import d from '@assets/images/glass-facade.webp';
import e from '@assets/images/grain-silos-dusk.webp';

interface Card { tag: string; title: string; image: ImageMetadata; href?: string }
interface Props { overline?: string; cards?: Card[] }
const {
  overline = 'Explore More of our AI Transformation Client Work',
  cards = [
    { tag: 'Case study', title: 'A global energy company cuts forecasting error by 40% with AI', image: a },
    { tag: 'Case study', title: 'Reinventing procurement at an industrial manufacturer', image: b },
    { tag: 'Case study', title: 'GenAI copilots for a leading chemicals player', image: c },
    { tag: 'Case study', title: 'An AI-first operating model for a real estate group', image: d },
    { tag: 'Case study', title: 'Agri-food supply chain optimization with AI', image: e },
  ],
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-10 lg:px-20">
  {overline && <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-neutral-700">{overline}</p>}
  <div class="mt-6 -mx-6 flex snap-x snap-mandatory gap-6 overflow-x-auto px-6 pb-4 [scrollbar-width:thin] lg:mx-0 lg:px-0">
    {cards.map((cd) => (
      <a href={cd.href ?? '#'} class="group w-[300px] shrink-0 snap-start md:w-[400px]">
        <div class="aspect-[400/250] overflow-hidden bg-neutral-100">
          <Image src={cd.image} alt="" widths={[400, 800]} sizes="400px" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
        </div>
        <p class="mt-4 text-[11px] font-bold uppercase tracking-[0.14em] text-emerald-700">{cd.tag}</p>
        <h3 class="mt-2 text-xl font-medium leading-snug text-neutral-900 group-hover:underline">{cd.title}</h3>
      </a>
    ))}
  </div>
</section>
