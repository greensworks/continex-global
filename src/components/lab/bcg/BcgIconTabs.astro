---
/**
 * BcgIconTabs — three (or more) cards in a row: 120px round illustration
 * above a short label; the active card gets a green underline.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import a from '@assets/images/metal-grinding-sparks.webp';
import b from '@assets/images/industrial-pipes-red.webp';
import c from '@assets/images/abstract-light-streaks.webp';

interface Item { label: string; href?: string; image: ImageMetadata }
interface Props { items?: Item[]; active?: number }
const { items = [{ label: 'Deploy AI in everyday tasks', image: a }, { label: 'Reshape critical functions and workflows', image: b }, { label: 'Invent net-new revenue with AI', image: c }], active = 0 } = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-12 lg:px-20">
  <div class="grid gap-8 sm:grid-cols-3 lg:max-w-[1013px]">
    {items.map((it, i) => (
      <a href={it.href ?? '#'} class:list={['group border-b-4 pb-6 transition', i === active ? 'border-emerald-700' : 'border-transparent hover:border-neutral-300']}>
        <div class="h-[120px] w-[120px] overflow-hidden rounded-full bg-emerald-50">
          <Image src={it.image} alt="" width={240} height={240} layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
        </div>
        <p class="mt-5 max-w-[276px] text-xl font-medium leading-snug text-neutral-900">{it.label}</p>
      </a>
    ))}
  </div>
</section>
