---
/**
 * BcgServiceTiles — row of 327×212 image tiles with a title bar underneath
 * (Agentic AI, Responsible AI …).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import a from '@assets/images/abstract-liquid.webp';
import b from '@assets/images/bg-navy-dots.webp';

interface Tile { title: string; image: ImageMetadata; href?: string }
interface Props { tiles?: Tile[] }
const { tiles = [{ title: 'Agentic AI', image: a }, { title: 'Responsible AI', image: b }] } = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-10 lg:px-20">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {tiles.map((t) => (
      <a href={t.href ?? '#'} class="group block">
        <div class="aspect-[327/212] overflow-hidden bg-neutral-100">
          <Image src={t.image} alt="" widths={[327, 654]} sizes="(min-width: 1024px) 327px, 50vw" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
        </div>
        <p class="mt-3 flex items-center justify-between text-lg font-semibold text-neutral-900">{t.title}<span class="text-emerald-700 transition group-hover:translate-x-1" aria-hidden="true">→</span></p>
      </a>
    ))}
  </div>
</section>
