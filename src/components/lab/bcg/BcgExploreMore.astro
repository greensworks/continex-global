---
/**
 * BcgExploreMore — "Explore More": a text card ("Next Section" + title +
 * button) beside 334×159 image cards with overline + title.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import a from '@assets/images/abstract-warm-streaks.webp';
import b from '@assets/images/bg-navy-dots.webp';

interface Card { overline: string; title: string; image: ImageMetadata; href?: string }
interface Props { nextLabel?: string; nextTitle?: string; cta?: { label: string; href: string }; cards?: Card[] }
const {
  nextLabel = 'Next Section', nextTitle = 'Our Latest Thinking on Artificial Intelligence', cta = { label: 'Learn More', href: '#' },
  cards = [{ overline: 'BCG X', title: 'Design and build with BCG X', image: a }, { overline: 'Capability', title: 'Digital, Technology, and Data', image: b }],
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-12 lg:px-20">
  <div class="grid gap-8 md:grid-cols-3">
    <div class="flex flex-col justify-between border-t-4 border-emerald-700 pt-6">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-neutral-600">{nextLabel}</p>
        <h3 class="mt-3 font-display text-2xl font-medium leading-snug text-neutral-900 md:text-[32px] md:leading-[44px]">{nextTitle}</h3>
      </div>
      <a href={cta.href} class="mt-8 inline-flex w-fit items-center border-2 border-neutral-900 px-10 py-3.5 text-[11px] font-bold uppercase tracking-[0.14em] text-neutral-900 transition hover:bg-neutral-900 hover:text-white">{cta.label}</a>
    </div>
    {cards.map((cd) => (
      <a href={cd.href ?? '#'} class="group block border-t border-neutral-300 pt-6">
        <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-neutral-600">{cd.overline}</p>
        <h3 class="mt-3 text-2xl font-medium leading-snug text-neutral-900 group-hover:underline">{cd.title}</h3>
        <div class="mt-6 aspect-[334/159] overflow-hidden bg-neutral-100">
          <Image src={cd.image} alt="" widths={[334, 668]} sizes="334px" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
        </div>
      </a>
    ))}
  </div>
</section>
