---
/**
 * BcgExperts — leaders block: 114px round portrait, linked name, title,
 * city and an e-mail link; 3–4 per row; "Contact the team" button below.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import p1 from '@assets/images/portrait-woman-blue.webp';
import p2 from '@assets/images/portrait-woman-phone.webp';
import p3 from '@assets/images/woman-tablet.webp';

interface Expert { name: string; title: string; city: string; image: ImageMetadata; href?: string; email?: string }
interface Props { experts?: Expert[]; cta?: { label: string; href: string } | null; emailLabel?: string }
const {
  experts = [
    { name: 'Sylvain Duranton', title: 'Managing Director & Senior Partner; Global Leader, BCG X', city: 'Paris', image: p1 },
    { name: 'Vladimir Lukic', title: 'Managing Director & Senior Partner; Global Leader, Tech and Digital Advantage', city: 'Boston', image: p2 },
    { name: 'Nicolas de Bellefonds', title: 'Managing Director & Senior Partner; Global Leader, AI', city: 'Paris', image: p3 },
    { name: 'Julie Bedard', title: 'Managing Director & Partner; BCG Institute Fellow', city: 'Boston', image: p2 },
    { name: 'Amanda Luther', title: 'Managing Director & Senior Partner', city: 'Austin', image: p1 },
    { name: 'Jeff Walters', title: 'Managing Director & Senior Partner', city: 'Singapore', image: p3 },
  ],
  cta = { label: 'Contact the team', href: '#' },
  emailLabel = 'Send an email',
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-12 lg:px-20">
  <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
    {experts.map((e) => (
      <div class="flex gap-5">
        <div class="h-[114px] w-[114px] shrink-0 overflow-hidden rounded-full bg-neutral-100">
          <Image src={e.image} alt={e.name} width={228} height={228} layout="none" class="h-full w-full object-cover" />
        </div>
        <div class="min-w-0">
          <a href={e.href ?? '#'} class="text-xl font-semibold leading-snug text-neutral-900 hover:underline">{e.name}</a>
          <p class="mt-1 text-sm leading-snug text-neutral-700">{e.title}</p>
          <p class="mt-1 text-sm text-neutral-500">{e.city}</p>
          <a href={e.email ?? '#'} class="mt-2 inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-emerald-700 hover:underline"><svg width="16" height="12" viewBox="0 0 24 18" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="1" width="22" height="16" rx="2"/><path d="m1 3 11 8 11-8"/></svg>{emailLabel}</a>
        </div>
      </div>
    ))}
  </div>
  {cta && <a href={cta.href} class="mt-12 inline-flex items-center border-2 border-neutral-900 px-10 py-3.5 text-[11px] font-bold uppercase tracking-[0.14em] text-neutral-900 transition hover:bg-neutral-900 hover:text-white">{cta.label}</a>}
</section>
