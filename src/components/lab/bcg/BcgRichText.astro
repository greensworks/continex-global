---
/**
 * BcgRichText — 789px reading column: optional heading, HTML paragraphs
 * (inline links allowed) and an optional outlined uppercase button.
 * Covers "Our AI and GenAI Collaborations" and the approach intro.
 */
interface Props { title?: string; paragraphs?: string[]; cta?: { label: string; href: string } | null }
const {
  title = 'Our AI and GenAI Collaborations',
  paragraphs = [
    'BCG is more than just a strategic consultant. Our AI consulting teams work with the world’s leading technology companies, including <a href="#" class="underline underline-offset-4">Amazon</a>, <a href="#" class="underline underline-offset-4">Google</a>, <a href="#" class="underline underline-offset-4">IBM</a>, <a href="#" class="underline underline-offset-4">Microsoft</a>, <a href="#" class="underline underline-offset-4">Salesforce</a>, and <a href="#" class="underline underline-offset-4">SAP</a>, and with AI-centered enterprises such as OpenAI and Anthropic.',
    'Working together, we deliver value across four critical dimensions. Through <a href="#" class="underline underline-offset-4">BCG X</a>, our in-house design-and-build capability, we combine strategy with engineering to ship products that scale.',
  ],
  cta = { label: 'Learn more', href: '#' },
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-14 lg:px-20">
  <div class="max-w-[1013px]">
    {title && <h2 class="font-display text-3xl font-medium leading-tight text-neutral-900 md:text-[44px] md:leading-[52px]">{title}</h2>}
    <div class="mt-6 max-w-[789px] space-y-6 text-lg leading-relaxed text-neutral-800 md:text-[20px] md:leading-[26px]">
      {paragraphs.map((p) => <p set:html={p} />)}
    </div>
    {cta && <a href={cta.href} class="mt-10 inline-flex items-center border-2 border-neutral-900 px-10 py-3.5 text-[11px] font-bold uppercase tracking-[0.14em] text-neutral-900 transition hover:bg-neutral-900 hover:text-white">{cta.label}</a>}
  </div>
</section>
