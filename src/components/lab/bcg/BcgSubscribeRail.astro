---
/**
 * BcgSubscribeRail — compact subscribe card (280px): "Subscribe" button
 * row, newsletter name, e-mail input + submit. On a real page pin it with
 * `fixed right-0 top-1/3`.
 */
interface Props { title?: string; placeholder?: string; fixed?: boolean }
const { title = 'Tech + Us: Harness the power of technology and AI', placeholder = 'Enter Email', fixed = false } = Astro.props;
---
<aside class:list={['w-[320px] max-w-full border border-neutral-300 bg-white p-5 shadow-lg', fixed ? 'fixed right-0 top-1/3 z-30' : 'mx-auto my-12']} aria-label="Subscribe">
  <div class="flex items-center justify-between">
    <span class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-emerald-700"><svg width="16" height="12" viewBox="0 0 24 18" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="1" width="22" height="16" rx="2"/><path d="m1 3 11 8 11-8"/></svg>Subscribe</span>
    <button type="button" aria-label="See everything" class="grid h-8 w-8 place-items-center text-neutral-500"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
  </div>
  <p class="mt-3 text-sm font-semibold leading-snug text-neutral-900">{title}</p>
  <form class="mt-4 flex gap-2" action="#" method="post">
    <label class="sr-only" for="bcg-sub-email">Email</label>
    <input id="bcg-sub-email" type="email" required placeholder={placeholder} class="h-12 min-w-0 flex-1 border border-neutral-300 px-3 text-sm outline-none focus:border-emerald-700" />
    <button type="submit" class="grid h-12 w-[72px] place-items-center bg-emerald-700 text-white transition hover:bg-emerald-800" aria-label="Subscribe"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></button>
  </form>
</aside>
