---
/**
 * RbTextBlock — body copy aligned to the right half of the page next to the
 * centre guide line (follows RbSectionHeadline). HTML allowed in paragraphs.
 */
interface Props { paragraphs?: string[] }
const { paragraphs = [
  'Big change starts with big thinking. The businesses that thrive are those that balance commercial success with environmental and social responsibility, shaping the future through positive action.',
  'Rapid technological shifts, supply chain disruptions and economic volatility are bringing new challenges for industries. For C-level executives and decision-makers, these forces present both risk and opportunity.',
  'At Roland Berger, we help businesses turn uncertainty into strategy. As a leading global management consultancy, we work with executives to build resilience, unlock new opportunities and drive transformation with purpose and foresight.',
] } = Astro.props;
---
<section class="mx-auto max-w-7xl px-6 lg:px-10">
  <div class="grid md:grid-cols-2">
    <div class="hidden md:block"></div>
    <div class="space-y-5 border-l border-black/70 pb-10 pl-6 text-[15px] leading-relaxed text-neutral-800 md:pl-8 [&_a]:underline [&_a]:underline-offset-4">
      {paragraphs.map((p) => <p set:html={p} />)}
    </div>
  </div>
</section>
