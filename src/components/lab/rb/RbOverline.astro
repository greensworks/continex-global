---
/**
 * RbOverline — small italic serif overline, centred, with the vertical guide
 * line above and a short tick below. Used between sections
 * ("Meet our experts", "Join the team", "What others say").
 */
interface Props {
  text: string;
  /** show the guide line above */
  line?: boolean;
}
const { text, line = true } = Astro.props;
---
<section class="relative py-8 text-center md:py-10">
  {line && <span class="mx-auto block h-12 w-px bg-black/70 md:h-16" aria-hidden="true"></span>}
  <p class="mt-4 font-serif text-[13px] italic text-black md:text-sm">{text}</p>
  <span class="mx-auto mt-2 block h-px w-8 bg-black" aria-hidden="true"></span>
</section>
