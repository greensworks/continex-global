---
/**
 * RbHeader — Roland Berger style header.
 * Thin meta strip (secondary links + language) above a black, inset
 * navigation bar with logo, primary links, search and a hanging red tag.
 * Designed to sit over a hero image (absolute) or stand alone (static).
 */
interface Props {
  brand?: string;
  meta?: { label: string; href: string }[];
  nav?: { label: string; href: string }[];
  langs?: { code: string; href: string; active?: boolean }[];
  tag?: { label: string; href: string } | null;
  /** 'overlay' = absolute over a hero, 'static' = in normal flow */
  mode?: 'overlay' | 'static';
}
const {
  brand = 'Roland Berger',
  meta = [
    { label: 'Newsroom', href: '#' },
    { label: 'Think:Act Magazine', href: '#' },
    { label: 'Alumni', href: '#' },
    { label: 'Contact Us', href: '#' },
    { label: 'Newsletter', href: '#' },
  ],
  nav = [
    { label: 'Expertise', href: '#' },
    { label: 'Insights', href: '#' },
    { label: 'About', href: '#' },
    { label: 'Locations', href: '#' },
    { label: 'Join', href: '#' },
  ],
  langs = [
    { code: 'EN', href: '#', active: true },
    { code: 'DE', href: '#' },
  ],
  tag = { label: '7 Jobs', href: '#' },
  mode = 'static',
} = Astro.props;
---
<header class:list={['rb-header z-40 w-full', mode === 'overlay' ? 'absolute inset-x-0 top-0' : 'relative bg-neutral-200']}>
  {/* meta strip */}
  <div class="mx-auto hidden max-w-7xl items-center justify-between px-6 py-2.5 text-[11px] font-medium tracking-wide text-black md:flex lg:px-10">
    <nav aria-label="Secondary" class="flex items-center gap-6">
      {meta.map((m) => <a href={m.href} class="transition hover:underline underline-offset-4">{m.label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      {langs.map((l, i) => (
        <>
          {i > 0 && <span class="opacity-40">|</span>}
          <a href={l.href} class:list={['transition', l.active ? 'font-bold' : 'opacity-50 hover:opacity-100']}>{l.code}</a>
        </>
      ))}
    </div>
  </div>

  {/* black bar */}
  <div class="mx-auto max-w-7xl px-4 md:px-6 lg:px-10">
    <div class="relative flex h-16 items-center justify-between bg-black px-5 text-white md:h-20 md:px-8">
      <a href="#" class="font-display text-lg font-bold leading-[0.95] tracking-tight md:text-xl">
        {brand.split(' ').map((w) => <span class="block">{w}</span>)}
      </a>

      <nav aria-label="Primary" class="hidden items-center gap-8 text-[15px] md:flex">
        {nav.map((n) => (
          <a href={n.href} class="relative py-2 transition after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:scale-x-0 after:bg-white after:transition-transform hover:after:scale-x-100">{n.label}</a>
        ))}
        <a href="#" aria-label="Search" class="ml-2 grid h-9 w-9 place-items-center rounded-full transition hover:bg-white/10">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </a>
      </nav>

      <button type="button" class="grid h-10 w-10 place-items-center md:hidden" aria-label="Menu" aria-expanded="false" data-rb-menu>
        <span class="block h-0.5 w-6 bg-white shadow-[0_6px_0_0_#fff,0_-6px_0_0_#fff]"></span>
      </button>

      {tag && (
        <a href={tag.href} class="absolute -bottom-3.5 right-8 bg-red-500 px-2.5 py-1 text-[11px] font-semibold text-white md:right-12">{tag.label}</a>
      )}
    </div>

    <nav id="rb-mobile-nav" hidden class="bg-black px-5 pb-6 pt-2 text-white md:hidden" aria-label="Mobile">
      {nav.map((n) => <a href={n.href} class="block border-b border-white/15 py-3 text-lg">{n.label}</a>)}
      <div class="mt-4 flex flex-wrap gap-4 text-xs opacity-80">
        {meta.map((m) => <a href={m.href}>{m.label}</a>)}
      </div>
    </nav>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-rb-menu]').forEach((btn) => {
    const nav = btn.closest('header')!.querySelector<HTMLElement>('#rb-mobile-nav')!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      nav.hidden = !open;
    });
  });
</script>
