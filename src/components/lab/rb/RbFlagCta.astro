---
/**
 * RbFlagCta — red "flag" call-to-action: a solid block with a folded corner
 * on the left, arrow on the right. Centred.
 */
interface Props {
  label?: string;
  href?: string;
  tone?: 'red' | 'black';
}
const { label = 'Sign up for our newsletter', href = '#', tone = 'red' } = Astro.props;
const colors = tone === 'red' ? 'bg-red-500 text-white before:border-t-red-800' : 'bg-black text-white before:border-t-neutral-700';
---
<section class="flex justify-center px-6 py-6">
  <a
    href={href}
    class:list={[
      'relative inline-flex min-w-[260px] max-w-sm items-center justify-between gap-8 px-6 py-4 text-[15px] font-semibold leading-tight transition hover:brightness-95 md:min-w-[300px]',
      'before:absolute before:-left-3 before:top-0 before:h-0 before:w-0 before:border-r-[12px] before:border-t-[12px] before:border-r-transparent',
      colors,
    ]}
  >
    <span>{label}</span>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
  </a>
</section>
