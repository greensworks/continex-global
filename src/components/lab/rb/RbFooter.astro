---
/**
 * RbFooter — light grey footer: featured links (first underlined yellow)
 * and image credits on the left, headquarters block in the middle,
 * uppercase legal links + social icons on the right.
 */
interface Props {
  featured?: { label: string; href: string }[];
  hq?: { title: string; company: string; lines: string[]; phone?: string; fax?: string; mailLabel?: string; mailHref?: string };
  legal?: { label: string; href: string }[];
  social?: { label: string; href: string; icon: 'linkedin' | 'x' | 'facebook' | 'mail' }[];
  credits?: string;
}
const {
  featured = [
    { label: 'Recent publications', href: '#' },
    { label: 'About', href: '#' },
    { label: 'Join', href: '#' },
  ],
  hq = { title: 'Headquarters', company: 'Roland Berger GmbH', lines: ['Sederanger 1', '80538 Munich', 'Germany'], phone: '+49 89 9230-0', fax: '+49 89 9230-8202', mailLabel: 'Send us a message', mailHref: '#' },
  legal = [
    { label: 'Newsroom', href: '#' },
    { label: 'Legal', href: '#' },
    { label: 'Help', href: '#' },
    { label: 'Privacy', href: '#' },
    { label: 'Cookies', href: '#' },
    { label: 'Contact', href: '#' },
  ],
  social = [
    { label: 'LinkedIn', href: '#', icon: 'linkedin' },
    { label: 'X', href: '#', icon: 'x' },
    { label: 'Facebook', href: '#', icon: 'facebook' },
    { label: 'Mail', href: '#', icon: 'mail' },
  ],
  credits = 'Image AI generated; AI Artwork: Marius Jopen/The Robots',
} = Astro.props;

const icons = {
  linkedin: '<path d="M6.5 8.5v9M6.5 5.5v.01M10.5 17.5v-5a2.5 2.5 0 0 1 5 0v5M10.5 8.5v9" stroke-width="2"/>',
  x: '<path d="m5 5 14 14M19 5 5 19" stroke-width="2"/>',
  facebook: '<path d="M14 8h2V5h-2a3 3 0 0 0-3 3v2H9v3h2v6h3v-6h2l1-3h-3V8Z" stroke-width="1.5"/>',
  mail: '<rect x="3" y="6" width="18" height="12" rx="1.5" stroke-width="1.5"/><path d="m3 7 9 6 9-6" stroke-width="1.5"/>',
};
---
<footer class="bg-neutral-100 text-black">
  <div class="mx-auto grid max-w-7xl gap-10 px-6 py-12 md:grid-cols-12 md:py-16 lg:px-10">
    <div class="md:col-span-4">
      <nav class="flex flex-col gap-2 text-[13px]">
        {featured.map((f, i) => (
          <a href={f.href} class:list={['inline-block w-fit pb-0.5', i === 0 ? 'border-b-2 border-yellow-400 font-semibold' : 'hover:underline']}>{f.label}</a>
        ))}
      </nav>
      {credits && (
        <div class="mt-10 text-[10px] leading-relaxed text-neutral-500">
          <p class="font-semibold uppercase tracking-wide">Image credits</p>
          <p class="mt-1">{credits}</p>
        </div>
      )}
    </div>

    <div class="text-[12px] leading-relaxed md:col-span-4">
      <p class="font-semibold">{hq.title}</p>
      <p class="font-semibold">{hq.company}</p>
      <address class="mt-3 not-italic">{hq.lines.map((l) => <span class="block">{l}</span>)}</address>
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3">
        {hq.phone && <><dt>Phone:</dt><dd><a href={`tel:${hq.phone.replace(/\s/g, '')}`} class="hover:underline">{hq.phone}</a></dd></>}
        {hq.fax && <><dt>Fax:</dt><dd>{hq.fax}</dd></>}
        {hq.mailLabel && <><dt>Mail:</dt><dd><a href={hq.mailHref} class="underline underline-offset-2">{hq.mailLabel}</a></dd></>}
      </dl>
    </div>

    <div class="flex flex-col gap-8 md:col-span-4 md:items-end">
      <nav class="flex flex-col gap-2 text-[10px] font-semibold uppercase tracking-[0.16em] md:items-end">
        {legal.map((l) => <a href={l.href} class="hover:underline">{l.label}</a>)}
      </nav>
      <div class="flex gap-2">
        {social.map((s) => (
          <a href={s.href} aria-label={s.label} class="grid h-8 w-8 place-items-center rounded-full border border-black/30 transition hover:bg-black hover:text-white">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} />
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
