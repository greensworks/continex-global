---
/**
 * RbSubnavPills — grey sub-navigation row of pill links; the selected one
 * is filled black. Scrolls horizontally on small screens.
 */
interface Props { items?: { label: string; href: string; active?: boolean }[] }
const { items = [
  { label: 'Overview', href: '#', active: true }, { label: 'Who we are', href: '#' }, { label: 'Our values', href: '#' },
  { label: 'Our people', href: '#' }, { label: 'Sustainability commitment', href: '#' }, { label: 'Corporate integrity', href: '#' },
] } = Astro.props;
---
<nav class="bg-neutral-100" aria-label="Section">
  <ul class="mx-auto flex max-w-7xl gap-2 overflow-x-auto px-6 py-4 [scrollbar-width:none] lg:justify-center lg:px-10 [&::-webkit-scrollbar]:hidden">
    {items.map((it) => (
      <li class="shrink-0">
        <a href={it.href} class:list={['inline-block rounded-full border px-4 py-1.5 text-[13px] font-medium transition', it.active ? 'border-black bg-black text-white' : 'border-neutral-300 bg-white text-black hover:border-black']}>{it.label}</a>
      </li>
    ))}
  </ul>
</nav>
