---
/**
 * RbSectionHeadline — centred vertical guide line dropping into a bold,
 * left-aligned-from-centre headline (RB "add-line" pattern).
 */
interface Props {
  title: string;
  as?: 'h1' | 'h2' | 'h3';
  /** height of the guide line above the title */
  line?: 'sm' | 'md' | 'lg';
}
const { title, as: Tag = 'h2', line = 'md' } = Astro.props;
const lineH = { sm: 'h-10', md: 'h-20 md:h-28', lg: 'h-32 md:h-40' }[line];
---
<section class="relative">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="grid md:grid-cols-2">
      <div class="hidden md:block"></div>
      <div class="relative border-l border-black/70 pb-8 pl-6 md:pl-8">
        <span class:list={['absolute left-0 top-0 -translate-y-full border-l border-black/70', lineH]} aria-hidden="true"></span>
        <Tag class="font-display text-[1.75rem] font-semibold leading-[1.15] tracking-tight text-black md:text-[2.25rem]" set:html={title} />
      </div>
    </div>
  </div>
</section>
