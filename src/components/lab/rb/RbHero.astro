---
/**
 * RbHero — full-bleed image stage with a single black CTA pinned to the
 * bottom-right corner and a thin vertical guide line dropping from the
 * centre (the line continues in the next section headline).
 * Put a header in the "header" slot to overlay it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultImg from '@assets/images/refinery-dusk.webp';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  cta?: { label: string; href: string };
  /** vertical size */
  height?: 'md' | 'lg';
}
const { image = defaultImg, alt = '', cta = { label: 'Our consulting approach', href: '#' }, height = 'md' } = Astro.props;
---
<section class:list={['relative isolate overflow-hidden bg-black', height === 'lg' ? 'min-h-[80svh]' : 'min-h-[52svh] md:min-h-[60svh]']}>
  <Image src={image} alt={alt} widths={[768, 1280, 1920]} sizes="100vw" layout="none" loading="eager" class="absolute inset-0 -z-10 h-full w-full object-cover" />
  <slot name="header" />

  {cta && (
    <a href={cta.href} class="absolute bottom-0 right-0 inline-flex items-center gap-3 bg-black px-5 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-neutral-800 md:px-6 md:py-3.5">
      {cta.label}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12h8m-3-3 3 3-3 3"/></svg>
    </a>
  )}
</section>
