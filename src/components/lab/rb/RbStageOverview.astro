---
/**
 * RbStageOverview — section landing hero ("About us overview"): full-bleed
 * photo, a large white letter mark beside the white H1, and a black
 * newsletter button pinned bottom-right. Slot a header in "header".
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultImg from '@assets/images/meeting-table.webp';

interface Props { image?: ImageMetadata; mark?: string; title?: string; cta?: { label: string; href: string } }
const { image = defaultImg, mark = 'B', title = 'About us overview', cta = { label: 'Sign up for our newsletter', href: '#' } } = Astro.props;
---
<section class="relative isolate flex min-h-[420px] items-center overflow-hidden bg-black text-white md:min-h-[520px]">
  <Image src={image} alt="" widths={[768, 1280, 1920]} sizes="100vw" layout="none" class="absolute inset-0 -z-20 h-full w-full object-cover" />
  <div class="absolute inset-0 -z-10 bg-black/45" aria-hidden="true"></div>
  <slot name="header" />
  <div class="mx-auto flex w-full max-w-7xl items-center gap-6 px-6 pt-24 lg:px-10">
    <span class="font-display text-[120px] font-bold leading-none text-white md:text-[180px]" aria-hidden="true">{mark}</span>
    <h1 class="font-display text-4xl font-medium leading-tight text-white md:text-[52px]">{title}</h1>
  </div>
  {cta && (
    <a href={cta.href} class="absolute bottom-0 right-0 inline-flex items-center gap-3 bg-black px-5 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-neutral-800 md:px-6 md:py-3.5">
      {cta.label}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12h8m-3-3 3 3-3 3"/></svg>
    </a>
  )}
</section>
