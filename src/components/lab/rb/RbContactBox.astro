---
/**
 * RbContactBox — full-width tinted band with a heading, one line of text
 * and a black button pinned to the bottom-right corner.
 */
interface Props {
  title?: string;
  text?: string;
  cta?: { label: string; href: string };
  tone?: 'mint' | 'grey' | 'navy';
}
const { title = 'Contact us', text = 'We are happy to take care of your request!', cta = { label: 'Contact', href: '#' }, tone = 'mint' } = Astro.props;
const tones = { mint: 'bg-emerald-100 text-black', grey: 'bg-neutral-100 text-black', navy: 'bg-navy-900 text-white' };
---
<section class:list={['relative', tones[tone]]}>
  <div class="mx-auto max-w-7xl px-6 pb-20 pt-12 md:pb-24 md:pt-16 lg:px-10">
    <div class="md:ml-[50%] md:pl-8">
      <h2 class:list={['font-display text-2xl font-semibold tracking-tight md:text-3xl', tone === 'navy' ? 'text-white' : 'text-black']}>{title}</h2>
      <p class="mt-2 text-sm opacity-80">{text}</p>
    </div>
  </div>
  <a href={cta.href} class="absolute bottom-0 right-0 bg-black px-5 py-3 text-[10px] font-bold uppercase tracking-[0.14em] text-white transition hover:bg-neutral-800 md:px-6">{cta.label}</a>
</section>
