---
/**
 * RbMediaTiles — 3-column media tiles (podcast episodes): photo with a
 * white label chip, dark-green caption bar with the white title. Optional
 * "Load more" control underneath.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RbLoadMore from './RbLoadMore.astro';
import a from '@assets/images/meeting-table.webp';
import b from '@assets/images/woman-tablet.webp';
import c from '@assets/images/portrait-woman-phone.webp';
import d from '@assets/images/portrait-woman-blue.webp';
import e from '@assets/images/glass-facade.webp';
import f from '@assets/images/high-voltage-towers.webp';

interface Tile { label: string; title: string; image: ImageMetadata; href?: string }
interface Props { tiles?: Tile[]; loadMore?: string | null }
const {
  tiles = [
    { label: 'Podcast', title: 'Driving value with sustainability', image: a },
    { label: 'Podcast', title: 'Pricing carbon to reduce emissions', image: b },
    { label: 'Podcast', title: 'Asia’s energy transition', image: c },
    { label: 'Podcast', title: 'Taking sustainability to the topline', image: d },
    { label: 'Podcast', title: 'Plastics circularity: game changer for reaching sustainability?', image: e },
    { label: 'Podcast', title: 'Financing the energy transition', image: f },
  ],
  loadMore = 'Load more',
} = Astro.props;
---
<section class="mx-auto max-w-7xl px-6 lg:px-10">
  <div class="grid grid-cols-1 gap-1 sm:grid-cols-2 md:grid-cols-3">
    {tiles.map((t) => (
      <a href={t.href ?? '#'} class="group block bg-emerald-900 text-white">
        <div class="relative aspect-[16/10] overflow-hidden">
          <Image src={t.image} alt="" widths={[480, 768]} sizes="(min-width: 768px) 33vw, 100vw" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
          <span class="absolute left-4 top-4 bg-white px-2 py-1 text-[9px] font-bold uppercase tracking-[0.14em] text-black">{t.label}</span>
        </div>
        <div class="min-h-[88px] p-4 md:p-5">
          <h3 class="text-[15px] font-medium leading-snug text-white md:text-base">{t.title}</h3>
        </div>
      </a>
    ))}
  </div>
  {loadMore && <RbLoadMore label={loadMore} />}
</section>
