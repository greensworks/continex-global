---
/**
 * RbLoadMore — centred "Load more" control on the guide line: black circle
 * with a plus sign and a small label to the right.
 */
interface Props { label?: string }
const { label = 'Load more' } = Astro.props;
---
<div class="flex justify-center py-6">
  <button type="button" class="group inline-flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-black">
    <span class="grid h-10 w-10 place-items-center rounded-full bg-black text-white transition group-hover:bg-neutral-700" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
    </span>
    {label}
  </button>
</div>
