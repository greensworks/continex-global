---
/**
 * RbJoinTiles — three equal image tiles with a title strip; the last tile
 * carries a black "select" dropdown pinned to the image corner.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import img1 from '@assets/images/woman-tablet.webp';
import img2 from '@assets/images/meeting-table.webp';
import img3 from '@assets/images/portrait-woman-phone.webp';

interface JoinTile { title: string; href?: string; image: ImageMetadata; alt?: string; select?: { label: string; options: string[] } }
interface Props { tiles?: JoinTile[] }

const demo: JoinTile[] = [
  { title: 'Why Roland Berger', href: '#', image: img1 },
  { title: 'Diversity', href: '#', image: img2 },
  { title: 'Search for jobs', image: img3, select: { label: 'Select country', options: ['Germany', 'Türkiye', 'China', 'United States'] } },
];
const { tiles = demo } = Astro.props;
---
<section class="mx-auto max-w-7xl px-6 lg:px-10">
  <div class="grid grid-cols-1 gap-1 md:grid-cols-3">
    {tiles.map((t) => {
      const Tag = t.href ? 'a' : 'div';
      return (
        <Tag href={t.href} class="group block bg-neutral-100 text-black">
          <div class="relative aspect-[16/10] overflow-hidden">
            <Image src={t.image} alt={t.alt ?? ''} widths={[480, 768]} sizes="(min-width: 768px) 33vw, 100vw" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
            {t.select && (
              <label class="absolute bottom-0 right-0 flex items-center gap-3 bg-black px-4 py-2.5 text-[10px] font-bold uppercase tracking-[0.14em] text-white">
                <span class="sr-only">{t.select.label}</span>
                <select class="appearance-none bg-transparent pr-4 text-[10px] font-bold uppercase tracking-[0.14em] text-white outline-none">
                  <option class="text-black">{t.select.label}</option>
                  {t.select.options.map((o) => <option class="text-black">{o}</option>)}
                </select>
                <svg class="-ml-6 pointer-events-none" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </label>
            )}
          </div>
          <div class="p-4 md:p-5">
            <h3 class="font-display text-[15px] font-medium md:text-base">{t.title}</h3>
          </div>
        </Tag>
      );
    })}
  </div>
</section>
