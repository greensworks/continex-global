---
/**
 * RbSeparator — vertical spacing with the centred guide line.
 */
interface Props { size?: 'sm' | 'md' | 'lg' }
const { size = 'md' } = Astro.props;
const h = { sm: 'h-8', md: 'h-14 md:h-20', lg: 'h-24 md:h-32' }[size];
---
<div class="flex justify-center" aria-hidden="true">
  <span class:list={['block w-px bg-black/70', h]}></span>
</div>
