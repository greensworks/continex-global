---
/**
 * SaHeader — Strategy& (PwC) header: wordmark + "Part of the PwC network",
 * main nav, Search, territory selector, and an optional breadcrumb row.
 */
interface Props {
  nav?: { label: string; href: string }[];
  territory?: string;
  searchLabel?: string;
  breadcrumb?: { label: string; href?: string }[];
}
const {
  nav = [
    { label: 'About Strategy&', href: '#' }, { label: 'Industries', href: '#' }, { label: 'Expertise', href: '#' },
    { label: 'Publications', href: '#' }, { label: 'Careers', href: '#' }, { label: 'Contact', href: '#' },
  ],
  territory = 'Netherlands',
  searchLabel = 'Search',
  breadcrumb = [{ label: 'Strategy& NL', href: '#' }, { label: 'Careers' }],
} = Astro.props;
---
<header class="border-b border-neutral-200 bg-white text-neutral-900">
  <div class="mx-auto flex h-[90px] max-w-[1512px] items-center justify-between px-6 lg:px-8">
    <a href="#" class="leading-none">
      <span class="block font-serif text-[26px] font-bold tracking-tight">strategy<span class="font-normal">&amp;</span></span>
      <span class="mt-1 block text-[9px] text-neutral-500">Part of the PwC network</span>
    </a>
    <div class="flex items-center gap-6">
      <nav class="hidden items-center text-[15px] lg:flex" aria-label="Main">
        {nav.map((n) => <a href={n.href} class="px-3.5 py-2 transition hover:underline underline-offset-8">{n.label}</a>)}
      </nav>
      <button type="button" class="hidden items-center gap-2 text-[15px] lg:inline-flex">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>{searchLabel}
      </button>
      <button type="button" class="hidden items-center gap-1 text-xs text-neutral-600 lg:inline-flex">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>{territory}
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <button type="button" class="grid h-10 w-10 place-items-center lg:hidden" aria-label="Menu">
        <span class="block h-0.5 w-6 bg-black shadow-[0_6px_0_0_#000,0_-6px_0_0_#000]"></span>
      </button>
    </div>
  </div>
  {breadcrumb.length > 0 && (
    <nav class="mx-auto max-w-[1512px] px-6 py-2 text-[13px] text-neutral-600 lg:px-8" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        {breadcrumb.map((b, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true">›</span>}
            {b.href ? <a href={b.href} class="underline-offset-4 hover:underline">{b.label}</a> : <span class="text-neutral-900">{b.label}</span>}
          </li>
        ))}
      </ol>
    </nav>
  )}
</header>
