---
/**
 * SaSideTabs — vertical tab list (left) driving a text panel (right).
 * "Size nasıl yardımcı olabiliriz?" pattern. Minimal inline script.
 */
interface Tab { label: string; title: string; text: string; link?: { label: string; href: string } }
interface Props { title?: string; tabs?: Tab[] }
const {
  title = 'Size nasıl yardımcı olabiliriz?',
  tabs = [
    { label: 'COO gündemi', title: 'COO gündemi', text: 'Tüm büyük sektörlerde derin yere sahip operasyon stratejisi ekibimiz, COO’ların gündemindeki en kritik konularda somut sonuçlar üretir.', link: { label: 'Daha fazlası için tıklayınız', href: '#' } },
    { label: 'Operasyonlarda dayanıklılık', title: 'Operasyonlarda dayanıklılık', text: 'Tedarik zinciri kesintilerine, maliyet baskısına ve talep dalgalanmalarına karşı dayanıklı operasyon modelleri tasarlıyoruz.', link: { label: 'Daha fazlası için tıklayınız', href: '#' } },
  ],
} = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---
<section class="mx-auto max-w-[1512px] px-6 py-16 lg:px-[86px] lg:py-20" data-sa-tabs>
  <h2 class="font-serif text-4xl leading-tight text-neutral-900 md:text-[42px]">{title}</h2>
  <div class="mt-10 grid gap-8 lg:grid-cols-[426px_1fr] lg:gap-16">
    <div role="tablist" aria-orientation="vertical" class="flex flex-col border-l-2 border-neutral-300">
      {tabs.map((t, i) => (
        <button type="button" role="tab" id={`tab-${uid}-${i}`} aria-controls={`panel-${uid}-${i}`} aria-selected={i === 0 ? 'true' : 'false'} class="-ml-0.5 border-l-2 border-transparent px-6 py-4 text-left text-lg text-neutral-700 transition aria-selected:border-red-600 aria-selected:font-semibold aria-selected:text-neutral-900">{t.label}</button>
      ))}
    </div>
    <div>
      {tabs.map((t, i) => (
        <div role="tabpanel" id={`panel-${uid}-${i}`} aria-labelledby={`tab-${uid}-${i}`} hidden={i !== 0} class="max-w-[883px]">
          <h3 class="text-3xl font-semibold text-neutral-900">{t.title}</h3>
          <p class="mt-5 text-base leading-relaxed text-neutral-700 md:text-lg">{t.text}</p>
          {t.link && <a href={t.link.href} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold underline-offset-4 hover:underline">{t.link.label}<span aria-hidden="true">›</span></a>}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-sa-tabs]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[role=tab]');
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      tabs.forEach((t) => { t.setAttribute('aria-selected', String(t === tab)); root.querySelector<HTMLElement>('#' + t.getAttribute('aria-controls'))!.hidden = t !== tab; });
    }));
  });
</script>
