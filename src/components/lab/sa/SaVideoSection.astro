---
/**
 * SaVideoSection — serif statement heading above a 16:9 video player
 * (poster + play button). Pass a real <video>/<iframe> in the default slot.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import poster from '@assets/images/meeting-table.webp';

interface Props { title?: string; posterImage?: ImageMetadata }
const { title = 'Strategy&’s unique combination of strategic expertise and hands-on execution makes it a place where careers accelerate.', posterImage = poster } = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-16 lg:px-[86px] lg:py-20">
  <div class="max-w-[883px]">
    <h2 class="font-serif text-3xl leading-snug text-neutral-900 md:text-[36px]">{title}</h2>
    <div class="relative mt-10 aspect-video overflow-hidden bg-black">
      <slot>
        <Image src={posterImage} alt="" widths={[883, 1766]} sizes="(min-width: 1024px) 883px, 100vw" layout="none" class="h-full w-full object-cover opacity-80" />
        <button type="button" class="absolute left-1/2 top-1/2 grid h-20 w-20 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-white text-white transition hover:bg-white hover:text-black" aria-label="Play video">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </button>
      </slot>
    </div>
  </div>
</section>
