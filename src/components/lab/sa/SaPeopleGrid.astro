---
/**
 * SaPeopleGrid — top rule + serif heading, then a 4-column grid of person
 * cards (photo 16:9, name, short bio). Also used for "İletişim" contact grids.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import p1 from '@assets/images/portrait-woman-blue.webp';
import p2 from '@assets/images/portrait-woman-phone.webp';
import p3 from '@assets/images/woman-tablet.webp';
import p4 from '@assets/images/meeting-table.webp';

interface Person { name: string; bio: string; image: ImageMetadata; href?: string }
interface Props { title?: string; people?: Person[]; columns?: 3 | 4 }
const {
  title = 'Your Strategy& consultants in Amsterdam',
  people = [
    { name: 'Camille Ané', bio: 'Camille Ané specializes in operations strategy and supply chain transformation.', image: p1 },
    { name: 'Jeroen Crijns', bio: 'Jeroen Crijns is an advisor to executives in the financial services sector.', image: p2 },
    { name: 'Roderik van Houtert', bio: 'Roderik van Houtert is an advisor to executives in energy and utilities.', image: p3 },
    { name: 'Dr. Paul Nillesen', bio: 'Paul Nillesen is an advisor to executives in the energy sector.', image: p4 },
    { name: 'Marcel Otten', bio: 'Marcel Otten is an advisor to executives in healthcare.', image: p2 },
    { name: 'Guillaume Laffitte-Rigaud', bio: 'Guillaume Laffitte-Rigaud is an advisor to executives in consumer markets.', image: p1 },
    { name: 'Sander Visser', bio: 'Sander Visser leads both the Strategy& and the PwC deals practice.', image: p4 },
  ],
  columns = 4,
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-16 lg:px-[86px] lg:py-20">
  <hr class="border-neutral-300" />
  <h2 class="mt-12 font-serif text-4xl leading-tight text-neutral-900 md:text-[42px]">{title}</h2>
  <div class:list={['mt-10 grid gap-8 sm:grid-cols-2', columns === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
    {people.map((p) => (
      <a href={p.href ?? '#'} class="group block">
        <div class="aspect-[16/9] overflow-hidden bg-neutral-100">
          <Image src={p.image} alt={p.name} widths={[320, 640]} sizes="(min-width: 1024px) 25vw, 50vw" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
        </div>
        <h3 class="mt-4 text-lg font-semibold text-neutral-900 group-hover:underline">{p.name}</h3>
        <p class="mt-2 text-sm leading-relaxed text-neutral-700">{p.bio}</p>
      </a>
    ))}
  </div>
</section>
