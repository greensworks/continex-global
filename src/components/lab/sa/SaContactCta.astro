---
/**
 * SaContactCta — dark band: serif heading, sub-heading, outlined button.
 * ("Bize Ulaşın" block on Strategy& Türkiye.)
 */
interface Props { title?: string; text?: string; cta?: { label: string; href: string }; tone?: 'dark' | 'light' }
const { title = 'Bize Ulaşın', text = 'Strategy& Türkiye çözümleri hakkında daha fazla bilgi almak için bizimle iletişime geçin.', cta = { label: 'Bize ulaşın', href: '#' }, tone = 'dark' } = Astro.props;
---
<section class:list={[tone === 'dark' ? 'bg-neutral-900 text-white' : 'bg-neutral-100 text-neutral-900']}>
  <div class="mx-auto flex max-w-[1512px] flex-col gap-8 px-6 py-16 lg:flex-row lg:items-center lg:justify-between lg:px-[86px] lg:py-20">
    <div class="max-w-[1180px]">
      <h2 class:list={['font-serif text-4xl leading-tight md:text-[44px]', tone === 'dark' ? 'text-white' : 'text-neutral-900']}>{title}</h2>
      <p class="mt-3 text-xl opacity-85 md:text-2xl">{text}</p>
    </div>
    <a href={cta.href} class:list={['inline-flex shrink-0 items-center gap-3 border px-8 py-3.5 text-base font-semibold transition', tone === 'dark' ? 'border-white hover:bg-white hover:text-black' : 'border-neutral-900 hover:bg-neutral-900 hover:text-white']}>{cta.label}<span aria-hidden="true">›</span></a>
  </div>
</section>
