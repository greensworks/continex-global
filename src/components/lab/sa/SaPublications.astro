---
/**
 * SaPublications — "Latest publications": top rule, serif heading, filter
 * row, 3-column card grid where one card per row is double width, then
 * "Load more" (filled) and "View all" (text) buttons.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import a from '@assets/images/abstract-liquid.webp';
import b from '@assets/images/bg-navy-dots.webp';
import c from '@assets/images/glass-facade.webp';
import d from '@assets/images/refinery-dusk.webp';
import e from '@assets/images/industrial-pipes-red.webp';
import f from '@assets/images/grain-silos-dusk.webp';

interface Card { tag: string; title: string; text: string; image: ImageMetadata; wide?: boolean; href?: string }
interface Props { title?: string; filters?: string[]; cards?: Card[]; loadMore?: string; viewAll?: string }
const {
  title = 'Latest publications',
  filters = ['Industries', 'Expertise'],
  cards = [
    { tag: 'Blog post', title: 'Pharma innovation ecosystems of tomorrow', text: 'How pharmaceutical companies can harness diverse strategic partnerships.', image: a, wide: true },
    { tag: 'Podcast', title: 'Insider Podcast', text: 'Listen to our podcast on the future of health.', image: b },
    { tag: 'Blog post', title: 'The future of asset development', text: 'How Pharma can thoroughly optimize and improve clinical asset development.', image: c },
    { tag: 'Report', title: 'Energy transition outlook', text: 'What the next decade holds for European utilities.', image: d },
    { tag: 'Study', title: 'Industrial resilience 2030', text: 'Supply chains are being rebuilt around resilience.', image: e, wide: true },
    { tag: 'Blog post', title: 'Agri-food value chains', text: 'Where value is shifting in food and agriculture.', image: f },
  ],
  loadMore = 'Load more',
  viewAll = 'View all',
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-16 lg:px-[86px] lg:py-20">
  <hr class="border-neutral-300" />
  <h2 class="mt-12 text-center font-serif text-4xl text-neutral-900 md:text-[42px]">{title}</h2>
  <div class="mt-8 flex flex-wrap items-center gap-4 text-sm">
    <span class="text-neutral-600">Filter by:</span>
    {filters.map((f) => <button type="button" class="font-semibold underline-offset-4 hover:underline">{f}</button>)}
  </div>
  <div class="mt-8 grid gap-8 md:grid-cols-4">
    {cards.map((cd) => (
      <a href={cd.href ?? '#'} class:list={['group block', cd.wide ? 'md:col-span-2' : 'md:col-span-1']}>
        <div class="aspect-[16/10] overflow-hidden bg-neutral-100">
          <Image src={cd.image} alt="" widths={[480, 768]} sizes="(min-width: 768px) 33vw, 100vw" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
        </div>
        <p class="mt-4 text-[11px] text-neutral-600">{cd.tag}</p>
        <h3 class="mt-2 font-serif text-2xl leading-snug text-neutral-900 group-hover:underline">{cd.title}</h3>
        <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-neutral-700">{cd.text}</p>
      </a>
    ))}
  </div>
  <div class="mt-12 flex flex-wrap items-center gap-6">
    <button type="button" class="bg-neutral-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-neutral-700">{loadMore}</button>
    <a href="#" class="inline-flex items-center gap-2 text-sm font-semibold underline-offset-4 hover:underline">{viewAll}<span aria-hidden="true">↗</span></a>
  </div>
</section>
