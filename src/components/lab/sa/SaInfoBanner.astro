---
/**
 * SaInfoBanner — full-width grey link banner: round icon, small overline,
 * bold title, chevron on the right. ("Information for applicants /
 * Recruiting FAQs", "Büyümeye Uygunluk (Fit for Growth)").
 */
interface Props { overline?: string; title?: string; href?: string }
const { overline = 'Information for applicants', title = 'Recruiting FAQs', href = '#' } = Astro.props;
---
<a href={href} class="group block bg-neutral-100 transition hover:bg-neutral-200">
  <div class="mx-auto flex max-w-[1512px] items-center gap-6 px-6 py-10 lg:px-[86px]">
    <span class="grid h-[60px] w-[60px] shrink-0 place-items-center rounded-full bg-neutral-900 text-white" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-5M12 8h.01"/></svg>
    </span>
    <span class="min-w-0 flex-1">
      <span class="block text-base text-neutral-700">{overline}</span>
      <span class="block text-2xl font-semibold text-neutral-900 md:text-[28px]">{title}</span>
    </span>
    <span class="text-2xl text-neutral-500 transition group-hover:translate-x-1" aria-hidden="true">›</span>
  </div>
</a>
