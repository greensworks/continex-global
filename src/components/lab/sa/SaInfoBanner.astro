---
/**
 * SaInfoBanner — full-width grey link banner: round 60px image, small
 * overline, bold title, chevron on the right. ("Information for applicants /
 * Recruiting FAQs", "Büyümeye Uygunluk (Fit for Growth)").
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultImg from '@assets/images/portrait-woman-blue.webp';

interface Props { overline?: string; title?: string; href?: string; image?: ImageMetadata }
const { overline = 'Information for applicants', title = 'Recruiting FAQs', href = '#', image = defaultImg } = Astro.props;
---
<a href={href} class="group block bg-neutral-100 transition hover:bg-neutral-200">
  <div class="mx-auto flex max-w-[1512px] items-center gap-6 px-6 py-10 lg:px-[86px]">
    <span class="h-[60px] w-[60px] shrink-0 overflow-hidden rounded-full bg-neutral-300">
      <Image src={image} alt="" width={120} height={120} layout="none" class="h-full w-full object-cover" />
    </span>
    <span class="min-w-0 flex-1">
      <span class="block text-base text-neutral-700">{overline}</span>
      <span class="block text-2xl font-semibold text-neutral-900 md:text-[28px]">{title}</span>
    </span>
    <span class="text-2xl text-neutral-500 transition group-hover:translate-x-1" aria-hidden="true">›</span>
  </div>
</a>
