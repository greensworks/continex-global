---
/**
 * SaInPageNav — sticky "Navigation" bar with anchor links to the page's
 * sections. Collapses into a disclosure on small screens.
 */
interface Props { label?: string; links?: { label: string; href: string }[] }
const {
  label = 'Navigation',
  links = [
    { label: 'Strategy, made real', href: '#' }, { label: 'How we help you succeed', href: '#' }, { label: 'FAQ', href: '#' },
    { label: 'Publications', href: '#' }, { label: 'Careers', href: '#' }, { label: 'Contact us', href: '#' },
  ],
} = Astro.props;
---
<div class="sticky top-0 z-30 border-b border-neutral-200 bg-white/95 backdrop-blur">
  <details class="group mx-auto max-w-[1512px] px-6 lg:px-8">
    <summary class="flex cursor-pointer list-none items-center justify-between py-3 text-[15px] font-semibold marker:hidden">
      {label}
      <svg class="transition group-open:rotate-180" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
    </summary>
    <nav class="flex flex-wrap gap-x-8 gap-y-2 pb-4 text-[15px]" aria-label="In page">
      {links.map((l) => <a href={l.href} class="py-1 underline-offset-8 hover:underline">{l.label}</a>)}
    </nav>
  </details>
</div>
