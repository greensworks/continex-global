---
/**
 * SaStatIntro — serif heading + paragraph on the left, one large statistic
 * with caption and an arrow link on the right. Optional top rule.
 * Used for "Strategy, made real" and "Join the Strategy& team".
 */
interface Props { title?: string; text?: string; stat?: string; caption?: string; link?: { label: string; href: string }; rule?: boolean }
const {
  title = 'Strategy, made real',
  text = 'We help leading companies around the world develop distinctive capabilities and sustain a competitive advantage. Explore our services and get to know the Strategy& consulting teams.',
  stat = '40+',
  caption = 'years in the Netherlands',
  link = { label: 'Explore our legacy', href: '#' },
  rule = false,
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-16 lg:px-[86px] lg:py-20">
  {rule && <hr class="mb-14 border-neutral-300" />}
  <div class="grid gap-12 lg:grid-cols-[900px_1fr] lg:gap-20">
    <div>
      <h2 class="font-serif text-4xl leading-tight text-neutral-900 md:text-[42px]">{title}</h2>
      <p class="mt-6 text-base leading-relaxed text-neutral-700 md:text-lg">{text}</p>
    </div>
    <div class="lg:pt-2">
      <p class="font-serif text-6xl text-neutral-900 md:text-7xl">{stat}</p>
      <p class="mt-2 max-w-[272px] text-lg leading-snug text-neutral-700">{caption}</p>
      {link && <a href={link.href} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-neutral-900 underline-offset-4 hover:underline">{link.label}<span aria-hidden="true">›</span></a>}
    </div>
  </div>
</section>
