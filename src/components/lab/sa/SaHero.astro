---
/**
 * SaHero — dark photographic hero with serif headline, paragraph, outlined
 * white button and a huge translucent ampersand watermark on the right.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultImg from '@assets/images/meeting-table.webp';

interface Props { image?: ImageMetadata; title?: string; text?: string; cta?: { label: string; href: string }; watermark?: string }
const {
  image = defaultImg,
  title = 'We are Strategy& – the global strategy consultancy of PwC',
  text = 'From strategy to execution, we empower our clients to be visionary in their ambitions, and pragmatic in their realization.',
  cta = { label: 'Get to know us', href: '#' },
  watermark = '&',
} = Astro.props;
---
<section class="relative isolate min-h-[539px] overflow-hidden bg-neutral-900 text-white">
  <Image src={image} alt="" widths={[768, 1280, 1920]} sizes="100vw" layout="none" class="absolute inset-0 -z-20 h-full w-full object-cover grayscale-[40%]" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/85 via-black/65 to-black/30" aria-hidden="true"></div>
  {watermark && <span class="pointer-events-none absolute -right-8 bottom-[-12%] select-none font-serif text-[28rem] leading-none text-white/15" aria-hidden="true">{watermark}</span>}
  <div class="mx-auto flex min-h-[539px] max-w-[1512px] items-center px-6 py-24 lg:px-[86px]">
    <div class="max-w-[1041px]">
      <h1 class="font-serif text-4xl leading-tight md:text-[44px] md:leading-[52px]">{title}</h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-white/90 md:text-lg">{text}</p>
      {cta && <a href={cta.href} class="mt-8 inline-flex items-center gap-3 border border-white px-6 py-3 text-sm font-semibold transition hover:bg-white hover:text-black">{cta.label}<span aria-hidden="true">›</span></a>}
    </div>
  </div>
</section>
