---
/**
 * SaStories — "Stories": heading + intro, then stacked story entries
 * (title + excerpt) separated by rules, and an arrow link.
 */
interface Story { title: string; text: string; href?: string }
interface Props { title?: string; text?: string; stories?: Story[]; link?: { label: string; href: string } }
const {
  title = 'Stories',
  text = 'The best way to learn more about Strategy& is from the people who work here.',
  stories = [
    { title: 'From graduate to project lead in three years', text: 'Sophie shares how early responsibility and coaching shaped her path.' },
    { title: 'Why I chose strategy consulting after engineering', text: 'Daan on bringing an engineer’s mindset to boardroom questions.' },
    { title: 'Working across borders: a year in Munich', text: 'A secondment gave Noor a new network and a new perspective on the energy transition.' },
    { title: 'Balancing an MBA and client work', text: 'How the firm supported Lars through a part-time programme.' },
  ],
  link = { label: 'Read more stories', href: '#' },
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-16 lg:px-[86px] lg:py-20">
  <div class="max-w-[883px]">
    <h2 class="font-serif text-3xl leading-tight text-neutral-900 md:text-[36px]">{title}</h2>
    <p class="mt-5 text-base leading-relaxed text-neutral-700 md:text-lg">{text}</p>
    <ul class="mt-10 divide-y divide-neutral-300 border-t border-neutral-300">
      {stories.map((s) => (
        <li class="py-7">
          <a href={s.href ?? '#'} class="group block">
            <h3 class="text-xl font-semibold text-neutral-900 group-hover:underline">{s.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-neutral-700">{s.text}</p>
          </a>
        </li>
      ))}
    </ul>
    {link && <a href={link.href} class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-neutral-900 underline-offset-4 hover:underline">{link.label}<span aria-hidden="true">›</span></a>}
  </div>
</section>
