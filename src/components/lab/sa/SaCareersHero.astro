---
/**
 * SaCareersHero — two-link top bar ("Explore our job opportunities |
 * Explore our recruitment events"), then a light hero: big serif ampersand,
 * oversized "Careers" title, tagline and paragraph.
 */
interface Props { bar?: { label: string; href: string }[]; title?: string; tagline?: string; text?: string }
const {
  bar = [{ label: 'Explore our job opportunities', href: '#' }, { label: 'Explore our recruitment events', href: '#' }],
  title = 'Careers',
  tagline = 'Solve the most challenging problems. Shape your future.',
  text = 'From the day you join Strategy&, you will work on the questions that matter most to leading organisations, alongside people who care about your development.',
} = Astro.props;
---
<section>
  <div class="grid border-y border-neutral-200 md:grid-cols-2">
    {bar.map((b, i) => (
      <a href={b.href} class:list={['flex items-center justify-between px-6 py-4 text-[15px] font-semibold text-neutral-900 transition hover:bg-neutral-50 lg:px-[86px]', i > 0 && 'border-t border-neutral-200 md:border-l md:border-t-0']}>{b.label}<span aria-hidden="true">›</span></a>
    ))}
  </div>
  <div class="mx-auto max-w-[1512px] px-6 py-20 lg:px-[86px] lg:py-28">
    <div class="flex items-end gap-8">
      <span class="font-serif text-[120px] leading-none text-neutral-900 md:text-[139px]" aria-hidden="true">&amp;</span>
      <h1 class="font-serif text-6xl leading-none text-neutral-900 md:text-[112px]">{title}</h1>
    </div>
    <p class="mt-12 max-w-[640px] font-serif text-3xl leading-snug text-neutral-900 md:text-[36px]">{tagline}</p>
    <p class="mt-6 max-w-[640px] text-base leading-relaxed text-neutral-700 md:text-lg">{text}</p>
  </div>
</section>
