---
/**
 * SaTeamContacts — "Amsterdam Recruiting Team": heading, intro, then
 * square portraits (305×305) with name, role, contact link and LinkedIn.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import p1 from '@assets/images/portrait-woman-blue.webp';
import p2 from '@assets/images/portrait-woman-phone.webp';

interface Member { name: string; role: string; image: ImageMetadata; email?: string; linkedin?: string }
interface Props { title?: string; text?: string; members?: Member[]; contactLabel?: string }
const {
  title = 'Amsterdam Recruiting Team',
  text = 'Thank you for your interest in Strategy&. The Amsterdam recruiting team is happy to answer your questions about vacancies, events and the application process.',
  members = [
    { name: 'Kelly Zoethout', role: 'Recruitment Lead, Strategy& Netherlands', image: p1, email: '#', linkedin: '#' },
    { name: 'Dionne Krol', role: 'Event and Branding Recruiter, Strategy& Netherlands', image: p2, email: '#', linkedin: '#' },
  ],
  contactLabel = 'Contact',
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-16 lg:px-[86px] lg:py-20">
  <h2 class="font-serif text-3xl leading-tight text-neutral-900 md:text-[36px]">{title}</h2>
  <p class="mt-5 max-w-[864px] text-base leading-relaxed text-neutral-700 md:text-lg">{text}</p>
  <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    {members.map((m) => (
      <div class="max-w-[305px]">
        <div class="aspect-square overflow-hidden bg-neutral-100">
          <Image src={m.image} alt={m.name} width={610} height={610} layout="none" class="h-full w-full object-cover" />
        </div>
        <p class="mt-4 text-lg font-semibold text-neutral-900">{m.name}</p>
        <p class="mt-1 text-sm leading-snug text-neutral-700">{m.role}</p>
        <div class="mt-4 flex items-center gap-5 text-sm">
          {m.email && <a href={m.email} class="inline-flex items-center gap-2 font-semibold underline-offset-4 hover:underline"><svg width="18" height="14" viewBox="0 0 24 18" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="1" width="22" height="16" rx="2"/><path d="m1 3 11 8 11-8"/></svg>{contactLabel}</a>}
          {m.linkedin && <a href={m.linkedin} aria-label={`LinkedIn ${m.name}`} class="grid h-7 w-7 place-items-center bg-neutral-900 text-white"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6.5 8.5v9M6.5 5.5v.01M10.5 17.5v-5a2.5 2.5 0 0 1 5 0v5M10.5 8.5v9"/></svg></a>}
        </div>
      </div>
    ))}
  </div>
</section>
