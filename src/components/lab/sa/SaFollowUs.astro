---
/**
 * SaFollowUs — slim "Follow us" row with icon + label social links.
 */
interface Props { title?: string; links?: { label: string; href: string; icon: 'linkedin' | 'instagram' | 'x' | 'youtube' }[] }
const { title = 'Follow us', links = [{ label: 'LinkedIn', href: '#', icon: 'linkedin' }, { label: 'Instagram', href: '#', icon: 'instagram' }] } = Astro.props;
const icons = {
  linkedin: '<path d="M6.5 8.5v9M6.5 5.5v.01M10.5 17.5v-5a2.5 2.5 0 0 1 5 0v5M10.5 8.5v9"/>',
  instagram: '<rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.5"/><path d="M17 7v.01"/>',
  x: '<path d="m5 5 14 14M19 5 5 19"/>',
  youtube: '<rect x="3" y="6" width="18" height="12" rx="3"/><path d="m10 9 5 3-5 3z"/>',
};
---
<section class="mx-auto flex max-w-[1512px] flex-wrap items-center gap-8 px-6 py-8 lg:px-[86px]">
  <h2 class="text-base font-semibold text-neutral-900">{title}</h2>
  {links.map((l) => (
    <a href={l.href} class="inline-flex items-center gap-2 text-sm text-neutral-800 underline-offset-4 hover:underline">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[l.icon]} />{l.label}
    </a>
  ))}
</section>
