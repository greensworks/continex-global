---
/**
 * SaPeopleStrip — "Meet our people": heading, three 416×227 photo cards with
 * name + role overlay, and an arrow link.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import p1 from '@assets/images/portrait-woman-blue.webp';
import p2 from '@assets/images/woman-tablet.webp';
import p3 from '@assets/images/portrait-woman-phone.webp';

interface Person { name: string; role: string; image: ImageMetadata; href?: string }
interface Props { title?: string; people?: Person[]; link?: { label: string; href: string } }
const {
  title = 'Meet our people',
  people = [
    { name: 'Sophie de Vries', role: 'Senior Associate', image: p1 },
    { name: 'Daan Bakker', role: 'Manager', image: p2 },
    { name: 'Noor Jansen', role: 'Director', image: p3 },
  ],
  link = { label: 'Meet all people', href: '#' },
} = Astro.props;
---
<section class="mx-auto max-w-[1512px] px-6 py-16 lg:px-[86px] lg:py-20">
  <h2 class="font-serif text-3xl leading-tight text-neutral-900 md:text-[36px]">{title}</h2>
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {people.map((p) => (
      <a href={p.href ?? '#'} class="group relative block aspect-[416/227] overflow-hidden bg-neutral-900 text-white">
        <Image src={p.image} alt={p.name} widths={[416, 832]} sizes="(min-width: 768px) 33vw, 100vw" layout="none" class="h-full w-full object-cover opacity-90 transition duration-500 group-hover:scale-[1.03]" />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-5">
          <p class="font-semibold">{p.name}</p>
          <p class="text-sm text-white/80">{p.role}</p>
        </div>
      </a>
    ))}
  </div>
  {link && <a href={link.href} class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-neutral-900 underline-offset-4 hover:underline">{link.label}<span aria-hidden="true">›</span></a>}
</section>
