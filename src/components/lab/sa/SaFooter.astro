---
/**
 * SaFooter — light grey PwC-style footer: breadcrumb, either a single link
 * row (`links`) or multi-column link groups (`columns`), then the PwC mark,
 * copyright and legal links.
 */
interface Group { title: string; href?: string; items: { label: string; href: string; external?: boolean }[] }
interface Props {
  breadcrumb?: { label: string; href?: string }[];
  links?: { label: string; href: string }[];
  columns?: Group[];
  copyright?: string;
  legal?: { label: string; href: string }[];
}
const {
  breadcrumb = [{ label: 'Strategy& NL', href: '#' }],
  links = ['About Strategy&', 'Industries', 'Functions', 'Solutions', 'Publications', 'Careers', 'Contact', 'Sitemap'].map((l) => ({ label: l, href: '#' })),
  columns = [],
  copyright = '© 2019 - 2026 PwC. All rights reserved. PwC refers to the PwC network and/or one or more of its member firms, each of which is a separate legal entity.',
  legal = ['Privacy statement', 'Legal disclaimer', 'Terms of use', 'About site provider', 'Cookies info'].map((l) => ({ label: l, href: '#' })),
} = Astro.props;
---
<footer class="bg-neutral-100 text-neutral-800">
  <div class="mx-auto max-w-[1512px] px-6 py-10 lg:px-[86px]">
    <nav class="flex flex-wrap gap-2 text-xs text-neutral-600" aria-label="Breadcrumb">
      {breadcrumb.map((b, i) => <span class="flex gap-2">{i > 0 && <span>›</span>}{b.href ? <a href={b.href} class="hover:underline">{b.label}</a> : b.label}</span>)}
    </nav>

    {columns.length > 0 ? (
      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-6">
        {columns.map((g) => (
          <div>
            <a href={g.href ?? '#'} class="text-sm font-semibold text-neutral-900 hover:underline">{g.title}</a>
            <ul class="mt-3 space-y-2 text-[13px]">
              {g.items.map((it) => <li><a href={it.href} class="hover:underline">{it.label}{it.external && <span class="ml-1 text-[10px]" aria-hidden="true">↗</span>}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    ) : (
      <nav class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm" aria-label="Footer">
        {links.map((l) => <a href={l.href} class="hover:underline">{l.label}</a>)}
      </nav>
    )}

    <div class="mt-10 grid gap-6 border-t border-neutral-300 pt-8 md:grid-cols-[135px_1fr]">
      <a href="#" class="font-sans text-2xl font-bold tracking-tight text-neutral-900" aria-label="PwC">pwc</a>
      <div class="text-xs leading-relaxed text-neutral-600">
        <p>{copyright}</p>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
          {legal.map((l) => <li><a href={l.href} class="hover:underline">{l.label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</footer>
