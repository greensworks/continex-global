---
/**
 * Header (RB pattern): a white meta strip with secondary links and the
 * language switch, above an inset navy bar carrying the logo, the primary
 * nav and a hanging CTA tag. theme="dark" lets a hero run behind the bar.
 */
import { Image } from 'astro:assets';
import logoWhite from '@assets/logos/continex-global-logo-white.png';
import { getLocale, localizePath, switchLocalePath, stripLocale } from '@i18n/utils';
import { locales, localeLabels } from '@i18n/config';
import { useTranslations } from '@i18n/ui';
import { primaryNav, ctaHref } from '@data/nav';

import type { Locale } from '@i18n/config';

interface Props { localePaths?: Partial<Record<Locale, string>>; theme?: 'dark' | 'light' }
const { localePaths, theme = 'light' } = Astro.props;

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname);
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href + '/'));
const metaKeys = ['nav.about', 'nav.insights', 'nav.contact'] as const;
const metaHref: Record<string, string> = { 'nav.about': '/about', 'nav.insights': '/insights', 'nav.contact': '/contact' };
---
<header id="site-header" data-theme={theme} class="fixed inset-x-0 top-0 z-50">
  <div class="bg-white">
    <div class="container-site flex h-10 items-center justify-between gap-6 text-[11px] font-medium tracking-wide text-navy-900">
      <nav aria-label="Secondary" class="hidden items-center gap-6 md:flex">
        {metaKeys.map((k) => <a href={localizePath(metaHref[k], locale)} class="transition hover:underline underline-offset-4">{t(k)}</a>)}
      </nav>
      <div class="flex items-center gap-2" aria-label={t('a11y.switchLang')}>
        {locales.map((l, i) => (
          <>
            {i > 0 && <span class="opacity-40" aria-hidden="true">|</span>}
            <a href={localePaths?.[l] ?? switchLocalePath(Astro.url.pathname, l)} hreflang={l} aria-current={l === locale ? 'true' : undefined} class:list={['transition', l === locale ? 'font-bold' : 'opacity-50 hover:opacity-100']}>{localeLabels[l]}</a>
          </>
        ))}
      </div>
    </div>
  </div>

  <div class="bg-navy-900">
    <div class="container-site relative flex h-16 items-center justify-between gap-6 text-white md:h-20">
      <a href={localizePath('/', locale)} class="brand-optical block shrink-0" aria-label="Continex Global">
        <Image src={logoWhite} alt="Continex Global" width={180} densities={[1, 2]} class="h-8 w-auto lg:h-9" loading="eager" />
      </a>

      <nav class="hidden items-center gap-6 text-[15px] xl:flex 2xl:gap-8" aria-label="Primary">
        {primaryNav.map((item) => (
          <a
            href={localizePath(item.href, locale)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="relative whitespace-nowrap py-2 transition after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:scale-x-0 after:bg-white after:transition-transform hover:after:scale-x-100 aria-[current=page]:after:scale-x-100"
          >{t(item.key)}</a>
        ))}
      </nav>

      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center xl:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t('a11y.openMenu')}
        data-menu-toggle
      >
        <span class="relative block h-3.5 w-6">
          <span class="absolute inset-x-0 top-0 h-0.5 bg-current transition-transform duration-300 [[aria-expanded=true]_&]:translate-y-1.5 [[aria-expanded=true]_&]:rotate-45"></span>
          <span class="absolute inset-x-0 bottom-0 h-0.5 bg-current transition-transform duration-300 [[aria-expanded=true]_&]:-translate-y-1.5 [[aria-expanded=true]_&]:-rotate-45"></span>
        </span>
      </button>

      <a
        href={localizePath(ctaHref, locale)}
        class="absolute -bottom-3.5 right-4 bg-accent-600 px-3 py-1.5 text-[11px] font-semibold text-white transition hover:bg-accent-500 md:right-8 lg:hidden"
      >{t('cta.discuss')}</a>
    </div>
  </div>

  <div id="mobile-menu" hidden class="container-site xl:hidden">
    <nav class="max-h-[calc(100dvh-160px)] overflow-y-auto bg-white px-5 pb-6 pt-4 text-navy-900 shadow-[0_1px_0_0_var(--color-line)]" aria-label="Mobile">
      <ul class="flex flex-col divide-y divide-line text-lg font-medium">
        {primaryNav.map((item) => (
          <li><a href={localizePath(item.href, locale)} class="block py-3.5">{t(item.key)}</a></li>
        ))}
      </ul>
      <a href={localizePath(ctaHref, locale)} class="mt-6 inline-flex w-full items-center justify-center bg-accent-600 px-4 py-3 font-semibold text-white">{t('cta.discuss')}</a>
    </nav>
  </div>
</header>
{/* Spacer for pages without a hero running behind the bar. */}
{theme === 'light' && <div class="h-[104px] md:h-[120px]" aria-hidden="true"></div>}

<script>
  const header = document.getElementById('site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.getElementById('mobile-menu')!;

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  });
</script>
