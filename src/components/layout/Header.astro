---
/**
 * Two headers: "classic" (transparent bar over the homepage hero, turning
 * solid white on scroll) and "bar" (RB pattern: white meta strip over a
 * full-bleed navy bar) for the inner pages.
 */
import HeaderClassic from './HeaderClassic.astro';
import HeaderBar from './HeaderBar.astro';

import type { Locale } from '@i18n/config';

interface Props { localePaths?: Partial<Record<Locale, string>>; theme?: 'dark' | 'light'; variant?: 'classic' | 'bar' }
const { localePaths, theme = 'light', variant = 'bar' } = Astro.props;
---
{variant === 'classic' ? <HeaderClassic theme={theme} localePaths={localePaths} /> : <HeaderBar theme={theme} localePaths={localePaths} />}
