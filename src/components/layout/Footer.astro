---
/**
 * Footer on light grey: breadcrumb row, link columns, then the logo,
 * copyright and legal links under a hairline (PwC/Strategy& pattern).
 */
import { Image } from 'astro:assets';
import logo from '@assets/logos/continex-global-logo.png';
import { getLocale, localizePath, t as pick } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import { ctaHref } from '@data/nav';
import { services } from '@data/services';
import { industries } from '@data/industries';
import { site } from '@data/site';
import { developer } from '@data/developer';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const year = new Date().getFullYear();
const columns = [
  {
    title: t('nav.whatWeDo'),
    href: localizePath('/what-we-do', locale),
    items: services.map((s) => ({ label: pick(s.title, locale), href: localizePath(`/what-we-do#${s.slug}`, locale) })),
  },
  {
    title: t('nav.industries'),
    href: localizePath('/industries', locale),
    items: industries.map((i) => ({ label: pick(i.title, locale), href: localizePath(`/industries#${i.slug}`, locale) })),
  },
  {
    title: site.name,
    href: localizePath('/about', locale),
    items: [
      { label: t('nav.about'), href: localizePath('/about', locale) },
      { label: t('nav.markets'), href: localizePath('/markets', locale) },
      { label: t('nav.experience'), href: localizePath('/selected-experience', locale) },
      { label: t('nav.insights'), href: localizePath('/insights', locale) },
      { label: t('nav.contact'), href: localizePath('/contact', locale) },
    ],
  },
];
const legal = [
  { label: t('footer.privacy'), href: localizePath('/privacy-policy', locale) },
  { label: t('footer.cookies'), href: localizePath('/cookie-policy', locale) },
  { label: t('footer.terms'), href: localizePath('/terms-and-conditions', locale) },
];
---
<footer class="bg-surface-alt text-ink-700">
  <div class="container-site py-10 lg:py-14">
    <nav class="flex flex-wrap gap-2 text-xs text-ink-500" aria-label="Breadcrumb">
      <a href={localizePath('/', locale)} class="hover:underline underline-offset-4">{site.name}</a>
      <span aria-hidden="true">›</span>
      <span>{pick(site.tagline, locale)}</span>
    </nav>

    <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {columns.map((g) => (
        <div>
          <a href={g.href} class="text-sm font-semibold text-navy-900 hover:underline underline-offset-4">{g.title}</a>
          <ul class="mt-3 space-y-2 text-[13px]">
            {g.items.map((it) => <li><a href={it.href} class="hover:underline underline-offset-4">{it.label}</a></li>)}
          </ul>
        </div>
      ))}

      <div>
        <a href={localizePath('/contact', locale)} class="text-sm font-semibold text-navy-900 hover:underline underline-offset-4">{t('nav.contact')}</a>
        <address class="mt-3 text-[13px] not-italic leading-relaxed">
          {site.address.lines.map((l) => <span class="block">{l}</span>)}
        </address>
        {site.email && <a href={`mailto:${site.email}`} class="mt-3 block text-[13px] hover:underline underline-offset-4">{site.email}</a>}
        {site.phone && <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="block text-[13px] hover:underline underline-offset-4">{site.phone}{site.phoneExt && ` · ${locale === 'tr' ? 'dahili' : 'ext.'} ${site.phoneExt}`}</a>}
        <a href={localizePath(ctaHref, locale)} class="mt-5 inline-flex items-center bg-navy-900 px-4 py-2.5 text-[13px] font-semibold text-white transition hover:bg-navy-800">{t('cta.discuss')}</a>
      </div>
    </div>

    <div class="mt-10 grid gap-6 border-t border-line pt-8 md:grid-cols-[180px_1fr] md:items-center">
      <a href={localizePath('/', locale)} aria-label={site.name}>
        <Image src={logo} alt={site.name} width={200} densities={[1, 2]} class="h-8 w-auto" />
      </a>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs leading-relaxed text-ink-500 md:justify-end">
        <p>&copy; {year} {site.legalName} {t('footer.rights')}</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {legal.map((l) => <li><a href={l.href} class="hover:underline underline-offset-4">{l.label}</a></li>)}
        </ul>
        <p class="w-full pt-1 text-[11px] md:text-right">
          {locale === 'tr' ? 'Web geliştirme' : 'Web development'}
          <span class="mx-1.5" aria-hidden="true">·</span>
          <a href={developer.url} class="font-medium text-ink-700 underline-offset-4 transition-colors hover:text-accent-600 hover:underline">{developer.name}</a>
        </p>
      </div>
    </div>
  </div>
</footer>
