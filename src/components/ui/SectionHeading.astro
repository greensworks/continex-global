---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  as?: 'h1' | 'h2';
  class?: string;
}
const { eyebrow, title, lead, align = 'left', tone = 'light', as: Tag = 'h2', class: cls = '' } = Astro.props;
---
<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center', cls]} data-reveal>
  {eyebrow && <p class:list={['eyebrow', tone === 'dark' && 'text-steel-300']}>{eyebrow}</p>}
  <Tag class:list={['mt-4 text-h2', tone === 'dark' && 'text-white']}>{title}</Tag>
  {lead && <p class:list={['mt-5 text-lead', tone === 'dark' ? 'text-white/70' : 'text-ink-500']}>{lead}</p>}
</div>
