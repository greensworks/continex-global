---
interface Props { name: 'access' | 'local' | 'network' | 'target'; class?: string }
const { name, class: className = '' } = Astro.props;
---
<svg class={className} width="36" height="36" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'access' && <><circle cx="12" cy="9" r="4"/><path d="M4 26v-3a8 8 0 0 1 16 0v3M23 6a4 4 0 0 1 0 8m1 5a6 6 0 0 1 4 6v1"/></>}
  {name === 'local' && <><path d="M25 13c0 7-9 15-9 15S7 20 7 13a9 9 0 1 1 18 0Z"/><circle cx="16" cy="13" r="3"/></>}
  {name === 'network' && <><circle cx="16" cy="16" r="4"/><circle cx="6" cy="6" r="2.5"/><circle cx="26" cy="6" r="2.5"/><circle cx="6" cy="26" r="2.5"/><circle cx="26" cy="26" r="2.5"/><path d="m8 8 5 5m6 6 5 5M24 8l-5 5M13 19l-5 5"/></>}
  {name === 'target' && <><circle cx="16" cy="16" r="12"/><circle cx="16" cy="16" r="7"/><path d="m12 16 3 3 6-7"/></>}
</svg>
