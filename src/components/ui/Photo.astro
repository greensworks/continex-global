---
import { getImage, type LocalImageProps } from 'astro:assets';
import type { ImageMetadata } from 'astro';
type Props = Omit<LocalImageProps, 'src' | 'densities'> & { src: ImageMetadata };
const { src, widths = [480, 768, 1200, 1536], quality = 82, loading = 'lazy', ...rest } = Astro.props;
// Never upscale a small source. Include its native width when a larger
// candidate was requested, so high-density screens get all available detail.
const candidates = [...new Set(widths.map((width) => Math.min(width, src.width)))].sort((a, b) => a - b);
// AVIF and WebP quality scales differ. Use a format-specific setting to
// preserve detail without sending near-lossless AVIF files to every visitor.
const options = {
  ...rest, src, widths: candidates, loading, decoding: 'async', layout: 'none' as const,
  width: rest.width === undefined ? undefined : Number(rest.width),
  height: rest.height === undefined ? undefined : Number(rest.height),
};
const [avif, webp] = await Promise.all([
  getImage({ ...options, format: 'avif', quality: 60 }),
  getImage({ ...options, format: 'webp', quality }),
]);
---
<picture style="display: contents">
  <source type="image/avif" srcset={avif.srcSet.attribute} sizes={rest.sizes} />
  <img {...webp.attributes} src={webp.src} srcset={webp.srcSet.attribute} sizes={rest.sizes} />
</picture>
