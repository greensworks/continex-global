---
import { getLangFromUrl, localizePath } from '../i18n';

const currentLang = getLangFromUrl(Astro.url);
const cookiePath = localizePath('/cookie-policy.html', currentLang);
const privacyPath = localizePath('/privacy-policy.html', currentLang);
---

<div
  id="cx-cookie-consent"
  class="cx-cookie-consent"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie consent"
  hidden
>
  <div class="cx-cookie-consent__inner">
    <div class="cx-cookie-consent__copy">
      <p class="cx-cookie-consent__title">We use cookies</p>
      <p class="cx-cookie-consent__text">
        Essential cookies keep this site working. Optional analytics and tracking cookies run only with your consent.
        Read our <a href={cookiePath}>Cookie Policy</a> and <a href={privacyPath}>Privacy Policy</a>.
      </p>
    </div>
    <div class="cx-cookie-consent__actions">
      <button type="button" class="cx-cookie-consent__btn cx-cookie-consent__btn--ghost" data-cookie-action="reject">
        Reject optional
      </button>
      <button type="button" class="cx-cookie-consent__btn cx-cookie-consent__btn--solid" data-cookie-action="accept">
        Accept all
      </button>
    </div>
  </div>
</div>

<style is:global>
  .cx-cookie-consent {
    position: fixed;
    right: 20px;
    bottom: 20px;
    left: 20px;
    z-index: 99999;
    max-width: 720px;
    margin-inline: auto;
    padding: 22px 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    background: #183457;
    color: #fff;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
  }

  .cx-cookie-consent[hidden] {
    display: none !important;
  }

  .cx-cookie-consent__inner {
    display: flex;
    gap: 20px;
    align-items: flex-end;
    justify-content: space-between;
  }

  .cx-cookie-consent__title {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.18px;
    color: #fff;
  }

  .cx-cookie-consent__text {
    margin: 0;
    max-width: 46ch;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
  }

  .cx-cookie-consent__text a {
    color: #9FC2D8;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cx-cookie-consent__actions {
    display: flex;
    flex-shrink: 0;
    gap: 10px;
  }

  .cx-cookie-consent__btn {
    min-width: 132px;
    padding: 11px 16px;
    border-radius: 4px;
    border: 1px solid transparent;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: opacity 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .cx-cookie-consent__btn:hover {
    opacity: 0.9;
  }

  .cx-cookie-consent__btn--ghost {
    color: #fff;
    background: transparent;
    border-color: rgba(255, 255, 255, 0.28);
  }

  .cx-cookie-consent__btn--solid {
    color: #183457;
    background: #9FC2D8;
  }

  @media (max-width: 767px) {
    .cx-cookie-consent {
      right: 12px;
      bottom: 12px;
      left: 12px;
      padding: 18px;
    }

    .cx-cookie-consent__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .cx-cookie-consent__actions {
      flex-direction: column;
    }

    .cx-cookie-consent__btn {
      width: 100%;
    }
  }
</style>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'cx_cookie_consent';
    const MAX_AGE_MS = 1000 * 60 * 60 * 24 * 365;

    const banner = document.getElementById('cx-cookie-consent');
    if (!banner) return;

    const readConsent = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return null;
        if (!parsed.timestamp || Date.now() - parsed.timestamp > MAX_AGE_MS) {
          localStorage.removeItem(STORAGE_KEY);
          return null;
        }
        return parsed;
      } catch {
        return null;
      }
    };

    const writeConsent = (status) => {
      const payload = {
        status,
        timestamp: Date.now(),
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      document.documentElement.dataset.cookieConsent = status;
      window.dispatchEvent(new CustomEvent('cx:cookie-consent', { detail: payload }));
    };

    const existing = readConsent();
    if (existing?.status) {
      document.documentElement.dataset.cookieConsent = existing.status;
      return;
    }

    banner.hidden = false;

    banner.querySelectorAll('[data-cookie-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const action = button.getAttribute('data-cookie-action');
        if (action !== 'accept' && action !== 'reject') return;
        writeConsent(action === 'accept' ? 'accepted' : 'rejected');
        banner.hidden = true;
      });
    });
  })();
</script>
