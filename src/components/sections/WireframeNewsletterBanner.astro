---
const {
  title = 'Stay close to cross-border opportunities.',
  text = 'Receive selected market notes, partnership insights, and Continex Global updates.',
  image = '/assets/img/general/insights.webp',
} = Astro.props;
---

<section class="cx-wire-newsletter">
  <img src={image} alt="">
  <div class="cx-wire-newsletter-overlay"></div>
  <div class="container">
    <div class="cx-wire-newsletter-content">
      <span class="tp-section-sub">Insights</span>
      <h2>{title}</h2>
      <p>{text}</p>
      <form class="cx-wire-newsletter-form">
        <input type="email" name="email" placeholder="Your email address">
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </div>
</section>

<style>
  .cx-wire-newsletter {
    position: relative;
    min-height: 460px;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: #222f30;
  }

  .cx-wire-newsletter > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cx-wire-newsletter-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10, 20, 22, 0.94), rgba(10, 20, 22, 0.52), rgba(10, 20, 22, 0.1));
  }

  .cx-wire-newsletter-content {
    position: relative;
    z-index: 1;
    max-width: 620px;
    padding: 90px 0;
  }

  .cx-wire-newsletter-content .tp-section-sub {
    color: #cef79e;
  }

  .cx-wire-newsletter-content h2 {
    color: #fff;
    font-size: 48px;
    line-height: 1.1;
    margin: 18px 0;
  }

  .cx-wire-newsletter-content p {
    color: rgba(255, 255, 255, 0.74);
    font-size: 17px;
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .cx-wire-newsletter-form {
    display: flex;
    gap: 12px;
    max-width: 520px;
  }

  .cx-wire-newsletter-form input {
    flex: 1;
    height: 58px;
    border: 0;
    border-radius: 6px;
    padding: 0 18px;
  }

  .cx-wire-newsletter-form button {
    height: 58px;
    border: 0;
    border-radius: 6px;
    padding: 0 24px;
    background: #cef79e;
    color: #222f30;
    font-weight: 700;
  }

  @media (max-width: 767px) {
    .cx-wire-newsletter-content h2 {
      font-size: 34px;
    }

    .cx-wire-newsletter-form {
      flex-direction: column;
    }
  }
</style>
