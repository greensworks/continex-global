---
/** Dark band: statement headline + four plain feature blocks, no icons. */
import { getLocale, t } from '@i18n/utils';
import { whyContinex } from '@data/home';
const locale = getLocale(Astro.url);
---
<section class="section bg-navy-950 text-white">
  <div class="container-site grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5" data-reveal>
      <p class="eyebrow text-steel-300">{t(whyContinex.eyebrow, locale)}</p>
      <h2 class="mt-4 text-h2 text-white" set:html={t(whyContinex.title, locale)} />
      <p class="mt-6 text-lead text-white/70">{t(whyContinex.lead, locale)}</p>
    </div>
    <div class="grid gap-px bg-white/10 sm:grid-cols-2 lg:col-span-7" data-reveal-group>
      {whyContinex.items.map((it) => (
        <div class="bg-navy-950 p-7">
          <h3 class="text-lg font-semibold text-white">{t(it.title, locale)}</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/65">{t(it.text, locale)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
