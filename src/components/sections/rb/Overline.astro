---
/** Centred section label with a short horizontal accent. */
interface Props { text: string; id?: string }
const { text, id } = Astro.props;
---
<div class="relative bg-surface pt-[var(--spacing-section)] pb-10 text-center" id={id}>
  <h2 class="eyebrow">{text}</h2>
  <span class="mx-auto mt-3 block h-px w-8 bg-accent-600" aria-hidden="true"></span>
</div>
