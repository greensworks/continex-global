---
/** Body copy aligned to the right half next to the centre guide line (follows GuideHeadline). Optional photo fills the empty left half. */
import Image from '@components/ui/Photo.astro';
import type { ImageMetadata } from 'astro';
interface Props { paragraphs: string[]; link?: { label: string; href: string }; image?: ImageMetadata; imageAlt?: string }
const { paragraphs, link, image, imageAlt = '' } = Astro.props;
---
<section class="bg-surface">
  <div class="container-site">
    <div class="grid md:grid-cols-2">
      <div class:list={['hidden md:block', image && 'relative md:min-h-[520px]']}>
        {image && (
          <div class="absolute inset-y-0 left-0 right-12 overflow-hidden" data-reveal>
            <Image src={image} alt={imageAlt} widths={[480, 768, 1200]} sizes="(min-width: 768px) 40vw, 100vw" layout="none" class="h-full w-full object-cover" />
          </div>
        )}
      </div>
      <div style="--guide-rise: 0px" class="guide-rule space-y-5 pb-[var(--spacing-section)] pl-6 text-[15px] leading-relaxed text-ink-700 md:pl-8 md:text-base">
        {paragraphs.map((p) => <p set:html={p} />)}
        {link && <p><a href={link.href} class="inline-flex items-center gap-2 text-sm font-semibold text-accent-600 hover:underline underline-offset-4">{link.label} →</a></p>}
      </div>
    </div>
  </div>
</section>
