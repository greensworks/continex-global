---
/**
 * Headline + body on the right half of the centre guide line, with a photo
 * filling the left half for the whole block. One section, so the guide line
 * runs unbroken from the top padding to the bottom of the copy.
 */
import Image from '@components/ui/Photo.astro';
import type { ImageMetadata } from 'astro';
interface Props { title: string; paragraphs: string[]; image?: ImageMetadata; imageAlt?: string; id?: string }
const { title, paragraphs, image, imageAlt = '', id } = Astro.props;
---
<section class="relative bg-surface pt-[var(--spacing-section)]" id={id}>
  <div class="container-site">
    <div class="grid md:grid-cols-2">
      <div class="hidden md:block">
        {image && (
          <div class="aspect-[3/2] overflow-hidden md:mr-12" data-reveal>
            <Image src={image} alt={imageAlt} widths={[480, 768, 1200]} sizes="(min-width: 768px) 40vw, 100vw" layout="none" class="h-full w-full object-cover" />
          </div>
        )}
      </div>
      <div class="guide-rule pb-[var(--spacing-section)] pl-6 md:pl-8">
        <h2 class="text-h2 max-w-xl" set:html={title} />
        <div class="mt-6 space-y-5 text-[15px] leading-relaxed text-ink-700 md:text-base">
          {paragraphs.map((p) => <p set:html={p} />)}
        </div>
      </div>
    </div>
  </div>
</section>
