---
/** RB media tiles in Continex navy: photo + white label chip, navy caption bar. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Tile { label: string; title: string; href: string; image?: ImageMetadata; text?: string }
interface Props { tiles: Tile[] }
const { tiles } = Astro.props;
---
<section class="bg-surface">
  <div class="container-site">
    <div class="grid grid-cols-1 gap-1 sm:grid-cols-2 md:grid-cols-3" data-reveal-group>
      {tiles.map((t) => (
        <a href={t.href} class="group flex flex-col bg-navy-900 text-white">
          <div class="relative aspect-[16/10] overflow-hidden bg-navy-950">
            {t.image && <Image src={t.image} alt="" widths={[480, 768]} sizes="(min-width: 768px) 33vw, 100vw" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />}
            <span class="absolute left-4 top-4 bg-white px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-navy-900">{t.label}</span>
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h3 class="text-[15px] font-semibold leading-snug text-white md:text-base">{t.title}</h3>
            {t.text && <p class="mt-2 text-[13px] leading-relaxed text-white/65">{t.text}</p>}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
