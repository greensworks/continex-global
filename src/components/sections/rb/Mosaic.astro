---
/**
 * Tile mosaic (RB tile grid, Continex palette). 6-column grid, hairline
 * gaps. span: full | half | third; layout: split (text left, image right)
 * or stacked. Description reveals on hover.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
export interface MosaicTile { label?: string; title: string; text?: string; href?: string; image: ImageMetadata; alt?: string; span?: 'full' | 'half' | 'third'; layout?: 'split' | 'stacked' }
interface Props { tiles: MosaicTile[] }
const { tiles } = Astro.props;
const spanCls = { full: 'md:col-span-6', half: 'md:col-span-3', third: 'md:col-span-2' };
---
<section class="bg-surface">
  <div class="container-site">
    <div class="grid grid-cols-1 gap-1 md:grid-cols-6" data-reveal-group>
      {tiles.map((t) => {
        const Tag = t.href ? 'a' : 'div';
        const split = t.layout === 'split';
        return (
          <Tag href={t.href} class:list={['group relative bg-surface-alt text-navy-900', spanCls[t.span ?? 'third'], split ? 'grid grid-cols-1 md:grid-cols-2' : 'block']}>
            {t.label && <span class="absolute left-4 top-4 z-10 bg-white px-2 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-navy-900">{t.label}</span>}
            {split ? (
              <>
                <div class="order-2 flex min-h-[220px] flex-col justify-end p-5 md:order-1 md:min-h-[300px] md:p-6">
                  <h3 class="text-h3">{t.title}</h3>
                  {t.text && <p class="mt-3 max-h-0 overflow-hidden text-sm leading-relaxed text-ink-500 opacity-0 transition-[max-height,opacity] duration-300 group-hover:max-h-40 group-hover:opacity-100">{t.text}</p>}
                </div>
                <div class="order-1 aspect-[16/10] overflow-hidden md:order-2 md:aspect-auto">
                  <Image src={t.image} alt={t.alt ?? ''} widths={[480, 768, 1200]} sizes="(min-width: 768px) 40vw, 100vw" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
                </div>
              </>
            ) : (
              <>
                <div class="aspect-[16/10] overflow-hidden">
                  <Image src={t.image} alt={t.alt ?? ''} widths={[480, 768]} sizes="(min-width: 768px) 33vw, 100vw" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
                </div>
                <div class="p-4 md:p-5">
                  <h3 class="text-[15px] font-semibold leading-snug md:text-base">{t.title}</h3>
                  {t.text && <p class="mt-2 max-h-0 overflow-hidden text-[13px] leading-relaxed text-ink-500 opacity-0 transition-[max-height,opacity] duration-300 group-hover:max-h-32 group-hover:opacity-100">{t.text}</p>}
                </div>
              </>
            )}
          </Tag>
        );
      })}
    </div>
  </div>
</section>
