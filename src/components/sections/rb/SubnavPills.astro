---
/** Pill sub-navigation row (RB), Continex colours. Anchors or links. */
interface Props { items: { label: string; href: string; active?: boolean }[] }
const { items } = Astro.props;
---
<nav class="border-b border-line bg-surface-alt" aria-label="Section">
  <ul class="container-site flex gap-2 overflow-x-auto py-4 [scrollbar-width:none] lg:justify-center [&::-webkit-scrollbar]:hidden">
    {items.map((it) => (
      <li class="shrink-0"><a href={it.href} class:list={['inline-block rounded-full border px-4 py-1.5 text-[13px] font-medium transition', it.active ? 'border-navy-900 bg-navy-900 text-white' : 'border-line bg-surface text-navy-900 hover:border-navy-900']}>{it.label}</a></li>
    ))}
  </ul>
</nav>
