---
/** Two compact CTA boxes side by side: short line of text, icon, button. */
import { getLocale, localizePath } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';

interface Box { text: string; cta: string; href: string; icon?: 'mail' | 'file' }
interface Props { boxes?: Box[] }
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const {
  boxes = [
    {
      text: locale === 'tr'
        ? 'Değerlendirdiğiniz pazarı, ortaklığı veya projeyi bizimle paylaşın.'
        : 'Tell us about the market, partnership or project you are considering.',
      cta: tr('cta.discuss'),
      href: localizePath('/contact', locale),
      icon: 'mail' as const,
    },
    {
      text: locale === 'tr'
        ? 'Sahadaki çalışmalarımızı ve ulaştığımız sonuçları inceleyin.'
        : 'See the mandates we run and the results they produced.',
      cta: tr('nav.experience'),
      href: localizePath('/selected-experience', locale),
      icon: 'file' as const,
    },
  ],
} = Astro.props;
---
<section class="bg-surface py-[var(--spacing-section)]">
  <div class="container-site grid gap-5 sm:grid-cols-2" data-reveal-group>
    {boxes.map((b) => (
      <div class="flex flex-wrap items-center gap-5 border border-line bg-surface-alt p-6">
        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white text-accent-600 shadow-sm" aria-hidden="true">
          {b.icon === 'file' ? (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
          ) : (
            <svg width="18" height="14" viewBox="0 0 24 18" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="1" width="22" height="16" rx="2"/><path d="m1 3 11 8 11-8"/></svg>
          )}
        </span>
        <p class="min-w-[12rem] flex-1 text-sm leading-relaxed text-ink-700">{b.text}</p>
        <a href={b.href} class="shrink-0 bg-navy-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-navy-800">{b.cta}</a>
      </div>
    ))}
  </div>
</section>
