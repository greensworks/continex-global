---
/** Editorial service overview with a separate introduction and capability grid. */
import Image from '@components/ui/Photo.astro';
import type { Service } from '@data/services';
import { getLocale, localizePath, t } from '@i18n/utils';
import { img } from '@/lib/images';

interface Props { service: Service; index: number; image: string; showLink?: boolean }
const { service, index, image, showLink = false } = Astro.props;
const locale = getLocale(Astro.url);
const points = t(service.points, locale);
const headingId = `${service.slug}-heading`;
---
<section id={service.slug} aria-labelledby={headingId} class:list={['service-detail section scroll-mt-32', index % 2 ? 'bg-surface-alt' : 'bg-surface']}>
  <div class="container-site">
    <div class="service-intro" data-reveal>
      <div>
        <div class="service-kicker">
          <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
          <span>{locale === 'tr' ? 'Uzmanlık alanımız' : 'Our expertise'}</span>
        </div>
        <h2 id={headingId} class="service-title">{t(service.title, locale)}</h2>
      </div>
      <p class="service-summary">{t(service.summary, locale)}</p>
    </div>
    <div class="service-content">
      <div class="service-photo" data-reveal>
        <Image src={img(image)} alt="" widths={[480, 768, 1200]} sizes="(min-width: 1280px) 480px, (min-width: 1024px) 40vw, calc(100vw - 40px)" layout="none" class="h-full w-full object-cover" />
        <div class="service-photo-line" aria-hidden="true"></div>
      </div>
      <div class="service-scope" data-reveal>
        <div class="service-scope-label">
          <h3>{locale === 'tr' ? 'Nasıl katkı sağlıyoruz?' : 'How we support you'}</h3>
          <span aria-hidden="true">↗</span>
        </div>
        <ul class="service-points">
          {points.map((point, i) => (
            <li>
              <span class="service-point-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
        {showLink && <a class="service-link" href={localizePath(`/what-we-do/${service.slug}`, locale)} aria-label={`${locale === 'tr' ? 'Hizmeti inceleyin' : 'Explore service'}: ${t(service.title, locale)}`}>
          {locale === 'tr' ? 'Hizmeti inceleyin' : 'Explore this service'}
          <span aria-hidden="true">↗</span>
        </a>}
      </div>
    </div>
  </div>
</section>

<style>
  .service-intro { display: grid; gap: 1.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--color-line); }
  .service-kicker { display: flex; align-items: center; gap: 1rem; color: var(--color-accent-600); font-size: .6875rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .service-number { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; background: var(--color-navy-900); color: white; font-size: .8125rem; letter-spacing: .02em; font-variant-numeric: tabular-nums; }
  .service-title { margin-top: 1.25rem; max-width: 23ch; font-family: var(--font-display); font-size: clamp(1.75rem, 1.2rem + 1.7vw, 2.625rem); font-weight: 600; line-height: 1.16; letter-spacing: -.035em; color: var(--color-navy-900); text-wrap: balance; }
  .service-summary { max-width: 48ch; color: var(--color-ink-700); font-size: 1.0625rem; line-height: 1.75; }
  .service-content { display: grid; gap: 2rem; margin-top: 2rem; }
  .service-photo { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: var(--color-surface-muted); }
  .service-photo-line { position: absolute; bottom: 0; left: 0; width: 30%; height: 4px; background: var(--color-accent-600); }
  .service-scope-label { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-bottom: 1.25rem; color: var(--color-navy-900); }
  .service-scope-label h3 { font-size: .75rem; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; }
  .service-scope-label > span { color: var(--color-accent-600); font-size: 1.5rem; }
  .service-points { display: grid; column-gap: 2rem; }
  .service-points li { display: flex; align-items: baseline; gap: .875rem; border-top: 1px solid var(--color-line); padding: 1rem 0; color: var(--color-ink-700); font-size: .9375rem; line-height: 1.6; }
  .service-point-number { flex: none; color: var(--color-accent-600); font-size: .6875rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .service-link { display: inline-flex; align-items: center; gap: 2rem; margin-top: 1.25rem; padding: .75rem 0; border-bottom: 1px solid var(--color-accent-600); color: var(--color-accent-600); font-size: .875rem; font-weight: 600; transition: color .2s; }
  .service-link:hover { color: var(--color-navy-900); }
  .service-link:focus-visible { outline: 2px solid var(--color-accent-600); outline-offset: 5px; }
  @media (min-width: 640px) { .service-points { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .service-intro { grid-template-columns: 1.15fr 1fr; align-items: end; gap: 5rem; padding-bottom: 2.5rem; }
    .service-summary { padding-bottom: .25rem; font-size: 1.125rem; }
    .service-content { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; gap: 3.5rem; margin-top: 2.5rem; }
    .service-photo { aspect-ratio: 5 / 4; }
  }
</style>
