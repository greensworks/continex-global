---
/** Dark band: the firm's operating principles as a four-up hairline grid. */
import { getLocale, t } from '@i18n/utils';
import { pages } from '@data/pages';

interface Props { id?: string }
const { id = 'principles' } = Astro.props;
const locale = getLocale(Astro.url);
const { principlesTitle, principles } = pages.about;
---
<section id={id} class="section bg-navy-950 text-white">
  <div class="container-site">
    <h2 class="text-h2 text-white" data-reveal>{t(principlesTitle, locale)}</h2>
    <div class="mt-12 grid gap-px bg-white/10 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {principles.map((p) => (
        <div class="bg-navy-950 p-7">
          <h3 class="text-lg font-semibold text-white">{t(p.title, locale)}</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/65">{t(p.text, locale)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
