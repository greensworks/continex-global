---
import ContactForm from '@components/sections/ContactForm.astro';
import { site } from '@data/site';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const isTr = locale === 'tr';
const offices = site.locations.filter(l => l.confirmed);
const ext = isTr ? 'dahili' : 'ext.';
---
<section class="section contact-section" id="enquiry" aria-labelledby="enquiry-title">
  <div class="container-site">
    <div class="contact-layout">
      <div class="enquiry-panel">
        <p class="eyebrow">{isTr ? 'Fırsatınızı paylaşın' : 'Share your opportunity'}</p>
        <h2 id="enquiry-title">{isTr ? 'Gündeminizde ne var?' : 'What’s on your agenda?'}</h2>
        <p class="form-intro">{isTr ? 'Şirketinizi, hedef pazarınızı ve ihtiyacınızı kısaca anlatın.' : 'Tell us a little about your company, target market and what you need.'}</p>
        <p class="required-note">{isTr ? '* işaretli alanların doldurulması zorunludur.' : 'Fields marked * are required.'}</p>
        <ContactForm />
      </div>
      <aside class="contact-sidebar" aria-label={isTr ? 'İletişim bilgileri' : 'Contact information'}>
        <div class="direct-contact">
          <p class="eyebrow text-steel-300">{isTr ? 'Doğrudan iletişim' : 'Get in touch directly'}</p>
          <h2>{isTr ? 'Bir görüşmeyle başlayalım.' : 'A conversation is a good place to start.'}</h2>
          <div class="direct-item"><p>{isTr ? 'E-posta' : 'Email'}</p><a href={`mailto:${site.email}`}>{site.email}<span aria-hidden="true">↗</span></a></div>
          <div class="direct-item"><p>{isTr ? 'Telefon' : 'Telephone'}</p><a href={`tel:${site.phone.replace(/\s/g,'')}`}>{site.phone}<span aria-hidden="true">↗</span></a><span class="extension">{ext} {site.phoneExt}</span></div>
        </div>
        <div class="office-details">
          {offices.map(office => <div>
            <p class="eyebrow">{t(office.label,locale)}</p><h2>{office.city === 'Istanbul' ? 'İstanbul' : office.city}</h2>
            <address>{office.lines.map(line => <span>{line}</span>)}</address>
            <a class="map-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(office.lines.join(', '))}`} target="_blank" rel="noopener noreferrer">{isTr ? 'Haritada görüntüle' : 'View on map'} <span aria-hidden="true">↗</span></a>
          </div>)}
          <p class="privacy-note">{isTr ? 'Kişisel verilerinizin işlenmesine ilişkin bilgi için ' : 'For information about how we handle your personal data, read our '}<a href={localizePath('/privacy-policy',locale)}>{isTr ? 'Gizlilik Politikamızı' : 'Privacy Policy'}</a>{isTr ? ' inceleyebilirsiniz.' : '.'}</p>
        </div>
      </aside>
    </div>
    <div class="legal-details"><h2>{tr('contact.legal')}</h2><p>{site.legalName}</p><p>{isTr ? 'Vergi Dairesi' : 'Tax office'}: {site.taxOffice}<span aria-hidden="true"> · </span>{isTr ? 'Vergi No' : 'Tax no'}: {site.taxNo}</p></div>
  </div>
</section>
<style>
.contact-layout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:80px;align-items:start}.enquiry-panel h2{font-size:clamp(32px,3vw,42px);font-weight:400;letter-spacing:-.035em;line-height:1.15;margin-top:16px}.form-intro{font-size:16px;color:#637181;line-height:1.7;margin-top:20px}.required-note{font-size:12px;color:#637181;margin:24px 0}.direct-contact{background:#0b1a30;color:white;padding:40px}.direct-contact h2{font-size:30px;line-height:1.2;font-weight:400;letter-spacing:-.025em;color:white;margin-top:20px}.direct-item{border-top:1px solid #ffffff30;margin-top:28px;padding-top:24px}.direct-item>p{font-size:11px;color:#98c0d8;margin-bottom:10px}.direct-item a{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:clamp(16px,1.5vw,21px);line-height:1.5;overflow-wrap:anywhere}.direct-item a:hover{color:#98c0d8}.extension{display:block;margin-top:5px;font-size:12px;color:#b8c8d9}.office-details{background:#f3f6f9;padding:36px 40px}.office-details h2{font-size:28px;font-weight:400;margin-top:14px}.office-details address{font-style:normal;color:#536172;font-size:14px;line-height:1.8;margin-top:16px}.office-details address span{display:block}.map-link{display:inline-flex;gap:28px;margin-top:20px;padding-bottom:8px;border-bottom:1px solid #9bb7ce;color:#0f6fd6;font-size:13px}.privacy-note{border-top:1px solid #d6e0e9;margin-top:28px;padding-top:24px;color:#637181;font-size:12px;line-height:1.8}.privacy-note a{text-decoration:underline;text-underline-offset:3px;color:#122744}.legal-details{border-top:1px solid #d6e0e9;margin-top:64px;padding-top:24px;display:flex;flex-wrap:wrap;gap:12px 28px;color:#637181;font-size:12px;line-height:1.7}.legal-details h2{font-size:12px;font-weight:600}@media(max-width:1023px){.contact-layout{gap:36px;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr)}.direct-contact,.office-details{padding:28px}}@media(max-width:767px){.contact-layout{grid-template-columns:1fr;gap:40px}.direct-item a{font-size:19px}.legal-details{margin-top:40px;display:block}.legal-details p{margin-top:8px}}
</style>
