---
import Photo from '@components/ui/Photo.astro';
import { experience } from '@data/experience';
import { img } from '@/lib/images';
import { getLocale, localizePath, t } from '@i18n/utils';
const locale = getLocale(Astro.url);
const tr = locale === 'tr';
const [lead,...others] = [experience[1],experience[0],experience[2]];
const href = (slug: string) => localizePath(`/selected-experience/${slug}`,locale);
---
<section class="section bg-white" id="home-experience" aria-labelledby="home-experience-title">
  <div class="container-site">
    <div class="experience-heading"><div><p class="eyebrow">{tr ? 'Referans çalışmalar' : 'Selected experience'}</p><h2 id="home-experience-title">{tr ? 'Fırsatın sonuca dönüştüğü yer.' : <>Where opportunity becomes <span style={Astro.url.pathname === '/' ? 'color: #bebebe' : undefined}>progress.</span></>}</h2></div><a class="all-link" href={localizePath('/selected-experience',locale)}>{tr ? 'Tüm çalışmalar' : 'Explore our work'} <span aria-hidden="true">↗</span></a></div>
    <a class="case-lead" href={href(lead.slug)}>
      <div class="case-image"><Photo src={img(lead.image)} alt="" widths={[640,960,1440]} sizes="(min-width:1024px) 60vw, 100vw" class="h-full w-full object-cover" style="object-position:75% center" /></div>
      <div class="case-copy"><p class="case-label">{t(lead.sector,locale)}</p><h3>{t(lead.title,locale)}</h3><p class="case-outcome">{t(lead.outcome,locale)}</p><span class="case-cta">{tr ? 'Çalışmayı inceleyin' : 'Read the story'} <span aria-hidden="true">↗</span></span></div>
    </a>
    <div class="case-more">{others.map(c => <a href={href(c.slug)}><div class="case-thumb"><Photo src={img(c.image)} alt="" widths={[240,480]} sizes="160px" class="h-full w-full object-cover" /></div><div><p class="case-label">{t(c.sector,locale)}</p><h3>{t(c.title,locale)}</h3><span class="more-arrow" aria-hidden="true">↗</span></div></a>)}</div>
  </div>
</section>
<style>
.experience-heading{display:flex;justify-content:space-between;align-items:end;gap:32px;margin-bottom:40px}.experience-heading h2{font-size:clamp(32px,3.4vw,48px);font-weight:400;letter-spacing:-.035em;line-height:1.12;max-width:700px;margin-top:16px}.all-link{flex-shrink:0;display:flex;gap:24px;color:#0f6fd6;font-size:14px;border-bottom:1px solid;padding-bottom:12px}.case-lead{display:grid;grid-template-columns:1.3fr 1fr;align-items:center}.case-image{height:540px;overflow:hidden}.case-image :global(img){transition:transform .6s}.case-lead:hover .case-image :global(img){transform:scale(1.025)}.case-copy{background:#edf3f8;margin-left:-64px;padding:48px;position:relative}.case-label{color:#0f6fd6;font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase}.case-copy h3{font-size:clamp(28px,2.6vw,36px);font-weight:400;line-height:1.2;letter-spacing:-.025em;margin-top:18px}.case-outcome{margin-top:24px;font-size:15px;line-height:1.65;color:#536172}.case-cta{display:flex;justify-content:space-between;margin-top:32px;font-size:14px;color:#0f6fd6}.case-more{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:40px}.case-more>a{display:grid;grid-template-columns:145px 1fr;gap:24px;border-bottom:1px solid #d6dee7;padding-bottom:28px}.case-thumb{height:140px;overflow:hidden}.case-more h3{font-size:20px;line-height:1.35;margin-top:12px;font-weight:400}.more-arrow{display:block;color:#0f6fd6;font-size:23px;margin-top:12px}@media(max-width:767px){.experience-heading{flex-direction:column;align-items:start;gap:24px}.case-lead{grid-template-columns:1fr}.case-image{height:300px}.case-copy{margin:-32px 0 0 20px;padding:28px}.case-more{grid-template-columns:1fr;gap:28px}.case-more>a{grid-template-columns:100px 1fr;gap:20px}.case-thumb{height:120px}.case-more h3{font-size:19px}}
</style>
