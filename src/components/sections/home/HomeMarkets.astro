---
import Photo from '@components/ui/Photo.astro';
import marketImage from '@assets/images/insight-turkiye-market.webp';
import { markets } from '@data/markets';
import { getLocale, localizePath, t } from '@i18n/utils';
const locale = getLocale(Astro.url);
const tr = locale === 'tr';
---
<section class="section markets-editorial" id="home-markets" aria-labelledby="home-markets-title">
  <div class="container-site">
    <div class="markets-heading">
      <div>
        <p class="eyebrow">{tr ? 'Pazarlar' : 'Markets'}</p>
        <h2 id="home-markets-title">{tr ? 'Türkiye’den uluslararası fırsatlara.' : <>From Türkiye to <span style="color: #bebebe">international opportunity.</span></>}</h2>
      </div>
      <div class="markets-intro">
        <p>{tr ? 'Merkezimiz İstanbul’da. Çin’deki güçlü ilişki tabanımız ve bölgesel iş bağlantılarımızla şirketlerin sınır ötesi hedeflerine destek oluyoruz.' : 'Headquartered in Istanbul, we support cross-border ambitions through our established relationships in China and our regional business network.'}</p>
        <a href={localizePath('/markets',locale)} class="markets-link">{tr ? 'Pazarlarımızı keşfedin' : 'Explore our markets'} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="markets-feature">
      <figure class="markets-photo">
        <Photo src={marketImage} alt={tr ? 'İstanbul Boğazı, Ortaköy ve iki kıtayı birleştiren köprü' : 'The Bosphorus, Ortaköy and the bridge connecting two continents in Istanbul'} widths={[480,768,1200,1536]} sizes="(min-width:1360px) 780px, (min-width:900px) 60vw, calc(100vw - 40px)" class="market-image" />
        <figcaption>{tr ? 'İstanbul, Türkiye' : 'Istanbul, Türkiye'}</figcaption>
      </figure>
      <div class="markets-primary">
        {markets.slice(0,2).map(m => <div class="market-detail"><h3>{t(m.name,locale)}</h3><p>{t(m.text,locale)}</p></div>)}
      </div>
    </div>
    <div class="markets-regions">
      <p>{tr ? 'Bölgesel kapsamımız' : 'Our regional reach'}</p>
      <ul>{markets.slice(2).map(m => <li>{t(m.name,locale)}</li>)}</ul>
    </div>
  </div>
</section>
<style>
.markets-editorial{background:#fff}
.markets-heading{display:grid;grid-template-columns:1.2fr 1fr;align-items:end;gap:80px;margin-bottom:44px}
.markets-heading h2{margin-top:18px;font-size:clamp(32px,3.4vw,48px);font-weight:400;letter-spacing:-.035em;line-height:1.12;max-width:620px}
.markets-intro>p{font-size:16px;line-height:1.75;color:#667181;max-width:49ch}
.markets-link{display:inline-flex;align-items:center;gap:32px;font-size:14px;color:#0f6fd6;padding-bottom:10px;margin-top:24px}
.markets-link:hover{color:#122744}
.markets-feature{display:grid;grid-template-columns:1.55fr 1fr;align-items:stretch}
.markets-photo{position:relative;min-width:0;min-height:420px;overflow:hidden;background:#e4eff6}
.markets-photo :global(.market-image){position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
.markets-photo figcaption{position:absolute;bottom:0;left:0;padding:12px 22px;background:#122744;color:white;font-size:12px;letter-spacing:.025em}
.markets-primary{padding:42px 40px;background:#f3f6f9;display:flex;flex-direction:column;justify-content:center;gap:30px}
.market-detail h3{font-size:28px;font-weight:400;letter-spacing:-.025em;line-height:1.2}
.market-detail p{font-size:14px;line-height:1.75;color:#667181;margin-top:12px;max-width:38ch}
.market-detail+.market-detail{padding-top:28px;border-top:1px solid #dce3e9}
.markets-regions{display:flex;align-items:baseline;gap:40px;padding-top:26px}
.markets-regions>p{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:#667181;flex-shrink:0}
.markets-regions ul{display:flex;flex-wrap:wrap;gap:14px 32px;font-size:14px;color:#122744}
@media(max-width:899px){.markets-heading{grid-template-columns:1fr;gap:24px;margin-bottom:32px}.markets-intro>p{max-width:60ch}.markets-feature{grid-template-columns:1fr}.markets-photo{min-height:0;aspect-ratio:16/10}.markets-primary{display:grid;grid-template-columns:1fr 1fr;padding:28px;gap:28px}.market-detail+.market-detail{border:0;padding:0}.markets-regions{flex-direction:column;gap:16px}}
@media(max-width:539px){.markets-primary{grid-template-columns:1fr;padding:28px 24px;gap:24px}.market-detail+.market-detail{border-top:1px solid #dce3e9;padding-top:24px}.markets-regions ul{display:grid;grid-template-columns:1fr 1fr;width:100%;gap:14px 20px}.markets-photo{aspect-ratio:4/3}.markets-photo figcaption{padding:10px 16px}.market-detail h3{font-size:26px}}
</style>
