---
import Photo from '@components/ui/Photo.astro';
import { getCollection } from 'astro:content';
import { compareInsights, topicLabel } from '@/lib/insights';
import { getLocale, localizePath } from '@i18n/utils';
const locale = getLocale(Astro.url);
const tr = locale === 'tr';
const posts = (await getCollection('insights', e => e.id.startsWith(`${locale}/`) && !e.data.draft)).sort(compareInsights).slice(0,3);
const href = (id: string) => localizePath(`/insights/${id.split('/').slice(1).join('/')}`,locale);
---
<section class="editorial section bg-white" id="home-insights" aria-labelledby="home-insights-title">
  <div class="container-site">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">{tr ? 'Continex perspektifi' : 'The Continex perspective'}</p><h2 id="home-insights-title">{tr ? 'Bugünün kararları. Yarının fırsatları.' : <>Today’s decisions. <span style="color: #bebebe">Tomorrow’s opportunities.</span></>}</h2></div>
      <a class="editorial-link" href={localizePath('/insights',locale)}>{tr ? 'Tüm görüş ve analizler' : 'Explore our insights'} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="stories">
      {posts.map((p,i) => <a href={href(p.id)} class:list={['story',i===0 ? 'story-lead' : 'story-side']}>
        <div class="story-image">{p.data.cover && <Photo src={p.data.cover} alt="" widths={[480,768,1200,1600]} sizes={i===0 ? '(min-width:1024px) 60vw, 100vw' : '(min-width:1024px) 25vw, 100vw'} class="h-full w-full object-cover" style={`object-position:${p.data.coverPosition}`} />}</div>
        <div class="story-copy"><p class="story-label">{topicLabel(p.data.topic,locale)}</p><h3>{p.data.title}</h3>{i===0 && <p class="story-description">{p.data.description}</p>}<span class="story-arrow" aria-hidden="true">↗</span></div>
      </a>)}
    </div>
  </div>
</section>
<style>
.section-heading{display:flex;align-items:end;justify-content:space-between;gap:32px;margin-bottom:40px}.section-heading h2{font-size:clamp(32px,3.4vw,48px);font-weight:400;letter-spacing:-.035em;line-height:1.12;max-width:760px;margin-top:16px}.editorial-link{display:flex;gap:24px;align-items:center;flex-shrink:0;font-size:14px;border-bottom:1px solid #0f6fd6;padding-bottom:12px;color:#0f6fd6}.stories{display:grid;grid-template-columns:1.6fr 1fr;gap:24px}.story{position:relative;overflow:hidden;display:flex;flex-direction:column}.story-image{overflow:hidden}.story-image :global(img){transition:transform .6s}.story:hover .story-image :global(img){transform:scale(1.035)}.story-lead{grid-row:span 2;min-height:650px;background:#0b1a30}.story-lead .story-image{position:absolute;inset:0}.story-lead:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 15%,rgba(5,17,36,.7) 50%,#08192e 100%)}.story-copy{position:relative;z-index:1}.story-lead .story-copy{margin-top:auto;padding:40px}.story-label{font-size:11px;text-transform:uppercase;letter-spacing:.14em;font-weight:600}.story-lead .story-label{color:#b8d9ee}.story h3{font-weight:400;line-height:1.18;letter-spacing:-.025em}.story-lead h3{font-size:clamp(28px,3vw,42px);color:white;margin-top:18px}.story-description{color:#d3deea;margin-top:20px;font-size:15px;line-height:1.65;max-width:52ch}.story-arrow{display:block;font-size:27px;margin-top:20px;color:#0f6fd6}.story-lead .story-arrow{color:white}.story-side{background:#f3f6f9}.story-side .story-image{height:160px}.story-side .story-copy{padding:24px 28px}.story-side .story-label{color:#0f6fd6}.story-side h3{font-size:23px;margin-top:12px}.story-side .story-arrow{position:absolute;right:24px;bottom:16px}.story-side .story-copy{padding-bottom:44px}@media(max-width:767px){.section-heading{align-items:start;flex-direction:column;gap:24px}.stories{grid-template-columns:1fr}.story-lead{min-height:530px}.story-lead .story-copy{padding:28px}.story-side .story-image{height:220px}.story-side h3{font-size:26px}}
@media (min-width: 768px) {
  .story-arrow { display: none; }
  .story-side .story-copy { padding-bottom: 24px; }
}
</style>
