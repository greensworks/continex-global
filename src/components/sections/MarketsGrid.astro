---
/** Regional cards with an honest coverage legend instead of a map. */
import { getLocale, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import { markets, coverageLabels, type Coverage } from '@data/markets';
import { site } from '@data/site';

interface Props { eyebrow?: string; title?: string }
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const { eyebrow = locale === 'tr' ? 'Pazarlar' : 'Markets', title = t(site.coverage, locale) } = Astro.props;
const dot: Record<Coverage, string> = { office: 'bg-accent-600', team: 'bg-navy-800', partner: 'bg-steel-300', coverage: 'bg-ink-400' };
---
<section class="section bg-surface-alt">
  <div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-8" data-reveal>
      <div class="max-w-3xl">
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="mt-4 text-h2">{title}</h2>
      </div>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-ink-500" aria-label={tr('markets.legend')}>
        {(Object.keys(coverageLabels) as Coverage[]).map((k) => <li class="inline-flex items-center gap-2"><span class:list={['h-2.5 w-2.5 rounded-full', dot[k]]}></span>{t(coverageLabels[k], locale)}</li>)}
      </ul>
    </div>
    <div class="mt-12 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {markets.map((m) => (
        <div class="bg-surface p-7">
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-xl font-semibold text-navy-900">{t(m.name, locale)}</h3>
            <span class="inline-flex items-center gap-2 text-xs font-medium text-ink-500"><span class:list={['h-2.5 w-2.5 rounded-full', dot[m.coverage]]}></span>{t(coverageLabels[m.coverage], locale)}</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-ink-500">{t(m.text, locale)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
