---
const {
  eyebrow = 'Continex Culture',
  title = 'Independent thinking, trusted networks, practical execution.',
  text = 'We combine strategic judgment with on-the-ground business development work, helping clients move from opportunity to action.',
  image = '/assets/img/general/insights.webp',
  href = '/about-us.html',
  label = 'About Continex Global',
} = Astro.props;
---

<section class="cx-wire-careers-banner">
  <div class="container">
    <div class="cx-wire-careers-inner">
      <div>
        <span class="tp-section-sub">{eyebrow}</span>
        <h2 class="tp-section-title">{title}</h2>
        <p>{text}</p>
        <a class="tp-btn-event" href={href}>
          <div class="button-text">{label}</div>
          <div class="button-icon-wrapper">
            <img src="/assets/img/finance/hero/btn-arrow.svg" loading="lazy" width="16" height="16" alt="" class="button-image">
            <div class="button-dot"></div>
          </div>
        </a>
      </div>
      <div class="cx-wire-careers-visual" aria-hidden="true">
        <img src={image} alt="">
      </div>
    </div>
  </div>
</section>

<style>
  .cx-wire-careers-banner {
    padding: 0 0 120px;
    background: #fff;
  }

  .cx-wire-careers-inner {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    min-height: 440px;
    overflow: hidden;
    border-radius: 6px;
    background: #eef4f1;
  }

  .cx-wire-careers-inner > div:first-child {
    padding: 72px;
    align-self: center;
  }

  .cx-wire-careers-inner p {
    color: #586c6e;
    font-size: 17px;
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .cx-wire-careers-visual {
    min-height: 440px;
  }

  .cx-wire-careers-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 1199px) {
    .cx-wire-careers-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .cx-wire-careers-inner > div:first-child {
      padding: 28px;
    }
  }
</style>
