---
/**
 * Full-bleed dark hero. Real industrial photography, navy overlay,
 * strong headline, two CTAs. Header renders transparent over it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '@components/ui/Button.astro';
import { getLocale, localizePath, t as pick } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import { site } from '@data/site';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
}
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const {
  image, imageAlt,
  eyebrow = pick(site.tagline, locale),
  title = pick(site.headline, locale),
  lead = pick(site.description, locale),
} = Astro.props;
---
<section class="relative isolate flex min-h-[88svh] items-end overflow-hidden bg-navy-950 text-white">
  <Image
    src={image}
    alt={imageAlt}
    widths={[768, 1280, 1920, 2560]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgba(11,26,48,0.92)_0%,rgba(11,26,48,0.55)_45%,rgba(11,26,48,0.25)_100%)]" aria-hidden="true"></div>

  <div class="container-site pb-16 pt-40 sm:pb-24 lg:pb-28">
    <div class="max-w-4xl">
      <p class="eyebrow text-steel-300" data-reveal>{eyebrow}</p>
      <h1 class="mt-5 text-display font-semibold text-white" data-reveal data-reveal-delay="0.08">{title}</h1>
      <p class="mt-7 max-w-2xl text-lead text-white/75" data-reveal data-reveal-delay="0.16">{lead}</p>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal data-reveal-delay="0.24">
        <Button href={localizePath('/contact', locale)} size="lg">{t('cta.discuss')}</Button>
        <Button href={localizePath('/what-we-do', locale)} size="lg" variant="inverse">{t('cta.explore')}</Button>
      </div>
    </div>
  </div>
</section>
