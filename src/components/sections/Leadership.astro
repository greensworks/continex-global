---
/** Leadership as RB statement panels: portrait / initials, one defining sentence, name, role, sector line, buttons. */
import Overline from '@components/sections/rb/Overline.astro';
import StatementCard from '@components/sections/rb/StatementCard.astro';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import { team } from '@data/team';
import { img } from '@/lib/images';

interface Props { full?: boolean; eyebrow?: string }
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const { full = false, eyebrow = tr('nav.leadership') } = Astro.props;
---
<section id="leadership" class="bg-surface pb-[var(--spacing-section)]">
  <Overline text={eyebrow} />
  <div class="container-site space-y-6">
    {team.map((p) => (
      <StatementCard
        id={p.slug}
        image={p.image ? img(p.image) : null}
        initials={p.name.split(' ').map((n) => n[0]).join('')}
        statement={full ? t(p.bio, locale)[full ? 2 : 0] : t(p.short, locale)}
        name={p.name}
        role={t(p.role, locale)}
        meta={`${t(p.sectors, locale)} · ${t(p.countries, locale)}`}
        buttons={[
          ...(p.linkedin ? [{ label: 'LinkedIn', href: p.linkedin }] : []),
          { label: full ? tr('cta.discuss') : tr('nav.about'), href: localizePath(full ? '/contact' : '/about#leadership', locale) },
        ]}
      />
    ))}
  </div>
</section>
