---
/** A mandate-focused case study: context, contribution, progress and evidenced outcome. */
import Image from '@components/ui/Photo.astro';
import type { ImageMetadata } from 'astro';
import type { CaseStudy } from '@data/experience';
import { getLocale, localizePath, t } from '@i18n/utils';
interface Props {
  cs: CaseStudy;
  image: ImageMetadata;
  supportImage: ImageMetadata;
  related: { title: string; text: string; href: string }[];
}
const { cs, image, supportImage, related } = Astro.props;
const locale = getLocale(Astro.url);
const isTr = locale === 'tr';
const copy = (en: string, tr: string) => isTr ? tr : en;
const title = t(cs.title, locale);
const sections = [
  { id: 'need', label: copy('The mandate', 'Müşteri ihtiyacı'), title: copy('The commercial objective', 'Çalışmanın ticari hedefi'), text: t(cs.need, locale) },
  { id: 'role', label: copy('Our contribution', 'Continex’in rolü'), title: copy('Our role in the mandate', 'Süreçte üstlendiğimiz rol'), text: t(cs.role, locale) },
  { id: 'progress', label: copy('Execution', 'Sürecin yürütülmesi'), title: copy('How the mandate progressed', 'Çalışmada nasıl ilerledik'), text: t(cs.progress, locale) },
];
const facts = [
  { label: copy('Client profile', 'Müşteri profili'), value: t(cs.client, locale) },
  { label: copy('Sector', 'Sektör'), value: t(cs.sector, locale) },
  { label: copy('Market', 'Pazar'), value: t(cs.market, locale) },
  { label: copy('Mandate status', 'Çalışmanın durumu'), value: t(cs.status, locale) },
];
const statusLabel = cs.statusKind === 'completed' ? copy('Completed mandate', 'Tamamlanan çalışma') : cs.statusKind === 'advanced' ? copy('Advanced stage', 'İleri aşamada') : copy('Ongoing mandate', 'Devam eden çalışma');
---
<article class="case-study bg-surface">
  <header class="case-hero relative isolate overflow-hidden bg-navy-950 text-white">
    <Image src={image} alt="" widths={[768, 1280, 1536]} sizes="100vw" loading="eager" fetchpriority="high" class="case-hero-image" style={{ objectPosition: cs.slug === 'market-entry-strategic-partners-turkiye' ? '75% 30%' : '75% 0%' }} />
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(11,26,48,0.92),rgba(11,26,48,0.72)_55%,rgba(11,26,48,0.12))]" aria-hidden="true"></div>
    <div class="container-site">
      <nav aria-label={copy('Breadcrumb', 'Sayfa yolu')} class="text-xs text-white/75">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a class="hover:underline" href={localizePath('/', locale)}>{copy('Home', 'Ana sayfa')}</a></li>
          <li aria-hidden="true">/</li>
          <li><a class="hover:underline" href={localizePath('/selected-experience', locale)}>{copy('Selected experience', 'Referans çalışmalar')}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{t(cs.client, locale)}</li>
        </ol>
      </nav>
      <p class="mt-7 text-[11px] font-semibold uppercase tracking-[.16em] text-white/70">{copy('Selected mandate', 'Referans çalışma')}</p>
      <h1 class="mt-3 max-w-[850px] font-display text-[clamp(1.875rem,1.25rem+2vw,3rem)] font-medium leading-[1.12] tracking-tight text-white">{title}</h1>
    </div>
  </header>

  <section aria-label={copy('Mandate overview', 'Çalışmaya genel bakış')} class="border-b border-line bg-surface-alt">
    <dl class="container-site grid grid-cols-1 py-7 sm:grid-cols-2 lg:grid-cols-4 lg:py-9">
      {facts.map((fact, i) => <div class:list={['py-4 sm:px-5 lg:py-0', i > 0 && 'border-t border-line sm:border-t-0 sm:border-l', i === 0 && 'sm:pl-0']}>
        <dt class="text-[10px] font-semibold uppercase tracking-[.14em] text-ink-500">{fact.label}</dt>
        <dd class="mt-2 max-w-[30ch] text-sm font-semibold leading-relaxed text-navy-900">{fact.value}</dd>
      </div>)}
    </dl>
  </section>

  <div class="container-site py-12 md:py-16 lg:py-20">
    <p class="max-w-3xl text-xs leading-relaxed text-ink-500">{copy('Client identities are anonymised. The scope, progress and outcomes below reflect the mandate as reported.', 'Müşteri kimlikleri gizlilik gereği anonimleştirilmiştir. Aşağıdaki kapsam, süreç ve sonuçlar çalışmanın bildirilen durumunu yansıtır.')}</p>
    <div class="mt-10 grid items-start gap-12 lg:grid-cols-[minmax(0,1.65fr)_minmax(0,1fr)] lg:gap-16">
      <div class="min-w-0">
        {sections.map((section, i) => <section id={section.id} aria-labelledby={`${section.id}-title`} class="case-chapter scroll-mt-36">
          <div class="flex items-center gap-4 text-[11px] font-semibold uppercase tracking-[.12em] text-accent-600">
            <span class="grid h-8 w-8 shrink-0 place-items-center border border-line tracking-normal" aria-hidden="true">0{i + 1}</span>
            <p>{section.label}</p>
          </div>
          <h2 id={`${section.id}-title`} class="mt-5 font-display text-[clamp(1.5rem,1.2rem+.8vw,2rem)] font-semibold leading-tight tracking-tight text-navy-900">{section.title}</h2>
          <p class="mt-5 max-w-[64ch] text-base leading-[1.85] text-ink-700 md:text-[17px]">{section.text}</p>
        </section>)}
      </div>
      <aside class="min-w-0 lg:sticky lg:top-36">
        <section id="outcome" aria-labelledby="outcome-title" class="scroll-mt-36 bg-navy-950 p-7 text-white md:p-9">
          <p class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[.12em] text-white/75"><span class:list={['h-2 w-2 shrink-0 rounded-full', cs.statusKind === 'completed' ? 'bg-emerald-300' : 'bg-sky-300']} aria-hidden="true"></span>{statusLabel}</p>
          <h2 id="outcome-title" class="mt-6 font-display text-2xl font-medium leading-tight text-white">{cs.statusKind === 'completed' ? copy('The outcome', 'Ortaya çıkan sonuç') : copy('Where the mandate stands', 'Bugün gelinen aşama')}</h2>
          <p class="mt-5 text-[15px] leading-[1.85] text-white/85">{t(cs.outcome, locale)}</p>
          <div class="mt-7 border-t border-white/20 pt-5">
            <a href={localizePath('/contact', locale)} class="inline-flex items-center gap-4 text-sm font-semibold text-white underline decoration-white/40 underline-offset-8 hover:decoration-white">{copy('Discuss a similar mandate', 'Benzer bir çalışmayı görüşelim')}<span aria-hidden="true">↗</span></a>
          </div>
        </section>
        <figure class="mt-6">
          <div class="aspect-[16/10] overflow-hidden bg-surface-muted"><Image src={supportImage} alt="" widths={[480, 768, 1200]} sizes="(min-width: 1280px) 440px, (min-width: 1024px) 35vw, calc(100vw - 40px)" class="h-full w-full object-cover" /></div>
          <figcaption class="mt-2 text-[10px] leading-relaxed text-ink-500">{copy('Illustrative imagery; not a photograph of the client or the specific mandate.', 'Görseller temsilidir; müşteriyi veya ilgili çalışmayı belgeleyen fotoğraflar değildir.')}</figcaption>
        </figure>
      </aside>
    </div>
  </div>

  <section class="border-t border-line bg-surface-alt py-12 md:py-16" aria-labelledby="related-services-title">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div><p class="eyebrow">{copy('Our expertise', 'Uzmanlık alanlarımız')}</p><h2 id="related-services-title" class="mt-3 font-display text-2xl font-semibold tracking-tight text-navy-900 md:text-3xl">{copy('Services behind this mandate', 'Bu çalışmayla ilişkili hizmetler')}</h2></div>
        <a href={localizePath('/selected-experience', locale)} class="text-sm font-semibold text-accent-600 hover:underline underline-offset-4">{copy('All selected experience', 'Tüm referans çalışmalar')} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {related.map((service, i) => <a href={service.href} class="group flex flex-col border border-line bg-surface p-6 transition-colors hover:border-accent-600 md:p-7">
          <span class="flex items-center justify-between text-xs text-accent-600"><span aria-hidden="true">0{i + 1}</span><span aria-hidden="true">↗</span></span>
          <h3 class="mt-6 text-lg font-semibold leading-snug text-navy-900 group-hover:text-accent-600">{service.title}</h3>
          <p class="mt-4 text-sm leading-relaxed text-ink-500">{service.text}</p>
        </a>)}
      </div>
    </div>
  </section>
</article>
<style>
  .case-hero { min-height: 360px; padding: 144px 0 36px; }
  .case-hero-image { position: absolute; inset: 104px 0 0; z-index: -20; width: 100%; height: calc(100% - 104px); object-fit: cover; }
  .case-chapter { padding-bottom: 2.5rem; }
  .case-chapter + .case-chapter { padding-top: 2.5rem; border-top: 1px solid var(--color-line); }
  .case-chapter:last-child { padding-bottom: 0; }
  .case-study a:focus-visible { outline: 2px solid var(--color-accent-600); outline-offset: 5px; }
  @media (min-width: 768px) {
    .case-hero { min-height: 400px; padding: 152px 0 40px; }
    .case-hero-image { top: 120px; height: calc(100% - 120px); }
  }
</style>
