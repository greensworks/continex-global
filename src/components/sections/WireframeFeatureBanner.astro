---
const {
  eyebrow = 'Industry Focus',
  title = 'Built for complex industrial and infrastructure markets.',
  text = 'Continex Global works where market access depends on local context, long sales cycles, credible relationships, and careful commercial positioning.',
  image = '/assets/img/general/continex.webp',
  href = '/industries.html',
  label = 'Explore industries',
  signal = 'Qualified partner conversation identified',
} = Astro.props;
---

<section class="cx-wire-feature-band">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <div class="cx-wire-feature-copy">
          <span class="tp-section-sub">{eyebrow}</span>
          <h2 class="tp-section-title">{title}</h2>
          <p>{text}</p>
          <a class="tp-btn tp-btn-switch-animation" href={href}>
            <span class="d-flex align-items-center justify-content-center">
              <span class="btn-text">{label}</span>
              <i class="btn-icon"></i>
              <i class="btn-icon"></i>
            </span>
          </a>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="cx-wire-signal-panel">
          <img src={image} alt="">
          <div class="cx-wire-signal-input">
            <span>Opportunity signal</span>
            <strong>{signal}</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cx-wire-feature-band {
    padding: 100px 0;
    background: #eef4f1;
  }

  .cx-wire-feature-copy {
    padding-right: 40px;
  }

  .cx-wire-feature-copy p {
    color: #586c6e;
    font-size: 17px;
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .cx-wire-signal-panel {
    position: relative;
    height: 360px;
    overflow: hidden;
    border-radius: 6px;
  }

  .cx-wire-signal-panel > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cx-wire-signal-input {
    position: absolute;
    left: 36px;
    right: 36px;
    bottom: 36px;
    padding: 18px 22px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.16);
  }

  .cx-wire-signal-input span {
    display: block;
    color: #586c6e;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .cx-wire-signal-input strong {
    color: #183457;
  }

  @media (max-width: 767px) {
    .cx-wire-feature-copy {
      padding: 0;
      margin-bottom: 34px;
    }
  }
</style>
