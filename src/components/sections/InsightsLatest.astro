---
/** Latest insights as RB media tiles (navy caption bar, topic label). */
import { getCollection } from 'astro:content';
import MediaTiles from '@components/sections/rb/MediaTiles.astro';
import Overline from '@components/sections/rb/Overline.astro';
import { getLocale, localizePath } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import { pages } from '@data/pages';
import { t } from '@i18n/utils';

interface Props { limit?: number; showHeading?: boolean; line?: boolean }
const { limit = 3, showHeading = true, line = true } = Astro.props;
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const posts = (await getCollection('insights', (e) => e.id.startsWith(`${locale}/`) && !e.data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, limit);
const slugOf = (id: string) => id.split('/').slice(1).join('/');
const topicLabels: Record<string, [string, string]> = {
  'market-entry': ['Market entry', 'Pazara giriş'], 'china-turkiye': ['Türkiye–China', 'Türkiye–Çin'], 'energy-infrastructure': ['Energy & infrastructure', 'Enerji ve altyapı'],
  'industrial-automotive': ['Industrial & automotive', 'Sanayi ve otomotiv'], 'joint-ventures': ['Joint ventures', 'Ortak girişimler'], 'project-finance': ['Project finance', 'Proje finansmanı'],
};
const tiles = posts.map((p) => ({ label: topicLabels[p.data.topic][locale === 'tr' ? 1 : 0], title: p.data.title, text: p.data.description, href: localizePath(`/insights/${slugOf(p.id)}`, locale), image: p.data.cover }));
---
{showHeading && <Overline text={t(pages.insights.title, locale)} line={line} />}
{tiles.length ? <MediaTiles tiles={tiles} /> : <p class="container-site py-8 text-ink-500">{tr('insights.empty')}</p>}
{showHeading && (
  <div class="container-site bg-surface py-8 text-center">
    <a href={localizePath('/insights', locale)} class="inline-flex items-center gap-2 text-sm font-semibold text-accent-600 hover:underline underline-offset-4">{tr('cta.viewAll')} →</a>
  </div>
)}
