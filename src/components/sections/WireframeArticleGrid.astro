---
const {
  eyebrow = 'Core Capabilities',
  title = 'From market entry to deal execution.',
  text = 'Reusable card grid adapted from the supplied wireframe into the Continex Global visual system.',
  items = [
    {
      label: 'Market Entry',
      title: 'Market Entry & Commercial Expansion',
      text: 'Market evaluation, customer mapping, partner access, and commercial follow-through.',
      image: '/assets/img/general/continex.webp',
    },
    {
      label: 'Partnerships',
      title: 'Strategic Partnerships & Joint Ventures',
      text: 'Partner search, relationship building, and partnership development.',
      image: '/assets/img/general/contact-banner.webp',
    },
    {
      label: 'Projects',
      title: 'Project Development & Strategic Transactions',
      text: 'Opportunity shaping, stakeholder alignment, and strategic transaction support.',
      image: '/assets/img/general/insights.webp',
    },
    {
      label: 'Representation',
      title: 'International Representation & Deal Execution',
      text: 'On-the-ground representation and disciplined commercial execution.',
      image: '/assets/img/general/contact-breadcrumb-bg.webp',
    },
  ],
} = Astro.props;
---

<section class="cx-wire-article-grid tp-sec-ptb pt-120 pb-90">
  <div class="container">
    <div class="row align-items-end mb-40">
      <div class="col-lg-7">
        <span class="tp-section-sub">{eyebrow}</span>
        <h2 class="tp-section-title">{title}</h2>
      </div>
      <div class="col-lg-5">
        <p class="cx-wire-section-copy">{text}</p>
      </div>
    </div>
    <div class="row">
      {items.map((item) => (
        <div class="col-xl-3 col-md-6">
          <article class="cx-wire-image-card">
            <img src={item.image} alt="">
            <div class="cx-wire-card-overlay"></div>
            <div class="cx-wire-card-label">{item.label}</div>
            <div class="cx-wire-card-content">
              <span>{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cx-wire-article-grid {
    background: #fff;
  }

  .cx-wire-section-copy {
    color: #586c6e;
    font-size: 17px;
    line-height: 1.65;
  }

  .cx-wire-image-card {
    position: relative;
    min-height: 430px;
    overflow: hidden;
    border-radius: 6px;
    background: #222f30;
    margin-bottom: 30px;
  }

  .cx-wire-image-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cx-wire-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(34, 47, 48, 0.06), rgba(34, 47, 48, 0.9));
  }

  .cx-wire-card-label {
    position: absolute;
    z-index: 2;
    top: 24px;
    left: 24px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(34, 47, 48, 0.78);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .cx-wire-card-content {
    position: absolute;
    z-index: 2;
    left: 28px;
    right: 28px;
    bottom: 28px;
  }

  .cx-wire-card-content span {
    display: inline-block;
    margin-bottom: 10px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .cx-wire-card-content h3 {
    color: #fff;
    font-size: 24px;
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .cx-wire-card-content p {
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.55;
    margin: 0;
  }
</style>
