---
/**
 * Insights as light post cards: 376×259 photo, topic pill, title and
 * a "Read more" link. Three per row on desktop.
 */
import Image from '@components/ui/Photo.astro';
import { getCollection } from 'astro:content';
import { compareInsights, topicLabel } from '@/lib/insights';
import { getLocale, localizePath } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';

interface Props { limit?: number; skip?: number; /** full section spacing above the cards */ topSpace?: boolean }
const { limit = 50, skip = 0, topSpace = false } = Astro.props;
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const posts = (await getCollection('insights', (e) => e.id.startsWith(`${locale}/`) && !e.data.draft))
  .sort(compareInsights)
  .slice(skip, skip + limit);
const slugOf = (id: string) => id.split('/').slice(1).join('/');
---
<section class:list={['bg-surface pb-[var(--spacing-section)]', topSpace && 'pt-[var(--spacing-section)]']}>
  <div class="container-site">
    {posts.length ? (
      <div class="grid gap-x-5 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {posts.map((p) => (
          <a href={localizePath(`/insights/${slugOf(p.id)}`, locale)} class="group block">
            <div class="aspect-[376/259] overflow-hidden bg-surface-muted">
              {p.data.cover && <Image src={p.data.cover} alt="" widths={[384, 640, 800, 1200]} sizes="(min-width: 1280px) 387px, (min-width: 1024px) calc((100vw - 120px) / 3), (min-width: 640px) calc((100vw - 84px) / 2), calc(100vw - 40px)" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />}
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-4 text-sm">
              <span class="rounded-full bg-steel-100 px-3 py-1 text-[12px] font-semibold text-navy-800">{topicLabel(p.data.topic, locale)}</span>
            </div>
            <h3 class="mt-3 text-xl font-semibold leading-snug text-navy-900">{p.data.title}</h3>
            <span class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-accent-600">
              <span aria-hidden="true">›</span>{tr('cta.readMore')}
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-ink-500">{tr('insights.empty')}</p>
    )}
  </div>
</section>
