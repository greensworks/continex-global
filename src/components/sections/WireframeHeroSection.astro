---
const {
  eyebrow = 'Cross-Border Business Development & Strategic Advisory',
  title = 'Turning Cross-Border Opportunities into Business',
  featureEyebrow = 'Commercial Expansion',
  featureTitle = 'We connect strategy, local relationships, and hands-on business development.',
  featureText = 'Continex Global helps international companies enter new markets, reach the right customers and business partners, develop strategic partnerships, and move opportunities toward commercial results.',
  image = '/assets/img/general/contact-banner.webp',
  ctaHref = '/contact.html',
  ctaLabel = 'Discuss an Opportunity',
} = Astro.props;
---

<section class="cx-wire-hero">
  <div class="container">
    <div class="cx-wire-hero-heading text-center">
      <span class="tp-section-sub">{eyebrow}</span>
      <h2 class="tp-section-title">{title}</h2>
    </div>

    <div class="cx-wire-feature">
      <img src={image} alt="">
      <span class="cx-wire-tag">What We Do</span>
      <div class="cx-wire-feature-panel">
        <span>{featureEyebrow}</span>
        <h3>{featureTitle}</h3>
        <p>{featureText}</p>
        <a class="tp-btn-event" href={ctaHref}>
          <div class="button-text">{ctaLabel}</div>
          <div class="button-icon-wrapper">
            <img src="/assets/img/finance/hero/btn-arrow.svg" loading="lazy" width="16" height="16" alt="" class="button-image">
            <div class="button-dot"></div>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cx-wire-hero {
    padding: 120px 0 80px;
    background: #fff;
  }

  .cx-wire-hero-heading {
    max-width: 960px;
    margin: 0 auto 70px;
  }

  .cx-wire-hero-heading .tp-section-title {
    margin-top: 16px;
  }

  .cx-wire-feature {
    position: relative;
    min-height: 560px;
    overflow: hidden;
    border-radius: 6px;
    background: #222f30;
  }

  .cx-wire-feature > img {
    width: 100%;
    height: 100%;
    min-height: 560px;
    object-fit: cover;
    display: block;
  }

  .cx-wire-feature::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(8, 25, 28, 0.64), rgba(8, 25, 28, 0.08));
  }

  .cx-wire-tag {
    position: absolute;
    z-index: 2;
    top: 24px;
    left: 24px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(34, 47, 48, 0.78);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .cx-wire-feature-panel {
    position: absolute;
    z-index: 2;
    left: 48px;
    bottom: 48px;
    max-width: 520px;
    padding: 38px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.16);
  }

  .cx-wire-feature-panel span {
    display: inline-block;
    margin-bottom: 10px;
    color: #586c6e;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .cx-wire-feature-panel h3 {
    color: #222f30;
    font-size: 34px;
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .cx-wire-feature-panel p {
    color: #586c6e;
    margin-bottom: 24px;
    line-height: 1.6;
  }

  @media (max-width: 767px) {
    .cx-wire-feature,
    .cx-wire-feature > img {
      min-height: 620px;
    }

    .cx-wire-feature-panel {
      left: 18px;
      right: 18px;
      bottom: 18px;
      padding: 26px;
    }

    .cx-wire-feature-panel h3 {
      font-size: 26px;
    }
  }
</style>
