---
/** Centred 404 block: breadcrumb, headline, one line of copy, one way back. */
import { pages } from '@data/pages';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';

const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const copy = pages.notFound;
---
<section class="flex min-h-[70svh] items-center bg-surface py-[var(--spacing-section)]">
  <div class="container-site text-center">
    <nav class="text-sm text-ink-500" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center justify-center gap-2">
        <li><a href={localizePath('/', locale)} class="transition hover:text-navy-900 hover:underline underline-offset-4">{tr('nav.home')}</a></li>
        <li aria-hidden="true" class="opacity-60">/</li>
        <li aria-current="page">404</li>
      </ol>
    </nav>

    <h1 class="text-h1 mx-auto mt-6 max-w-3xl font-semibold text-navy-900">{t(copy.title, locale)}</h1>
    <p class="mx-auto mt-6 max-w-xl text-lead text-ink-500">{t(copy.lead, locale)}</p>

    <a href={localizePath('/', locale)} class="mt-10 inline-flex items-center bg-navy-900 px-8 py-3.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white transition hover:bg-navy-800">
      {t(copy.cta, locale)}
    </a>
  </div>
</section>
