---
/** Hairline strip linking the other services from a service detail page. */
import { services } from '@data/services';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';

interface Props { /** slug of the service to leave out */ current: string }
const { current } = Astro.props;
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const others = services.filter((s) => s.slug !== current);
---
<section class="border-y border-line bg-surface-alt">
  <div class="container-site flex flex-wrap items-center gap-x-8 gap-y-3 py-6 text-sm">
    <span class="font-semibold text-navy-900">{tr('label.services')}:</span>
    {others.map((s) => (
      <a href={localizePath(`/what-we-do/${s.slug}`, locale)} class="text-ink-500 transition hover:text-navy-900 hover:underline underline-offset-4">{t(s.title, locale)}</a>
    ))}
  </div>
</section>
