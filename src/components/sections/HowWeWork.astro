---
/** Five-step process on a horizontal rule. */
import { getLocale, t } from '@i18n/utils';
import { howWeWork } from '@data/home';
const locale = getLocale(Astro.url);
---
<section class="section bg-surface-alt">
  <div class="container-site">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow">{t(howWeWork.eyebrow, locale)}</p>
      <h2 class="mt-4 text-h2" set:html={t(howWeWork.title, locale)} />
    </div>
    <ol class="mt-14 grid gap-10 border-t border-navy-900/20 pt-8 sm:grid-cols-2 lg:grid-cols-5" data-reveal-group>
      {howWeWork.steps.map((s, i) => (
        <li class="relative">
          <span class="absolute -top-8 left-0 h-px w-10 bg-accent-600" aria-hidden="true"></span>
          <span class="font-mono text-xs text-ink-400">0{i + 1}</span>
          <h3 class="mt-2 text-xl font-semibold text-navy-900">{t(s.title, locale)}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-500">{t(s.text, locale)}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
