---
/** Recovery links for the 404 page: every main section plus the contact CTA. */
import { primaryNav, ctaHref } from '@data/nav';
import { pages } from '@data/pages';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';

const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
/** One 404 page serves both languages, so point Turkish visitors home too. */
const other = locale === 'tr' ? 'en' : 'tr';
---
<section class="section bg-surface">
  <div class="container-site">
    <ul class="grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {primaryNav.map((item) => (
        <li>
          <a href={localizePath(item.href, locale)} class="group flex items-center justify-between gap-4 bg-surface p-6 transition hover:bg-surface-alt">
            <span class="text-lg font-semibold text-navy-900">{tr(item.key)}</span>
            <span class="text-accent-600 transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex flex-wrap items-center gap-6">
      <a href={localizePath(ctaHref, locale)} class="inline-flex items-center bg-navy-900 px-8 py-3.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-white transition hover:bg-navy-800">
        {tr('cta.discuss')}
      </a>
      <p class="text-sm text-ink-500">
        {t(pages.notFound.lead, other)}{' '}
        <a href={localizePath('/', other)} class="font-semibold text-accent-600 hover:underline underline-offset-4">
          {other === 'tr' ? 'Ana sayfa' : 'Home'}
        </a>
      </p>
    </div>
  </div>
</section>
