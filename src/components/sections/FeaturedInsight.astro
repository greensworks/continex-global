---
/**
 * Featured insight: large two-column card — photo left, topic pill, date,
 * title, excerpt and a "Read more" link right.
 */
import Image from '@components/ui/Photo.astro';
import type { ImageMetadata } from 'astro';

interface Props { image?: ImageMetadata; tag: string; title: string; text?: string; href: string; readLabel: string; topSpace?: boolean }
const { image, tag, title, text, href, readLabel, topSpace = false } = Astro.props;
---
<section class:list={["bg-surface pb-10", topSpace && "pt-[var(--spacing-section)]"]}>
  <div class="container-site">
    <a href={href} class="group grid overflow-hidden border border-line md:grid-cols-2" data-reveal>
      <div class="aspect-[584/433] overflow-hidden bg-surface-muted">
        {image && <Image src={image} alt="" widths={[480, 768, 1200, 1536]} sizes="(min-width: 1280px) 600px, (min-width: 1024px) calc((100vw - 80px) / 2), (min-width: 768px) calc((100vw - 64px) / 2), calc(100vw - 40px)" loading="eager" fetchpriority="high" layout="none" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />}
      </div>
      <div class="flex flex-col justify-center p-8 lg:p-12">
        <div class="flex flex-wrap items-center gap-4 text-sm">
          <span class="rounded-full bg-steel-100 px-3 py-1 text-[12px] font-semibold text-navy-800">{tag}</span>
        </div>
        <h2 class="mt-5 font-display text-2xl font-semibold leading-snug text-navy-900 transition group-hover:text-accent-600 md:text-[28px]">{title}</h2>
        {text && <p class="mt-4 text-base leading-relaxed text-ink-700">{text}</p>}
        <span class="mt-6 inline-flex items-center gap-2 font-semibold text-accent-600">
          <span aria-hidden="true">›</span>{readLabel}
        </span>
      </div>
    </a>
  </div>
</section>
