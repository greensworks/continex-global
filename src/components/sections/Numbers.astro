---
/** Three verified figures (pattern: BcgNumbers). Counters animate via [data-count]. */
import { getLocale, t } from '@i18n/utils';
import { kpis } from '@data/home';
const locale = getLocale(Astro.url);
---
<section class="section bg-surface">
  <div class="container-site">
    <p class="eyebrow" data-reveal>{t(kpis.eyebrow, locale)}</p>
    <div class="mt-8 grid gap-10 border-t border-line pt-10 md:grid-cols-3" data-reveal-group>
      {kpis.items.map((k) => (
        <div class="border-l-2 border-accent-600 pl-6">
          <p class="font-display text-6xl font-semibold leading-none text-navy-900 md:text-7xl"><span data-count={k.value} data-count-suffix={k.suffix}>0</span></p>
          <p class="mt-3 text-lg font-semibold text-navy-900">{t(k.label, locale)}</p>
          <p class="mt-1 text-sm text-ink-500">{t(k.note, locale)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
