---
/**
 * Closing CTA above the footer. Full-bleed industrial photo, a translucent
 * dark panel with the headline and one line of text on the left and a white
 * button on the right.
 */
import { Image } from 'astro:assets';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import { finalCta } from '@data/home';
import bg from '@assets/images/metal-grinding-sparks.webp';
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
---
<section class="relative isolate overflow-hidden bg-navy-950 text-white">
  <Image src={bg} alt="" widths={[768, 1280, 1920]} sizes="100vw" layout="none" class="absolute inset-0 -z-10 h-full w-full object-cover" />
  <div class="container-site py-16 lg:py-24">
    <div class="flex flex-col gap-8 bg-navy-950/70 px-8 py-12 backdrop-blur-sm lg:flex-row lg:items-center lg:justify-between lg:px-14 lg:py-16" data-reveal>
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-medium leading-tight text-white md:text-[36px]">{t(finalCta.title, locale)}</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-white/80">{t(finalCta.text, locale)}</p>
      </div>
      <a href={localizePath('/contact', locale)} class="inline-flex shrink-0 items-center justify-center border border-white bg-white px-8 py-3.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-navy-950 transition hover:bg-transparent hover:text-white">{tr('cta.discuss')}</a>
    </div>
  </div>
</section>
