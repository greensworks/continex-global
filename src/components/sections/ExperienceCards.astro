---
/** Case studies: need → what we did → status → outcome. `full` shows every field. */
import { Image } from 'astro:assets';
import { getLocale, localizePath, t } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import { experience } from '@data/experience';
import { img } from '@/lib/images';

interface Props { full?: boolean; eyebrow?: string; title?: string; showLink?: boolean }
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const { full = false, eyebrow = locale === 'tr' ? 'Seçilmiş deneyim' : 'Selected experience', title = locale === 'tr' ? 'Gerçek mandatlar, gerçek sonuçlar.' : 'Real mandates, real outcomes.', showLink = true } = Astro.props;
const statusTone = { ongoing: 'bg-accent-600', completed: 'bg-emerald-600', advanced: 'bg-steel-300' };
---
<section class="section bg-surface-alt">
  <div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div class="max-w-3xl">
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="mt-4 text-h2">{title}</h2>
      </div>
      {showLink && <a href={localizePath('/selected-experience', locale)} class="text-sm font-semibold text-accent-600 hover:underline underline-offset-4">{tr('exp.viewAll')} →</a>}
    </div>
    <div class="mt-12 space-y-6">
      {experience.map((c) => (
        <article id={c.slug} class="grid gap-0 overflow-hidden rounded-card border border-line bg-surface lg:grid-cols-12" data-reveal>
          <div class="relative lg:col-span-4">
            <Image src={img(c.image)} alt="" widths={[480, 960]} sizes="(min-width: 1024px) 33vw, 100vw" layout="none" class="h-56 w-full object-cover lg:h-full" />
            <span class:list={['absolute left-4 top-4 rounded-sm px-2.5 py-1 text-[11px] font-semibold text-white', statusTone[c.statusKind]]}>{t(c.status, locale)}</span>
          </div>
          <div class="p-7 lg:col-span-8 lg:p-9">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-400">{t(c.client, locale)} · {t(c.sector, locale)} · {t(c.market, locale)}</p>
            <h3 class="mt-3 text-h3"><a href={localizePath(`/selected-experience/${c.slug}`, locale)} class="hover:underline underline-offset-4">{t(c.title, locale)}</a></h3>
            <dl class="mt-6 grid gap-5 text-sm leading-relaxed md:grid-cols-2">
              <div><dt class="font-semibold text-navy-900">{tr('label.need')}</dt><dd class="mt-1 text-ink-500">{t(c.need, locale)}</dd></div>
              <div><dt class="font-semibold text-navy-900">{tr('label.role')}</dt><dd class="mt-1 text-ink-500">{t(c.role, locale)}</dd></div>
              {full && <div><dt class="font-semibold text-navy-900">{tr('label.progress')}</dt><dd class="mt-1 text-ink-500">{t(c.progress, locale)}</dd></div>}
              <div><dt class="font-semibold text-navy-900">{tr('label.outcome')}</dt><dd class="mt-1 text-ink-500">{t(c.outcome, locale)}</dd></div>
            </dl>
            <a href={localizePath(`/selected-experience/${c.slug}`, locale)} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent-600 hover:underline underline-offset-4">{tr('cta.readMore')} →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
