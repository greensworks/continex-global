---
/**
 * Inner-page hero (RB stage overview): full-bleed photo running behind the
 * header, the white H1 over it and a single dark CTA pinned to the
 * bottom-right corner. Without an image the page title falls back to the
 * guide-line headline block on white.
 */
import Image from '@components/ui/Photo.astro';
import type { ImageMetadata } from 'astro';
import { getLocale, localizePath } from '@i18n/utils';
import { useTranslations } from '@i18n/ui';
import { ctaHref } from '@data/nav';

interface Props {
  /** trail shown above the title, like the case-study hero */
  breadcrumb?: { label: string; href?: string }[];
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
  /** bottom-right stage button; null hides it */
  cta?: { label: string; href: string } | null;
}
const { breadcrumb = [], title, lead, image, imageAlt = '', imagePosition = 'center', cta } = Astro.props;
const locale = getLocale(Astro.url);
const tr = useTranslations(locale);
const stageCta = cta === null ? null : cta ?? { label: tr('cta.discuss'), href: localizePath(ctaHref, locale) };
---
{image ? (
  <section class="relative isolate flex min-h-[360px] items-center overflow-hidden bg-navy-950 text-white md:min-h-[400px]">
    <Image src={image} alt={imageAlt} style={{ objectPosition: imagePosition }} widths={[768, 1280, 1920]} sizes="100vw" layout="none" loading="eager" class="absolute inset-0 -z-20 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-navy-950/45" aria-hidden="true"></div>
    <div class="container-site w-full pb-20 pt-[136px] md:pb-16 md:pt-[152px]">
      {breadcrumb.length > 0 && (
        <nav class="mb-4 text-sm text-white/80" aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-2">
            {breadcrumb.map((b, i) => (
              <li class="flex items-center gap-2">
                {i > 0 && <span aria-hidden="true" class="opacity-60">/</span>}
                {b.href ? <a href={b.href} class="transition hover:text-white hover:underline underline-offset-4">{b.label}</a> : <span>{b.label}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <h1 class="max-w-4xl font-display text-4xl font-medium leading-tight text-white md:text-[52px]">{title}</h1>
    </div>
    {stageCta && (
      <a href={stageCta.href} class="absolute bottom-0 right-0 inline-flex items-center gap-3 bg-navy-900 px-5 py-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-white transition hover:bg-navy-800 md:px-6 md:py-3.5">
        {stageCta.label}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12h8m-3-3 3 3-3 3"/></svg>
      </a>
    )}
  </section>
) : (
  <section class="relative bg-surface pt-[var(--spacing-section)]">
    <div class="container-site">
      <div class="grid md:grid-cols-2">
        <div class="hidden md:block"></div>
        <div class="relative border-l border-navy-900/30 pb-6 pl-6 md:pl-8" data-reveal>
          <span class="absolute left-0 top-0 h-[var(--spacing-section)] -translate-y-full border-l border-navy-900/30" aria-hidden="true"></span>
          {breadcrumb.length > 0 && (
            <nav class="text-sm text-ink-500" aria-label="Breadcrumb">
              <ol class="flex flex-wrap items-center gap-2">
                {breadcrumb.map((b, i) => (
                  <li class="flex items-center gap-2">
                    {i > 0 && <span aria-hidden="true" class="opacity-60">/</span>}
                    {b.href ? <a href={b.href} class="transition hover:text-navy-900 hover:underline underline-offset-4">{b.label}</a> : <span>{b.label}</span>}
                  </li>
                ))}
              </ol>
            </nav>
          )}
          <h1 class="text-h1 mt-3 max-w-xl font-semibold text-navy-900">{title}</h1>
          {lead && <p class="mt-6 max-w-xl text-lead text-ink-500">{lead}</p>}
        </div>
      </div>
    </div>
  </section>
)}

{image && lead && (
  <section class="relative bg-surface pt-[var(--spacing-section)]">
    <div class="container-site">
      <div class="grid md:grid-cols-2">
        <div class="hidden md:block"></div>
        <div class="relative border-l border-navy-900/30 pb-6 pl-6 md:pl-8" data-reveal>
          <span class="absolute left-0 top-0 h-[var(--spacing-section)] -translate-y-full border-l border-navy-900/30" aria-hidden="true"></span>
          <p class="max-w-xl text-lead text-ink-700">{lead}</p>
        </div>
      </div>
    </div>
  </section>
)}
