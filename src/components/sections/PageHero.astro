---
/** Inner-page hero: navy band, eyebrow, title, lead. Optional photo on the right. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { eyebrow?: string; title: string; lead?: string; image?: ImageMetadata; imageAlt?: string }
const { eyebrow, title, lead, image, imageAlt = '' } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-navy-950 text-white">
  {image && (
    <>
      <Image src={image} alt={imageAlt} widths={[768, 1280, 1920]} sizes="100vw" layout="none" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-60" loading="eager" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/40" aria-hidden="true"></div>
    </>
  )}
  <div class="container-site pb-16 pt-32 lg:pb-24 lg:pt-44">
    <div class="max-w-3xl">
      {eyebrow && <p class="eyebrow text-steel-300" data-reveal>{eyebrow}</p>}
      <h1 class="mt-4 text-h1 font-semibold text-white" data-reveal data-reveal-delay="0.06">{title}</h1>
      {lead && <p class="mt-6 text-lead text-white/75" data-reveal data-reveal-delay="0.12">{lead}</p>}
    </div>
  </div>
</section>
