# Copy to .env and fill in. Never commit .env.
SITE_URL=https://continexglobal.com

# --- Analytics & tracking (all loaded only after cookie consent) ---
PUBLIC_GA4_ID=            # G-XXXXXXXXXX
PUBLIC_CLARITY_ID=        # Microsoft Clarity project id
PUBLIC_LINKEDIN_PARTNER_ID=
PUBLIC_META_PIXEL_ID=     # optional, leave empty until ads start
PUBLIC_B2B_VISITOR_SCRIPT= # Leadfeeder/Dealfront/Albacross script URL, if chosen
PUBLIC_GSC_VERIFICATION=  # Google Search Console meta verification token

# --- Contact form / CRM ---
PUBLIC_FORM_ENDPOINT=     # POST target (HubSpot Forms API, serverless function, etc.)
